* text=auto eol=lf

*.sh       text eol=lf
*.conf     text eol=lf
*.template text eol=lf
*.yaml     text eol=lf
*.yml      text eol=lf
justfile   text eol=lf
# sqlx checksums the bytes: a CRLF checkout fails `ashyq migrate` against a database migrated from LF.
apps/server/migrations/*.sql text eol=lf

# Media, archives, fonts, dumps: never normalized or diffed as text.
*.mp4    binary
*.webm   binary
*.mov    binary
*.mkv    binary
*.mp3    binary
*.wav    binary
*.ogg    binary
*.pdf    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.avif   binary
*.png    binary
*.ico    binary
*.bmp    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.otf    binary
*.eot    binary
*.zip    binary
*.gz     binary
*.tgz    binary
*.7z     binary
*.dump   binary
*.sqlite binary
*.wasm   binary

# Generated from the server contract (`just contract`): collapsed in reviews and stats. On a merge conflict do not
# hand-merge - take either side and regenerate (`just contract`, `just server prepare`); `-merge` makes git leave the
# client directories whole instead of writing conflict markers into them.
apps/server/openapi.v2.json                           linguist-generated
apps/server/crates/api/tests/snapshots/*.snap         linguist-generated
apps/server/crates/core/src/error/snapshots/*.snap    linguist-generated
apps/server/.sqlx/**                                  linguist-generated -diff
apps/web-2/src/shared/api/gen/**                      linguist-generated -diff -merge
apps/web-2/src/routeTree.gen.ts                       linguist-generated
apps/web/src/lib/api/generated/**                     linguist-generated -diff -merge
