* text=auto eol=lf

*.sh       text eol=lf
*.conf     text eol=lf
*.template text eol=lf
*.yaml     text eol=lf
*.yml      text eol=lf
justfile   text eol=lf
# sqlx checksums the bytes: a CRLF checkout fails `ashyq migrate` against a database migrated from LF.
apps/server/migrations/*.sql text eol=lf

# Media, archives, fonts, dumps: never normalized or diffed as text.
*.mp4    binary
*.webm   binary
*.mov    binary
*.mkv    binary
*.mp3    binary
