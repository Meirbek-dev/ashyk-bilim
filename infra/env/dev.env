# Dev stack (compose.yaml + compose.dev.yaml, `just dev-up`). Committed: NOT secrets.
# Single source of the dev values for compose, CI and apps/*/.env.example.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
ASHYQ_DB_PASSWORD=ashyq
ASHYQ_DATABASES=ashyq_dev,ashyq_test
ASHYQ_DB_CREATEDB=true

ZITADEL_MASTERKEY=MasterkeyNeedsToHave32Characters
ZITADEL_DB_PASSWORD=zitadel
ZITADEL_PAT_EXPIRATION=2030-01-01T00:00:00Z

RUSTFS_ACCESS_KEY=ashyq-dev
RUSTFS_SECRET_KEY=ashyq-dev-secret
# `just stack up` adds the web origins of every running slot.
STORAGE_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

REDIS_PASSWORD=ashyq-dev

# Only used with COMPOSE_PROFILES=runner.
RUNNER_AUTH_TOKEN=ashyq-dev

DEV_PG_PORT=5433
DEV_REDIS_PORT=6380
DEV_ZITADEL_PORT=8081
DEV_RUSTFS_PORT=9002
# `just stack up --runner` (profile runner, ~2 GB image built from infra/runner).
DEV_RUNNER_PORT=5050

# Client side of the above (apps/server/.env, server tests). The Zitadel PAT is
# written to tmp/dev/zitadel-pat.txt by `just dev-up`.
DATABASE_URL=postgres://ashyq:ashyq@localhost:5433/ashyq_dev
TEST_REDIS_URL=redis://:ashyq-dev@localhost:6380
TEST_S3_ENDPOINT=http://localhost:9002

# --- Apps: `just stack up [slot]` (infra/dev/stack.ts) runs the API, worker and both webs with these.
# Derived per slot, not set here: ports, CORS, AB__DATABASE__URL (--db, default ashyq_dev), AB__REDIS__URL
# (db 4+slot), AB__SERVER__WEB_URL. Secrets go in the gitignored infra/env/dev.local.env (created by
# `just stack up`): AB__ZITADEL__PAT (from `just dev-up`) and E2E_PASSWORD (seed-e2e accounts, e2e runs).
AB__ENVIRONMENT=development
AB__SERVER__HOST=127.0.0.1
AB__SERVER__WEB_LINKS=legacy
AB__ZITADEL__BASE_URL=http://localhost:8081
AB__STORAGE__ENDPOINT=http://localhost:9002
AB__STORAGE__ACCESS_KEY=ashyq-dev
AB__STORAGE__SECRET_KEY=ashyq-dev-secret
AB__STORAGE__PUBLIC_BUCKET=ab-public
AB__STORAGE__PRIVATE_BUCKET=ab-private
AB__RUNNER__BASE_URL=http://localhost:5050
AB__RUNNER__AUTH_TOKEN=ashyq-dev
AB__TELEMETRY__JSON_LOGS=false
# Parallel agents and e2e runs sign in far more often than people do.
AB__AUTH__LIMITS__LOGIN_IP=100000
AB__AUTH__LIMITS__LOGIN_NAME=100000
AB__AUTH__LIMITS__REGISTER_IP=100000
AB__AUTH__LIMITS__REGISTER_ATTEMPT_IP=100000
AB__AUTH__LIMITS__SESSIONS_PER_USER=1000
RUST_LOG=info
