# Production compose interpolation file. Copy to ./.env on the host, chmod 600.
# Read ONLY by compose for ${VAR} substitution; no service loads it as env_file.
# Server secrets live in ./server.env (template: infra/env/server.env.example).
# Hex-only secrets (openssl rand -hex 32): several are embedded in URLs.

# !!! DO NOT CHANGE OR REMOVE. Volumes are named <project>_postgres_data etc.;
# !!! another project name makes compose create EMPTY volumes and boot a blank site.
COMPOSE_PROJECT_NAME=cs-mooc
COMPOSE_PROFILES=runner

# --- Edge ---------------------------------------------------------------------
NGINX_SERVER_NAME=cs-mooc.tou.edu.kz
# PUBLIC_SCHEME=https
# FORCE_HTTPS=1  (0 only for plain-http test stacks)
# Address/CIDR of the university TLS proxy; empty = trust nobody's X-Forwarded-For.
TRUSTED_PROXY_CIDR=
# Directory holding cert.pem + key.pem (written by the certbot deploy hook).
TLS_DIR=./certs
# ACME_WEBROOT=/var/www/certbot
# HTTP_PORT=80
# HTTPS_PORT=443

# --- Release (written by `just deploy`) ---------------------------------------
# IMAGE_REPO=ghcr.io/meirbek-dev
# IMAGE_TAG=

# --- Web ----------------------------------------------------------------------
# openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=CHANGE_ME

# --- Postgres -----------------------------------------------------------------
# Bootstrap superuser (db-init, zitadel-init, backup).
POSTGRES_USER=cs_mooc
POSTGRES_PASSWORD=CHANGE_ME
# Slow-query threshold in milliseconds; -1 disables, 0 logs every statement.
# PG_LOG_MIN_DURATION_STATEMENT=300
# Role ashyq (created by db-init if missing).
ASHYQ_DB_PASSWORD=CHANGE_ME
# ASHYQ_DATABASES=ashyq

# --- Zitadel ------------------------------------------------------------------
# Exactly 32 characters; losing it loses every account.
ZITADEL_MASTERKEY=CHANGE_ME
ZITADEL_DB_PASSWORD=CHANGE_ME
ZITADEL_PAT_EXPIRATION=2027-12-31T00:00:00Z

# --- RustFS -------------------------------------------------------------------
# Optional host directory instead of the named volume; migrate existing data first.
# RUSTFS_DATA_DIR=/data/cs-mooc/content
# BACKUP_DIR=/data/cs-mooc/backups

# --- Backup -------------------------------------------------------------------
# restic repository password (${BACKUP_DIR}/restic). openssl rand -base64 32.
# Keep a copy outside the server: without it the backups cannot be read.
BACKUP_PASSWORD=CHANGE_ME
RUSTFS_ACCESS_KEY=CHANGE_ME
RUSTFS_SECRET_KEY=CHANGE_ME

# --- Redis --------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME

# --- Code runner (go-judge) ----------------------------------------------------
RUNNER_AUTH_TOKEN=CHANGE_ME
# Programs at once and the container's ceiling (compose.yaml `runner`).
# RUNNER_PARALLELISM=4
# RUNNER_CPUS=4
# RUNNER_MEMORY=6g
