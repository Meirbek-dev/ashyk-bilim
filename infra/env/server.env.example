# Server, worker and server-migrate environment (env_file). Copy to ./server.env,
# chmod 600. Only AB__* (plus the standard OTLP header variable). Topology (CORS,
# public origin, storage endpoint, Redis and Judge0 URLs) comes from compose.prod.yaml.

# The application role `ashyq` (db-init), never the superuser.
AB__DATABASE__URL=postgres://ashyq:CHANGE_ME@db:5432/ashyq

# AB__ZITADEL__PAT is appended by `just bootstrap` from the zitadel_machinekey volume.

# Optional integrations: uncomment complete groups only (an empty AB__ key counts as set).
# AB__GOOGLE__CLIENT_ID=
# AB__GOOGLE__CLIENT_SECRET=
# AB__GOOGLE__REDIRECT_URI=https://cs-mooc.tou.edu.kz/api/v2/auth/google/callback
# AB__RESEND__API_KEY=
# AB__RESEND__FROM=Ashyq Bilim <noreply@cs-mooc.tou.edu.kz>
# AB__AI__CLAUDE_API_KEY=
# AB__AI__OPENAI_API_KEY=
# AB__AI__OPENROUTER_API_KEY=
# AB__TELEMETRY__OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <token>

# Log retention in days (defaults shown; ARCHITECTURE §8 "Schema guarantees").
# AB__RETENTION__JOBS_SUCCEEDED_DAYS=14
# AB__RETENTION__JOBS_DEAD_DAYS=90
# AB__RETENTION__AUTH_AUDIT_DAYS=365
# AB__RETENTION__CODE_RUN_OUTPUT_DAYS=180
# AB__RETENTION__AI_EVENTS_DAYS=180
