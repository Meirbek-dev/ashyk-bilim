# Smoke and e2e stacks (compose.yaml + compose.prod.yaml + compose.smoke.yaml): throwaway
# values, committed on purpose. Never reuse anywhere real. IMAGE_TAG comes from the shell.

NGINX_SERVER_NAME=ashyq.test
PUBLIC_SCHEME=http
FORCE_HTTPS=0
TLS_DIR=./tmp/smoke/certs
ACME_WEBROOT=./tmp/smoke/acme
STACK_ENV_FILE=./infra/env/smoke.env
BACKUP_DIR=./tmp/smoke/backups

POSTGRES_PASSWORD=smoke-postgres
ASHYQ_DB_PASSWORD=smoke-ashyq

ZITADEL_MASTERKEY=SmokeOnlyMasterkeyOf32Characters
ZITADEL_DB_PASSWORD=smoke-zitadel
ZITADEL_PAT_EXPIRATION=2099-01-01T00:00:00Z

RUSTFS_ACCESS_KEY=smoke-access
RUSTFS_SECRET_KEY=smoke-secret-key
REDIS_PASSWORD=smoke-redis

JUDGE0_AUTHN_TOKEN=smoke-judge0
JUDGE0_DB_PASSWORD=smoke-judge0-db
JUDGE0_REDIS_PASSWORD=smoke-judge0-redis
