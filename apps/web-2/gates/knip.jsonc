{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Runs from the repository root (gates/repo.ts): the root package.json is the bun workspace with the catalog and
  // the overrides, so knip sees them and reports unused catalog entries.
  "workspaces": {
    // Root: tools only, no sources. Run as binaries by path or by the hooks: `vp` (vite-plus; `vite` is its core under
    // the name plugins import) for `just fmt` and the commit hook, ast-grep from infra/dev/ast-grep.ts.
    ".": { "entry": [], "project": [], "ignoreDependencies": ["@ast-grep/cli", "vite", "vite-plus"] },
    "apps/web-2": {
      // Start, Vite, Vitest and Playwright entries are detected by knip's plugins.
      // src/shared/pwa/sw.ts: built by path (gates/bundle.ts) into /sw.js.
      "entry": ["src/routes/**/*.tsx", "gates/*.ts", "gates/*.mjs", "e2e/prod-stand.ts", "src/shared/pwa/sw.ts"],
      // CSS is in the project so knip follows `@import` (tailwindcss, the fonts, tw-animate-css, shadcn/tailwind.css).
      "project": ["src/**/*.{ts,tsx,css}", "gates/**/*.ts", "e2e/**/*.ts", "*.ts"],
      "ignore": ["src/shared/api/gen/**", "src/shared/api/gen.check-tmp*/**", "src/routeTree.check-tmp*.ts"],
      "ignoreDependencies": [
        // Loaded by path from project.inlang/settings.json "modules".
        "@inlang/plugin-message-format",
      ],
    },
  },
  // Stock shadcn files (`bunx shadcn add`) keep their full export list so `shadcn add --overwrite` stays a no-op diff;
  // an unused stock FILE is still reported (remove it).
  "ignoreIssues": { "apps/web-2/src/shared/ui/**": ["exports", "types"] },
}
