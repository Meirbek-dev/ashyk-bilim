# Local development env for apps/server (copy to apps/server/.env).
# Matches the dev stack (`just dev-up`, values in infra/env/dev.env).
# Production: server.env on the host (infra/env/server.env.example).

# sqlx-cli + query! macros + #[sqlx::test] (role ashyq has CREATEDB in dev)
DATABASE_URL=postgres://ashyq:ashyq@localhost:5433/ashyq_dev
# Integration tests (the root `just server ...` sets TEST_REDIS_URL too)
TEST_REDIS_URL=redis://:ashyq-dev@localhost:6380
TEST_S3_ENDPOINT=http://localhost:9002

# --- Application (AB__SECTION__KEY; lists use TOML syntax) ---
AB__ENVIRONMENT=development
AB__SERVER__HOST=0.0.0.0
AB__SERVER__PORT=8000
AB__SERVER__CORS_ORIGINS=["http://localhost:3000"]
# Public origin of the web app: browser-facing redirects (Google sign-in) and
# links in emails are absolute to it. Unset = host-relative.
AB__SERVER__WEB_URL=http://localhost:3000
AB__DATABASE__URL=postgres://ashyq:ashyq@localhost:5433/ashyq_dev
AB__DATABASE__MAX_CONNECTIONS=10
AB__DATABASE__MIN_CONNECTIONS=0
AB__REDIS__URL=redis://:ashyq-dev@localhost:6380/2
AB__ZITADEL__BASE_URL=http://localhost:8081
# Written by `just dev-up` to tmp/dev/zitadel-pat.txt (repo root).
AB__ZITADEL__PAT=CHANGE_ME_from_tmp_dev_zitadel_pat
AB__STORAGE__ENDPOINT=http://localhost:9002
AB__STORAGE__ACCESS_KEY=ashyq-dev
AB__STORAGE__SECRET_KEY=ashyq-dev-secret
AB__STORAGE__PUBLIC_BUCKET=ab-public
AB__STORAGE__PRIVATE_BUCKET=ab-private
AB__TELEMETRY__JSON_LOGS=false
# Transactional email (registration verification codes). Unset = codes are
# logged at warn and accounts still work.
# AB__RESEND__API_KEY=re_...
# AB__RESEND__FROM=Ashyq Bilim <noreply@example.com>
# AI providers: owner-supplied keys, never committed. Unset = AI disabled
# (routes answer 503 `ai-disabled`, agents return draft artifacts).
# AB__AI__OPENAI_API_KEY=sk-...
# AB__AI__OPENROUTER_API_KEY=sk-or-...
# AB__AI__OPENAI_MODEL=gpt-6-luna
# AB__AI__OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# AB__AI__MONTHLY_TOKEN_BUDGET=1000000
# Full traces URL (nothing is appended); token goes in the standard OTLP header var:
# AB__TELEMETRY__OTLP_ENDPOINT=https://logfire-api.pydantic.dev/v1/traces
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer pylf_v1_..._writetoken
