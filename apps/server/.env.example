# Local development env for apps/server (copy to apps/server/.env).
# Production uses the repo-root .env consumed by docker compose.

# sqlx-cli + query! macros (dev database on the compose `db` service)
DATABASE_URL=postgres://openu:CHANGE_ME@localhost:5432/ashyq_dev

# --- Application (AB__SECTION__KEY; lists use TOML syntax) ---
AB__ENVIRONMENT=development
AB__SERVER__HOST=0.0.0.0
AB__SERVER__PORT=8000
AB__SERVER__CORS_ORIGINS=["http://localhost:3000"]
AB__DATABASE__URL=postgres://openu:CHANGE_ME@localhost:5432/ashyq_dev
AB__DATABASE__MAX_CONNECTIONS=10
AB__DATABASE__MIN_CONNECTIONS=0
AB__REDIS__URL=redis://localhost:6379/2
AB__TELEMETRY__JSON_LOGS=false
# AB__TELEMETRY__OTLP_ENDPOINT=https://logfire-api.pydantic.dev

# --- Zitadel (compose overlay) ---
ZITADEL_MASTERKEY=CHANGE_ME_MASTERKEY_32_CHARS_MIN
ZITADEL_DB_PASSWORD=CHANGE_ME
ZITADEL_EXTERNAL_DOMAIN=localhost
ZITADEL_EXTERNAL_PORT=8081
ZITADEL_EXTERNAL_SECURE=false

# --- RustFS (compose overlay) ---
RUSTFS_ACCESS_KEY=ashyq-dev
RUSTFS_SECRET_KEY=CHANGE_ME
