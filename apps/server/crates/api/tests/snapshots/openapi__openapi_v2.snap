              "type": "string"
            }
          },
          {
            "description": "Current `version`; stale → 412",
            "in": "header",
            "name": "If-Match",
            "required": false,
            "schema": {
              "format": "int32",
              "type": [
                "integer",
                "null"
              ]
            }
          },
          {
            "description": "`return=representation`: answer 200 with the updated resource instead of 204",
            "in": "header",
            "name": "Prefer",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "requestBody": {
          "content": {
