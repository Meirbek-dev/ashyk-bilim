    "/api/v2/assessments/{assessment_id}/access": {
      "get": {
        "operationId": "get_access",
        "parameters": [
          {
            "description": "Assessment id",
            "in": "path",
            "name": "assessment_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/AssessmentId"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessView"
                }
              }
            },
            "description": "Access policy",
            "headers": {
              "ETag": {
                "description": "Quoted version",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "summary": "Who may take the assessment (authors only).",
        "tags": [
          "assessments"
        ]
      },
      "put": {
        "description": "With `If-Match: \"<version>\"` (the `ETag` of the last read) a stale tab\nis 412 `precondition-failed` with `details {expected, actual}` instead\nof a silent overwrite (UX-154).",
        "operationId": "set_access",
        "parameters": [
          {
            "description": "Assessment id",
            "in": "path",
            "name": "assessment_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/AssessmentId"
            }
          },
          {
            "description": "Version from the last read's ETag",
            "in": "header",
            "name": "If-Match",
            "required": false,
            "schema": {
              "format": "int32",
              "type": [
                "integer",
                "null"
              ]
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetAccessRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessView"
                }
              }
            },
            "description": "Updated",
            "headers": {
              "ETag": {
                "description": "Quoted new version",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "412": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Stale version"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "User/group outside the course"
          }
        },
        "summary": "Replace the access policy. Restricted lists are validated against the\ncourse (users need course access, groups must be linked); switching to\nall-course-learners wipes both lists.",
        "tags": [
          "assessments"
        ]
      }
    },
    "/api/v2/assessments/{assessment_id}/attempt-state": {
      "get": {
        "description": "The effective policy (overrides applied) and any reasons an attempt is\nblocked. Requires course access and `assessment:submit:assigned`\n(authors preview freely); off a restricted access list it answers with\n`ACCESS_RESTRICTED` (UX-227) - starting and submitting still 403.",
        "operationId": "attempt_state",
