    "/api/v2/auth/google": {
      "get": {
        "operationId": "google_start",
        "parameters": [
          {
            "description": "Relative return path",
            "in": "query",
            "name": "callback",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "303": {
            "description": "Redirect to Google"
          }
        },
        "summary": "Start Google sign-in: 303 to Google's consent screen.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v2/auth/google/callback": {
      "get": {
        "operationId": "google_callback",
        "parameters": [
          {
            "description": "Authorization code",
            "in": "query",
            "name": "code",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Opaque state",
            "in": "query",
            "name": "state",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Google-side error",
            "in": "query",
            "name": "error",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "303": {
            "description": "Redirect into the app (or to login with ?error=)"
          }
        },
        "summary": "Google redirects here; on success the session cookie is set and the\nbrowser continues to the original callback path.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v2/auth/login": {
      "post": {
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionInfo"
                }
              }
            },
            "description": "Logged in; session cookie set"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Invalid credentials"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Account disabled"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Too many attempts"
          }
        },
        "summary": "Password login (headless Zitadel session check behind the BFF).",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v2/auth/logout": {
      "post": {
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Session terminated, cookie cleared"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No live session"
          }
        },
        "summary": "Logout: revoke the current session and clear the cookie. Idempotent.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v2/auth/mfa/totp": {
      "delete": {
        "operationId": "totp_remove",
        "responses": {
          "204": {
            "description": "Removed (idempotent)"
          }
        },
        "summary": "Remove the TOTP authenticator.",
