    "/api/v2/search": {
      "get": {
        "operationId": "search",
        "parameters": [
          {
            "description": "Search terms: every word matches by prefix, `-word` excludes",
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Per-section cap, 1..=50 (default 10)",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "description": "next_cursor from the previous page",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResults"
                }
              }
            },
            "description": "Grouped results"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Malformed `cursor`"
          }
        },
        "summary": "Platform search over courses, collections, and people. Anonymous callers\nsee public content only and no people section.",
        "tags": [
          "search"
        ]
      }
    },
    "/api/v2/submissions/{submission_id}": {
      "get": {
        "operationId": "get_submission",
        "parameters": [
          {
            "description": "Submission id",
            "in": "path",
            "name": "submission_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/SubmissionId"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StudentSubmission"
                }
              }
            },
            "description": "Submission"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unknown or not yours"
          }
        },
        "summary": "One attempt the caller owns (404 for anyone else's).",
        "tags": [
          "submissions"
        ]
      }
    },
    "/api/v2/submissions/{submission_id}/draft": {
      "patch": {
        "description": "Requires `If-Match` with the draft_version you loaded; 409 carries\n`{expected, actual}` when someone (another tab) saved in between.\nThrottled to one save per 5 seconds per draft (429).",
        "operationId": "save_submission_draft",
        "parameters": [
          {
            "description": "Submission id",
            "in": "path",
            "name": "submission_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/SubmissionId"
            }
          },
          {
            "description": "Current draft_version",
            "in": "header",
            "name": "If-Match",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveDraftRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StudentSubmission"
                }
              }
            },
            "description": "Saved",
            "headers": {
              "ETag": {
                "description": "New quoted draft_version",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Gate closed: `TIME_LIMIT_EXPIRED`, `PAST_DUE` or `REMEDIATION_REQUIRED`"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unknown, not yours, or a staff preview (never resumed by a learner)"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Stale draft_version or not a draft"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unknown item / wrong answer kind"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Saving too often"
          }
        },
        "summary": "Merge answers into the open draft.",
        "tags": [
          "submissions"
        ]
      }
    },
    "/api/v2/submissions/{submission_id}/events": {
      "get": {
        "description": "Event names: `connected`, `grade.published`, `submission.returned`,\n`deadline.extended`, `closed` (access lost; the stream ends). `data` is the stored event\n(`{event_id, event, submission_id, payload, sent_at}`); `id` is the\nstream id to send back as `Last-Event-ID` on reconnect.",
        "operationId": "submission_events",
        "parameters": [
          {
            "description": "Submission id",
            "in": "path",
            "name": "submission_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/SubmissionId"
            }
          },
          {
            "description": "Resume after this event id",
            "in": "header",
            "name": "Last-Event-ID",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/SubmissionStreamEvent"
                }
              }
            },
            "description": "Event stream: each message's `data` is one event"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unknown or inaccessible"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Too many open streams for this user"
          }
        },
        "summary": "Grading events for one submission as `text/event-stream`.",
        "tags": [
          "submissions"
        ]
      }
    },
    "/api/v2/submissions/{submission_id}/feedback": {
      "get": {
        "operationId": "my_feedback",
        "parameters": [
          {
            "description": "Submission id",
            "in": "path",
            "name": "submission_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/SubmissionId"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ItemFeedbackView"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Feedback"
          }
        },
        "summary": "Released item feedback on one of the caller's own submissions.",
        "tags": [
          "submissions"
        ]
      }
    },
    "/api/v2/submissions/{submission_id}/grade": {
      "patch": {
        "description": "Requires `If-Match: \"<version>\"`; a mismatch is 412 with\n`{expected, actual}`. Item scores merge into the breakdown, the raw\nscore is given or computed from them, and the late penalty recorded at\nsubmit applies on top. Each save appends to the grading history.\n\nRuns `detached()` (BUG-227): a client that hangs up after the row and\nledger commit must not skip the SSE events, the progress projection\nand the analytics hook.",
        "operationId": "save_grade",
        "parameters": [
          {
            "description": "Submission id",
            "in": "path",
            "name": "submission_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/SubmissionId"
            }
          },
          {
            "description": "Current version",
            "in": "header",
            "name": "If-Match",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GradeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TeacherSubmission"
                }
              }
            },
            "description": "Saved"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Draft cannot be graded"
          },
          "412": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Stale version"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Transition not allowed / bad score"
          }
        },
        "summary": "Save, publish or return a grade.",
