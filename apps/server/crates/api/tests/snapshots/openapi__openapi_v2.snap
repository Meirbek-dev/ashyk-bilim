      "CourseGradingStreamEvent": {
        "description": "`GET /courses/{course_id}/grading/events`: one message's `data`.",
        "oneOf": [
          {
            "description": "Sent once, after any replay.",
            "properties": {
              "course_id": {
                "$ref": "#/components/schemas/CourseId"
              },
