        ]
      }
    },
    "/api/v2/certificates/{code}/pdf": {
      "get": {
        "description": "Holder, course, certificate name/type, issue date, teacher, the\nverification code and the verify link (`AB__SERVER__WEB_URL` +\n`/{locale}/certificates/{code}/verify`). The page language follows\n`Accept-Language` (`ru`, `kk`, `en`), else the holder's locale.",
        "operationId": "certificate_pdf",
        "parameters": [
          {
            "description": "Verification code",
            "in": "path",
            "name": "code",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "ru, kk or en (default: the holder's locale)",
            "in": "header",
            "name": "Accept-Language",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "description": "Overrides `Accept-Language` (for links)",
            "in": "query",
            "name": "lang",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/UiLanguage"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/pdf": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "PDF"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unknown code"
          }
        },
        "summary": "The certificate as an A4-landscape PDF - public by code, like verification.",
        "tags": [
          "certifications"
        ]
      }
    },
    "/api/v2/certifications": {
      "post": {
        "operationId": "create_certification",
        "parameters": [
          {
            "description": "Retry-safe replay key",
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCertificationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Certification"
                }
              }
            },
            "description": "Created"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No certificate authoring on this course"
          }
        },
        "summary": "Add a certification template to a course (`certificate:create`).\nHonours `Idempotency-Key`.",
        "tags": [
          "certifications"
        ]
      }
    },
    "/api/v2/certifications/{certification_id}": {
      "delete": {
        "operationId": "delete_certification",
        "parameters": [
          {
            "description": "Certification id",
            "in": "path",
            "name": "certification_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/CertificationId"
            }
          },
          {
            "description": "Row `version`; stale -> 412",
            "in": "header",
            "name": "If-Match",
            "required": false,
            "schema": {
              "format": "int32",
              "type": [
                "integer",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "412": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Stale `If-Match`"
          }
        },
