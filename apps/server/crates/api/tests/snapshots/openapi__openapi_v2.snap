              "$ref": "#/components/schemas/CourseId"
            }
          },
          {
            "description": "Client retry token (optional)",
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateDiscussionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Discussion"
                }
              }
            },
            "description": "Created"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Empty content, nested reply, or Idempotency-Key reused with a different body"
          }
        },
        "summary": "Post, or reply to a post (`parent_id`). With an `Idempotency-Key`, a\nretry with the same body replays the created post instead of posting\ntwice; the same key with a different body is 422.",
        "tags": [
          "discussions"
        ]
      }
    },
    "/api/v2/courses/{course_id}/duplicate": {
      "post": {
        "description": "Chapters, unpublished\nactivities with their blocks, file-submission configs and assessments\n(draft copies with policy and items). Uploaded media is shared by key,\nnot duplicated (one more reference per use). Learners, grades,\nsubmissions, discussions, announcements, contributors and group links\nstay behind. Needs `course:create:platform` and write access to the\nsource. Honours `Idempotency-Key`.",
        "operationId": "duplicate_course",
        "parameters": [
          {
            "description": "Source course id",
            "in": "path",
            "name": "course_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/CourseId"
            }
          },
          {
            "description": "Retry-safe replay key",
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DuplicateCourseRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Course"
                }
              }
            },
            "description": "The copy"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No create right or no write access to the source"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unknown or invisible course"
          }
        },
        "summary": "Copy a course as a private draft for the caller.",
        "tags": [
          "courses"
        ]
      }
    },
    "/api/v2/courses/{course_id}/gradebook": {
      "get": {
        "description": "The attempt learner progress scores (best-scored submission, latest\nscored file attempt) - assessment submissions and file-submission\nattempts alike.",
        "operationId": "gradebook",
        "parameters": [
          {
            "description": "Course id",
            "in": "path",
            "name": "course_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/CourseId"
            }
          },
          {
            "description": "`next_cursor` of the previous page (valid only with the same filters).",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "description": "1..=500 learners per page, each with all their cells (default 100).",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": [
                "integer",
                "null"
              ]
            }
          },
          {
            "description": "Substring of the learner's username, display name or email.",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "description": "Members of this usergroup only.",
            "in": "query",
            "name": "group_id",
            "required": false,
            "schema": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/UsergroupId"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/GradebookStatus"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GradebookPage"
                }
              }
            },
            "description": "Gradebook page"
          }
        },
        "summary": "Course gradebook: the grade-of-record attempt per (learner, activity).",
        "tags": [
          "grading"
        ]
      }
    },
    "/api/v2/courses/{course_id}/gradebook/export": {
      "get": {
        "description": "UTF-8 with BOM; the header and status words follow `Accept-Language`\n(`ru` default, `kk`, `en`); one column per assessment and file\nsubmission, a scored cell is its number.",
        "operationId": "export_gradebook_csv",
        "parameters": [
          {
            "description": "Course id",
            "in": "path",
            "name": "course_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/CourseId"
            }
          },
          {
            "description": "ru (default), kk or en",
            "in": "header",
            "name": "Accept-Language",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "description": "Overrides `Accept-Language` (for links)",
            "in": "query",
            "name": "lang",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/UiLanguage"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/csv": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "CSV"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No grading access"
          }
        },
        "summary": "The gradebook matrix as CSV (graders).",
        "tags": [
          "grading"
        ]
      }
    },
    "/api/v2/courses/{course_id}/grading/events": {
      "get": {
        "description": "Event names: `connected`, `submission.submitted`, `grade.saved`,\n`grade.published`, `submission.returned`, `closed` (grading access\nlost - e.g. the grant set inactive - the stream ends). `data` is\n`{event_id, event, payload, sent_at}` where `payload` carries\n`activity_id`, `user_id`, `status`, `final_score` and either\n`submission_id` (assessment) or `attempt_id` (file submission);\n`id` is the stream id to send back as `Last-Event-ID` on reconnect.",
        "operationId": "course_grading_events",
        "parameters": [
          {
            "description": "Course id",
            "in": "path",
            "name": "course_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/CourseId"
            }
          },
          {
            "description": "Resume after this event id",
            "in": "header",
            "name": "Last-Event-ID",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/CourseGradingStreamEvent"
                }
              }
            },
            "description": "Event stream: each message's `data` is one event"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No grading access"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unknown or inaccessible course"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Too many open streams for this user"
          }
        },
        "summary": "Every grade change and hand-in on a course as `text/event-stream`\n(graders).",
        "tags": [
          "grading"
        ]
      }
    },
