    "/api/v2/assessment-items/{item_id}": {
      "delete": {
        "operationId": "delete_item",
        "parameters": [
          {
            "description": "Item id",
            "in": "path",
            "name": "item_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/AssessmentItemId"
            }
          },
          {
            "description": "Assessment `version`; stale → 412 (without it nothing changes)",
            "in": "header",
            "name": "If-Match",
            "required": false,
            "schema": {
              "format": "int32",
              "type": [
                "integer",
                "null"
              ]
            }
          },
          {
            "description": "`return=representation`: answer 200 with the assessment after the delete instead of 204",
            "in": "header",
            "name": "Prefer",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssessmentDetail"
                }
              }
            },
            "description": "Deleted; the assessment (with `Prefer: return=representation`)",
            "headers": {
              "ETag": {
                "description": "Quoted assessment `version` after the write",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "204": {
            "description": "Deleted",
            "headers": {
              "ETag": {
                "description": "Quoted assessment `version` after the write",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Content locked, or the last item of a live assessment"
          },
          "412": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Stale `If-Match`"
          }
        },
        "summary": "Delete an item; siblings renumber.",
        "tags": [
          "assessments"
        ]
      },
      "patch": {
        "operationId": "update_item",
        "parameters": [
          {
            "description": "Item id",
            "in": "path",
            "name": "item_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/AssessmentItemId"
            }
          },
          {
            "description": "Assessment `version`; stale → 412 (without it nothing changes)",
            "in": "header",
            "name": "If-Match",
            "required": false,
            "schema": {
              "format": "int32",
              "type": [
                "integer",
                "null"
              ]
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateItemRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssessmentItem"
                }
              }
            },
            "description": "Updated",
            "headers": {
              "ETag": {
                "description": "Quoted assessment `version` after the write",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Content locked"
          },
          "412": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Stale `If-Match`"
          }
        },
        "summary": "Partial item update. Body/max-score changes are refused (409) once a\npublished assessment has graded submissions.",
        "tags": [
          "assessments"
        ]
      }
    },
    "/api/v2/assessment-items/{item_id}/reference-check": {
      "post": {
        "description": "One entry per language the item allows. Retry-safe with\n`Idempotency-Key` (a replay answers the stored verdicts without\nspending runner time again).",
        "operationId": "reference_check_item",
        "parameters": [
          {
            "description": "Code item id",
            "in": "path",
            "name": "item_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/AssessmentItemId"
            }
          },
          {
            "description": "Client retry token (optional)",
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReferenceCheckResponse"
                }
              }
            },
            "description": "Per-language verdicts"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No authoring access"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unknown or not a code item"
          }
        },
        "summary": "Run one code item's stored reference solutions against all its tests\n(authors only).",
        "tags": [
          "code"
        ]
      }
    },
    "/api/v2/assessment-items/{item_id}/runs": {
      "get": {
        "description": "Masked like `GET /code-runs/{id}` (authors see hidden-test data). With\n`submission_id` + `purpose=final`: the run a submission was graded on.",
        "operationId": "list_my_code_runs",
        "parameters": [
          {
            "description": "Code item id",
            "in": "path",
            "name": "item_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/AssessmentItemId"
            }
          },
          {
            "description": "Runs of this submission only (with `purpose=final`: the run its\ngrade came from).",
            "in": "query",
            "name": "submission_id",
            "required": false,
            "schema": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/SubmissionId"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          {
            "in": "query",
            "name": "purpose",
            "required": false,
            "schema": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/CodeRunPurpose"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          {
            "description": "1..=50 (default 20).",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CodeRun"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Runs"
          }
        },
        "summary": "The caller's own runs of an item, newest first.",
        "tags": [
          "code"
        ]
      },
      "post": {
        "description": "Does not affect any grade - hidden tests only run at submit. Needs\nsubmit access to the assessment (authors may preview and see hidden\ndata). With an `Idempotency-Key`, a retry with the same source, input\nand language replays the finished run (200); a different payload under\nthe same key is 409. Limited to 20 runs per minute per user.",
        "operationId": "run_item",
        "parameters": [
          {
            "description": "Code item id",
            "in": "path",
            "name": "item_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/AssessmentItemId"
            }
          },
          {
            "description": "Client retry token (optional)",
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CodeRun"
                }
              }
            },
            "description": "Replayed earlier run"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CodeRun"
                }
              }
            },
            "description": "Executed"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Idempotency-Key reused for a different run"
          },
          "413": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Source or input too large"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Blank source, wrong item kind, or language not allowed"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Too many runs"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Code runner unavailable (run recorded as degraded)"
          }
        },
        "summary": "Run code against an item's visible tests (or one custom input).",
        "tags": [
          "code"
        ]
      }
    },
    "/api/v2/assessments": {
      "post": {
        "description": "Requires `assessment:author` on the course (platform scope or course\ncreator with own scope). Code challenges start with one default code\nitem.",
