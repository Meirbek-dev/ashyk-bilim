---
source: crates/api/tests/openapi.rs
expression: json
---
{
  "components": {
    "schemas": {
      "AccessGroup": {
        "properties": {
          "id": {
            "$ref": "#/components/schemas/UsergroupId"
          },
          "member_count": {
            "format": "int64",
            "type": "integer"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "member_count"
        ],
        "type": "object"
      },
      "AccessMode": {
        "enum": [
          "all_course_learners",
          "restricted"
        ],
        "type": "string"
      },
      "AccessUser": {
        "properties": {
          "avatar_key": {
            "type": [
