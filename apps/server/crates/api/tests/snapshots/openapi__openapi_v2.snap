    "/api/v2/courses": {
      "get": {
        "description": "Public courses plus the caller's own and co-authored ones (platform\nupdaters/managers see everything). `mine=true` narrows to courses the\ncaller may edit and adds the `summary` block; `q`, `sort` and `preset`\nfilter/sort (see `CourseListQuery`).",
        "operationId": "list_courses",
        "parameters": [
          {
            "description": "next_cursor from the previous page",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/CourseId"
            }
          },
          {
            "description": "Page size, 1..=100 (default 20)",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "description": "Only courses the caller may edit (adds `summary`)",
            "in": "query",
            "name": "mine",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "description": "Substring filter over name/description",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "`progress`: the caller's in-progress courses first; default `updated`",
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/CourseListSort"
            }
          },
          {
            "description": "Default `all`; `archived` needs `mine=true`",
            "in": "query",
            "name": "preset",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/CourseListPreset"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoursePage"
                }
              }
            },
            "description": "Page of courses"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "`preset=archived` without `mine=true`"
          }
        },
        "summary": "Course listing.",
        "tags": [
          "courses"
        ]
      },
      "post": {
        "operationId": "create_course",
        "parameters": [
          {
            "description": "Retry-safe replay key",
            "in": "header",
            "name": "Idempotency-Key",
