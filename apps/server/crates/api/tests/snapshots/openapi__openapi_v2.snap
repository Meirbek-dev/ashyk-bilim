            "oneOf": [
              {
                "$ref": "#/components/schemas/UnixTime"
              },
              {
                "type": "null"
              }
            ]
          },
          "href": {
            "description": "Client route for the primary action.",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "kind": {
            "description": "A [`WorkKind`] value (the schema keeps `string` while clients'\nfixtures catch up; the `kind` filter is typed).",
            "type": "string"
          },
          "learner_name": {
            "description": "Teacher items: the learner's display name, else username (absent otherwise).",
            "type": "string"
          },
          "message_key": {
            "$ref": "#/components/schemas/WorkMessageKey",
            "description": "Always present on this server (optional in the schema so earlier\nclients' fixtures stay valid)."
          },
          "message_params": {
            "$ref": "#/components/schemas/WorkMessageParams",
            "description": "Always present, like `message_key`."
          },
          "primary_action": {
            "type": "string"
          },
          "priority": {
