            "type": "boolean"
          },
          "disabled_reasons": {
            "items": {
              "$ref": "#/components/schemas/DisabledReason"
            },
            "type": "array"
          },
          "draft_id": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/SubmissionId"
              },
              {
                "type": "null"
              }
            ]
          },
