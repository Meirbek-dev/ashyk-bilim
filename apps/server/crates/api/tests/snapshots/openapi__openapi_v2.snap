              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No live session"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unknown, or another user's"
          }
        },
        "summary": "Mark one notification read (idempotent); emits `notification.read`.",
        "tags": [
          "me"
        ]
      }
    },
    "/api/v2/platform": {
      "get": {
        "operationId": "get_platform",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Platform"
                }
              }
            },
            "description": "Platform settings",
            "headers": {
              "ETag": {
                "description": "Quoted `version`",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "summary": "The platform singleton. Intentionally public: the frontend bootstraps\nnavigation, auth pages, and landing content from it before any session\nexists.",
        "tags": [
          "platform"
        ]
      },
      "patch": {
        "operationId": "update_platform",
        "parameters": [
          {
            "description": "Current `version`; stale → 412",
            "in": "header",
            "name": "If-Match",
            "required": false,
            "schema": {
              "format": "int32",
              "type": [
                "integer",
                "null"
              ]
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdatePlatformRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Platform"
                }
              }
            },
            "description": "Updated",
            "headers": {
              "ETag": {
                "description": "Quoted new version",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Missing permission"
          },
          "412": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Stale `If-Match`"
          }
        },
        "summary": "Update platform settings (requires `platform:update:platform` - admins).\nBranding changes claim finalized `platform-logo` / `platform-thumbnail`\nuploads; the replaced object is released for reaping.",
        "tags": [
          "platform"
        ]
      }
    },
    "/api/v2/progress/activities/{activity_id}": {
      "delete": {
        "description": "S-10 name of [`remove_activity`] (that path is deprecated).",
        "operationId": "uncomplete_activity",
        "parameters": [
          {
            "description": "Activity id",
