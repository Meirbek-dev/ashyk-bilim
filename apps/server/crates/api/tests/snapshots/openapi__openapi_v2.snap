    "/api/v2/me/events": {
      "get": {
        "description": "Event names: `connected`, then the closed set of user events -\n`grading.updated` (courses the caller grades), `submission.updated`\n(the caller's own work), `notification.created`, `notification.read`,\n`xp.awarded` - and `closed` (session gone; the stream ends). `data` is\n`{event_id, event, payload, sent_at}`; `id` is the stream id to send\nback as `Last-Event-ID` on reconnect (the stream keeps the last ~500\nevents for 7 days). Comment heartbeats every 25 s.",
        "operationId": "my_events",
        "parameters": [
          {
            "description": "Resume after this event id",
            "in": "header",
            "name": "Last-Event-ID",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/UserStreamEvent"
                }
              }
            },
            "description": "Event stream: each message's `data` is one event"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No live session"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Too many open streams for this user"
          }
        },
        "summary": "Everything addressed to the caller as `text/event-stream` (S-06): one\nstream per session replaces polling.",
        "tags": [
          "me"
        ]
      }
    },
    "/api/v2/me/notification-preferences": {
      "get": {
        "operationId": "get_notification_preferences",
