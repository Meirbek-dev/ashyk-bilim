    "/api/v2/submissions/{submission_id}/submit": {
      "post": {
        "description": "Optionally applies a last answer patch. `If-Match` is honoured when\npresent. With an `Idempotency-Key`, a retry with the same body replays\nthe original response for 24h; the same key with a different body is\n422. Limited to 3 submits per 10 seconds per learner.",
        "operationId": "submit_submission",
        "parameters": [
          {
            "description": "Submission id",
            "in": "path",
            "name": "submission_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/SubmissionId"
            }
          },
          {
            "description": "Draft version guard (optional)",
            "in": "header",
            "name": "If-Match",
            "required": false,
            "schema": {
              "type": [
                "integer",
                "null"
              ]
            }
          },
          {
            "description": "Client retry token (optional)",
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StudentSubmission"
                }
              }
            },
            "description": "Graded or queued for review"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Gate closed: `TIME_LIMIT_EXPIRED`, `PAST_DUE` or `REMEDIATION_REQUIRED`"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unknown, not yours, or a staff preview (never resumed by a learner)"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Already submitted or stale draft_version"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Idempotency-Key reused with a different body"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Too many submits"
          }
        },
        "summary": "Submit the draft for grading.",
        "tags": [
          "submissions"
        ]
      }
    },
    "/api/v2/submissions/{submission_id}/violations": {
      "post": {
        "description": "Returns the server-side count and whether submitting now zeroes the\nattempt (a detector is on and the threshold is reached).",
