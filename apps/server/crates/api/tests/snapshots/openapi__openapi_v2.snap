      "RegisterRequest": {
        "additionalProperties": false,
        "description": "Self-registration (DECISIONS 2026-09-12). No `Debug` - carries a password.\nRules mirror the legacy `UserCreate`: unique username/email; the password\nfollows [`super::new_password`].",
        "properties": {
          "email": {
            "maxLength": 320,
