---
source: crates/api/tests/openapi.rs
expression: json
---
{
  "components": {
    "schemas": {
      "AccessGroup": {
        "properties": {
          "id": {
            "$ref": "#/components/schemas/UsergroupId"
          },
          "member_count": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "member_count"
        ],
        "type": "object"
      },
      "AccessMode": {
        "enum": [
          "all_course_learners",
          "restricted"
        ],
        "type": "string"
      },
      "AccessUser": {
        "properties": {
          "avatar_key": {
            "type": [
              "string",
              "null"
            ]
          },
          "display_name": {
            "type": "string"
          },
          "id": {
            "$ref": "#/components/schemas/UserId"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "display_name",
          "avatar_key"
        ],
        "type": "object"
      },
      "AccessView": {
        "properties": {
          "effective_user_count": {
            "description": "Distinct people reachable through both lists.",
            "type": "integer"
          },
          "mode": {
            "$ref": "#/components/schemas/AccessMode"
          },
          "usergroups": {
            "items": {
              "$ref": "#/components/schemas/AccessGroup"
            },
            "type": "array"
          },
          "users": {
            "description": "Only meaningful while `mode` is `restricted`.",
            "items": {
              "$ref": "#/components/schemas/AccessUser"
            },
            "type": "array"
          },
          "version": {
            "description": "The `If-Match` of `PUT .../access` (also the `ETag`).",
            "format": "int32",
            "type": "integer"
          }
        },
        "required": [
          "mode",
          "users",
          "usergroups",
          "effective_user_count",
          "version"
        ],
        "type": "object"
      },
      "ActionId": {
        "enum": [
          "enroll",
          "start",
          "continue",
          "revise",
          "view_feedback",
          "wait_for_grade",
          "view_certificate",
          "review_completion",
          "none"
        ],
        "type": "string"
      },
      "Activity": {
        "properties": {
          "activity_sub_type": {
            "$ref": "#/components/schemas/ActivitySubType"
          },
          "activity_type": {
            "$ref": "#/components/schemas/ActivityType"
          },
          "allowed_actions": {
            "description": "What the caller may do to this activity now.",
            "items": {
              "$ref": "#/components/schemas/ActivityAction"
            },
            "type": "array"
          },
          "chapter_id": {
            "$ref": "#/components/schemas/ChapterId"
          },
          "course_id": {
            "$ref": "#/components/schemas/CourseId"
          },
          "id": {
            "$ref": "#/components/schemas/ActivityId"
          },
          "name": {
            "type": "string"
          },
          "position": {
            "description": "1-based, contiguous within the chapter.",
            "format": "int32",
            "type": "integer"
          },
          "published": {
            "type": "boolean"
          },
          "version": {
            "description": "Optimistic lock - send back as `If-Match` on the content PATCH.",
            "format": "int32",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "chapter_id",
          "course_id",
          "name",
          "activity_type",
          "activity_sub_type",
          "published",
          "position",
          "version",
          "allowed_actions"
        ],
        "type": "object"
      },
      "ActivityAction": {
        "description": "What the caller may do to an activity (`Activity.allowed_actions`).",
        "enum": [
          "update",
          "delete",
          "move"
        ],
        "type": "string"
      },
      "ActivityContent": {
        "description": "`activities.content`: the editor document (dynamic pages) or the media\nreference (video / document); `{}` for kinds that keep their content\nelsewhere (assessments, file submissions).",
        "oneOf": [
          {
            "$ref": "#/components/schemas/EditorDocument"
          },
          {
            "$ref": "#/components/schemas/MediaContent"
          }
        ]
      },
      "ActivityDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Activity"
          },
          {
            "properties": {
              "content": {
                "$ref": "#/components/schemas/ActivityContent",
                "description": "Editor content (dynamic pages) or type-specific payload."
              },
              "details": {
                "$ref": "#/components/schemas/ActivityDetails"
              },
              "settings": {
                "$ref": "#/components/schemas/ActivitySettings"
              }
            },
            "required": [
              "content",
              "details",
              "settings"
            ],
            "type": "object"
          }
        ],
        "description": "Full activity view with the heavy jsonb columns."
      },
      "ActivityDetails": {
        "description": "`activities.details`: player settings of video activities (camelCase as\nthe web writes them); `{}` for other kinds.",
        "properties": {
          "autoplay": {
            "type": "boolean"
          },
          "endTime": {
            "description": "Seconds; absent = play to the end.",
            "format": "double",
            "type": "number"
          },
          "muted": {
            "type": "boolean"
          },
          "startTime": {
            "description": "Seconds.",
            "format": "double",
            "type": "number"
          }
        },
        "type": "object"
      },
      "ActivityDropoffRow": {
        "properties": {
          "activity_id": {
            "$ref": "#/components/schemas/ActivityId"
          },
          "activity_name": {
            "type": "string"
          },
          "activity_type": {
            "type": "string"
          },
          "chapter_id": {
            "$ref": "#/components/schemas/ChapterId"
          },
          "current_step_completions": {
            "type": "integer"
          },
          "dropoff_pct": {
            "format": "double",
            "type": "number"
          },
          "previous_step_completions": {
            "type": "integer"
          }
        },
        "required": [
          "chapter_id",
          "activity_id",
          "activity_name",
          "activity_type",
          "previous_step_completions",
          "current_step_completions",
          "dropoff_pct"
        ],
        "type": "object"
      },
      "ActivityId": {
        "format": "uuid",
        "type": "string"
      },
      "ActivityProgressState": {
        "description": "Canonical per-learner activity state (legacy `ActivityProgressState`).",
        "enum": [
          "not_started",
          "in_progress",
          "submitted",
          "needs_grading",
          "returned",
          "graded",
          "passed",
          "failed",
          "completed"
        ],
        "type": "string"
      },
      "ActivitySettings": {
        "additionalProperties": {
          "$ref": "#/components/schemas/JsonValue"
        },
        "description": "`activities.settings`.\n\nThe server reads `required` (progress: `false` makes the activity\noptional). Migrated legacy rows keep the legacy\nassessment settings they had (exam / code-challenge keys such as\n`time_limit`, `attempt_limit`, `kind`): kept as is, read by nobody.",
        "properties": {
          "required": {
            "description": "Absent = required.",
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "ActivityState": {
        "properties": {
          "activity_type": {
            "$ref": "#/components/schemas/ActivityType"
          },
          "allowed_actions": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "available": {
            "type": "boolean"
          },
          "blocked_reason": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/BlockedReason"
              },
              {
                "type": "null"
              }
            ]
          },
          "complete": {
            "type": "boolean"
          },
          "due_at_unix": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/UnixTime"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "$ref": "#/components/schemas/ActivityId"
          },
          "is_late": {
            "type": "boolean"
          },
          "passed": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "score": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "state": {
            "$ref": "#/components/schemas/WorkState"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "activity_type",
          "required",
          "state",
          "complete",
          "is_late",
          "available",
          "allowed_actions",
          "blocked_reason",
          "due_at_unix",
          "passed",
          "score"
        ],
        "type": "object"
      },
      "ActivitySubType": {
        "description": "Activity sub-kind; must pair with its [`ActivityType`].",
        "enum": [
          "dynamic_page",
          "video_youtube",
          "video_hosted",
          "document_pdf",
          "document_doc",
          "quiz_standard",
          "exam_standard",
          "code_general",
          "code_competitive",
          "file_submission_standard",
          "custom"
        ],
        "type": "string"
      },
      "ActivityType": {
        "description": "Activity kind (`custom` exists only on migrated legacy rows).",
        "enum": [
          "dynamic",
          "video",
          "document",
          "quiz",
          "exam",
          "code_challenge",
          "file_submission",
          "custom"
        ],
        "type": "string"
      },
      "AddContributorRequest": {
        "additionalProperties": false,
        "description": "Add someone to the roster by id or username (exactly one).",
        "properties": {
          "role": {
            "$ref": "#/components/schemas/ContributorRole",
            "description": "`maintainer | contributor | reporter` (default `contributor`)."
          },
          "user_id": {
            "$ref": "#/components/schemas/UserId"
          },
          "username": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          }
        },
        "type": "object"
      },
      "AdminAnalyticsResponse": {
        "properties": {
          "cohort_retention": {
            "items": {
              "$ref": "#/components/schemas/AdminCohortRow"
            },
            "type": "array"
          },
          "content_roi": {
            "items": {
              "$ref": "#/components/schemas/AdminCourseRow"
            },
            "type": "array"
          },
          "course_health_ranking": {
            "items": {
              "$ref": "#/components/schemas/AdminCourseRow"
            },
            "type": "array"
          },
          "department_program_performance": {
            "items": {
              "$ref": "#/components/schemas/AdminProgramRow"
            },
            "type": "array"
          },
          "generated_at_unix": {
            "$ref": "#/components/schemas/UnixTime"
          },
          "teacher_workload_comparison": {
            "items": {
              "$ref": "#/components/schemas/AdminTeacherRow"
            },
            "type": "array"
          }
        },
        "required": [
          "generated_at_unix",
          "teacher_workload_comparison",
          "course_health_ranking",
          "cohort_retention",
          "department_program_performance",
          "content_roi"
        ],
        "type": "object"
      },
      "AdminAwardRequest": {
        "additionalProperties": false,
        "description": "Platform managers grant XP to a user.",
        "properties": {
          "amount": {
            "format": "int32",
            "maximum": 100000,
            "minimum": 1,
            "type": "integer"
          },
          "idempotency_key": {
            "maxLength": 200,
            "type": "string"
          },
          "reason": {
            "maxLength": 500,
            "type": "string"
          },
          "user_id": {
            "$ref": "#/components/schemas/UserId"
          }
        },
        "required": [
          "user_id",
          "amount"
        ],
        "type": "object"
      },
      "AdminCohortRow": {
        "properties": {
          "avg_progress_pct": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "cohort_id": {
            "$ref": "#/components/schemas/UsergroupId"
          },
          "cohort_name": {
            "type": "string"
          },
          "learners": {
            "type": "integer"
          },
          "retained_learners": {
            "type": "integer"
          },
          "retention_rate": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          }
        },
        "required": [
          "cohort_id",
          "cohort_name",
          "learners",
          "retained_learners",
          "avg_progress_pct",
          "retention_rate"
        ],
        "type": "object"
      },
      "AdminCourseRow": {
        "properties": {
          "active_learners_7d": {
            "type": "integer"
          },
          "at_risk_learners": {
            "type": "integer"
          },
          "completion_rate": {
            "format": "double",
            "type": "number"
          },
          "content_roi_score": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "course_id": {
            "$ref": "#/components/schemas/CourseId"
          },
          "course_name": {
            "type": "string"
          },
          "health_score": {
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "course_id",
          "course_name",
          "health_score",
          "completion_rate",
          "active_learners_7d",
          "at_risk_learners",
          "content_roi_score"
        ],
        "type": "object"
      },
      "AdminList": {
        "description": "Which admin list changed.",
        "enum": [
          "users",
          "roles",
          "groups"
        ],
        "type": "string"
      },
      "AdminListUpdated": {
        "description": "LIVE: an admin list the recipient can read changed.",
        "properties": {
          "list": {
            "$ref": "#/components/schemas/AdminList"
          }
        },
        "required": [
          "list"
        ],
        "type": "object"
      },
      "AdminProgramRow": {
        "properties": {
          "completion_rate": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "course_count": {
            "type": "integer"
          },
          "health_score": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "learner_count": {
            "type": "integer"
          },
          "program_id": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/UserId",
                "description": "The creating teacher; `None` groups courses without a creator."
              },
              {
                "type": "null"
              }
            ]
          },
          "program_name": {
            "type": "string"
          }
        },
        "required": [
          "program_name",
          "course_count",
          "learner_count",
          "completion_rate",
          "health_score",
          "program_id"
        ],
        "type": "object"
      },
      "AdminRun": {
        "description": "One run in the operations view (legacy `AIOperationRunRead`).",
        "properties": {
          "completed_at_unix": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/UnixTime"
              },
              {
                "type": "null"
              }
            ]
          },
          "context": {
            "$ref": "#/components/schemas/RunContext",
            "description": "The allow-listed part of the run metadata."
          },
          "cost_estimate": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "duration_ms": {
            "format": "int32",
            "type": [
              "integer",
              "null"
            ]
          },
          "error_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "feature": {
            "$ref": "#/components/schemas/AiRunKind"
          },
          "id": {
            "$ref": "#/components/schemas/AiRunId"
          },
          "input_tokens": {
            "format": "int32",
            "type": [
              "integer",
              "null"
            ]
          },
          "model_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "output_tokens": {
            "format": "int32",
            "type": [
              "integer",
              "null"
            ]
          },
          "retry_count": {
            "type": "integer"
          },
          "started_at_unix": {
            "$ref": "#/components/schemas/UnixTime"
          },
          "status": {
            "$ref": "#/components/schemas/AiRunStatus"
          },
          "stuck": {
            "description": "Queued or running for over ten minutes.",
            "type": "boolean"
          },
          "time_to_first_text_ms": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "status",
          "feature",
          "retry_count",
          "started_at_unix",
          "stuck",
          "context",
          "completed_at_unix",
          "cost_estimate",
          "duration_ms",
          "error_code",
          "input_tokens",
          "model_name",
          "output_tokens",
          "time_to_first_text_ms"
        ],
        "type": "object"
      },
      "AdminRunDetail": {
        "properties": {
          "artifacts": {
            "items": {
              "$ref": "#/components/schemas/RunArtifact"
            },
            "type": "array"
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/RunEvent"
            },
            "type": "array"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/RunEvidence"
            },
            "type": "array"
          },
          "run": {
            "$ref": "#/components/schemas/AdminRun"
          }
        },
        "required": [
          "run",
          "events",
          "artifacts",
          "evidence"
        ],
        "type": "object"
      },
      "AdminRunPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/AdminRun"
            },
            "type": "array"
          },
          "next_cursor": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/AiRunId"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "items",
          "next_cursor"
        ],
        "type": "object"
      },
      "AdminSettings": {
        "properties": {
          "ai_enabled": {
            "type": "boolean"
          },
          "draft_mode_enabled": {
            "type": "boolean"
          },
          "effective": {
            "$ref": "#/components/schemas/AiEffectiveConfig",
            "description": "The whole `AB__AI__*` section with secrets redacted."
          },
          "features": {
            "items": {
              "$ref": "#/components/schemas/FeatureSetting"
            },
            "type": "array"
          },
          "max_output_tokens": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "max_tokens_per_request": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "model": {
            "type": "string"
          },
          "monthly_token_budget": {
            "type": "integer"
          },
          "provider_ready": {
            "type": "boolean"
          }
        },
        "required": [
          "ai_enabled",
          "provider_ready",
          "model",
          "monthly_token_budget",
          "max_tokens_per_request",
          "max_output_tokens",
          "draft_mode_enabled",
          "features",
          "effective"
        ],
        "type": "object"
      },
      "AdminTeacherRow": {
        "properties": {
          "at_risk_learners": {
            "type": "integer"
          },
          "managed_course_count": {
            "type": "integer"
          },
          "median_feedback_latency_hours": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "sla_breaches": {
            "type": "integer"
          },
          "teacher_display_name": {
            "type": "string"
          },
          "teacher_user_id": {
            "$ref": "#/components/schemas/UserId"
          },
          "workload_backlog": {
            "type": "integer"
          }
        },
        "required": [
          "teacher_user_id",
          "teacher_display_name",
          "managed_course_count",
          "workload_backlog",
          "sla_breaches",
          "at_risk_learners",
          "median_feedback_latency_hours"
        ],
        "type": "object"
      },
      "AdminUser": {
        "description": "Admin listing row (includes email + status - platform:read gated).",
        "properties": {
          "allowed_actions": {
            "description": "What the caller may do to this account now.",
            "items": {
              "$ref": "#/components/schemas/AdminUserAction"
            },
            "type": "array"
          },
          "created_at_unix": {
            "$ref": "#/components/schemas/UnixTime"
          },
          "display_name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "id": {
            "$ref": "#/components/schemas/UserId"
          },
          "organization": {
            "description": "`\"\"` = not given yet.",
            "type": "string"
          },
          "roles": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "status": {
            "$ref": "#/components/schemas/UserStatus",
            "description": "`active` or `disabled`."
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "email",
          "display_name",
          "organization",
          "status",
          "roles",
          "created_at_unix",
          "allowed_actions"
        ],
        "type": "object"
      },
      "AdminUserAction": {
        "description": "What the caller may do to a user in the admin directory (`AdminUser.allowed_actions`).",
        "enum": [
          "manage_roles",
          "disable",
          "enable"
        ],
        "type": "string"
      },
      "AdminUserPage": {
        "description": "Keyset page (ARCHITECTURE §6): pass `next_cursor` back as `cursor`.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/AdminUser"
            },
            "type": "array"
          },
          "next_cursor": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/UserId"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "items",
          "next_cursor"
        ],
        "type": "object"
      },
      "AffiliationSection": {
        "additionalProperties": false,
        "properties": {
          "affiliations": {
            "items": {
              "$ref": "#/components/schemas/ProfileAffiliation"
            },
            "type": "array"
          },
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "affiliations"
        ],
        "type": "object"
      },
      "AgUiAssistantRole": {
        "enum": [
          "assistant"
        ],
        "type": "string"
      },
      "AgUiContext": {
        "description": "AG-UI `Context` entry (accepted and ignored).",
        "properties": {
          "description": {
