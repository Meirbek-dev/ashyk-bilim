    "/api/v2/assessments/{id}/submissions": {
      "get": {
        "description": "Needs `assessment:grade` on the course. `status=needs_grading` is the\npending queue. Keyset-paged: pass `next_cursor` back as `cursor`.",
        "operationId": "review_queue",
        "parameters": [
          {
            "description": "Assessment id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/AssessmentId"
            }
          },
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/components/schemas/ReviewStatus"
                }
              ]
            }
          },
          {
            "in": "query",
            "name": "late_only",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "description": "Substring of the learner's username or display name.",
            "in": "query",
            "name": "search",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "description": "`next_cursor` of the previous page.",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/components/schemas/SubmissionId"
                }
              ]
            }
          },
          {
            "description": "1..=100 (default 25).",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewPage"
                }
              }
            },
            "description": "Review page"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No grading access"
          }
        },
        "summary": "Submitted work awaiting or holding a grade, newest first.",
        "tags": [
          "grading"
        ]
      },
      "post": {
        "description": "201 when this call opened it, 200 when a draft already existed. Refused\n(403) with the blocking reasons when the attempt state disallows it.",
        "operationId": "start_submission",
        "parameters": [
          {
            "description": "Assessment id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/AssessmentId"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StudentSubmission"
                }
              }
            },
            "description": "Existing draft"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StudentSubmission"
                }
              }
            },
            "description": "Draft opened",
            "headers": {
              "ETag": {
                "description": "Quoted draft_version",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Attempt not allowed now"
          }
        },
        "summary": "Open a draft attempt (or return the one already open).",
        "tags": [
          "submissions"
        ]
      }
    },
