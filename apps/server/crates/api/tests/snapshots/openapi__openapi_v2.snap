          "412": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Stale `If-Match`"
          }
        },
        "summary": "Delete a custom role; holders' live sessions lose it immediately.",
        "tags": [
          "rbac"
        ]
      },
      "get": {
        "operationId": "get_role",
        "parameters": [
          {
            "description": "Role slug",
