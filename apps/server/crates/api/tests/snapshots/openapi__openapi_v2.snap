    "/api/v2/groups": {
      "get": {
        "description": "S-10 name of [`list_usergroups`] (that path is deprecated).",
        "operationId": "list_groups",
        "parameters": [
          {
            "description": "next_cursor from the previous page",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/UsergroupId"
            }
          },
          {
            "description": "Page size, 1..=100 (default 20)",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsergroupPage"
                }
              }
            },
            "description": "Page of usergroups"
          }
        },
        "summary": "Newest-first listing (requires `usergroup:read:platform`).",
        "tags": [
          "usergroups"
        ]
      },
      "post": {
