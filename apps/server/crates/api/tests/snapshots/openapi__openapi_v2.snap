                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unknown or inaccessible"
          }
        },
        "summary": "One block (visibility follows the course).",
        "tags": [
          "courses"
        ]
      }
    },
    "/api/v2/bulk-actions/{bulk_action_id}": {
      "get": {
        "operationId": "get_bulk_action",
        "parameters": [
          {
