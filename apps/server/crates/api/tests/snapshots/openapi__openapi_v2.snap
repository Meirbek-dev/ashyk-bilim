---
source: crates/api/tests/openapi.rs
expression: json
---
{
  "components": {
    "schemas": {
      "AssignRoleRequest": {
        "additionalProperties": false,
        "properties": {
          "role": {
            "description": "Role slug, e.g. `instructor`.",
            "type": "string"
          }
        },
        "required": [
          "role"
        ],
        "type": "object"
      },
      "ErrorCode": {
        "description": "Stable, closed set of machine-readable error codes.",
        "enum": [
          "internal",
          "not-found",
          "forbidden",
          "unauthenticated",
          "conflict",
          "validation-failed",
          "rate-limited",
          "payload-too-large",
          "service-unavailable",
          "invalid-credentials",
          "mfa-required",
          "session-expired",
          "csrf-rejected",
          "account-disabled"
        ],
        "type": "string"
      },
      "FieldError": {
        "description": "A single field-level validation failure. `code` is a stable machine key the\nfrontend translates (e.g. `required`, `too-long`); `message` is English.",
        "properties": {
          "code": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "field",
          "code",
          "message"
        ],
        "type": "object"
      },
      "Health": {
        "properties": {
          "status": {
            "description": "Always `\"ok\"` when the endpoint answers.",
            "type": "string"
          },
          "version": {
            "description": "Server crate version.",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ],
        "type": "object"
      },
      "LoginRequest": {
        "additionalProperties": false,
        "description": "Password login. No `Debug` derive — the password must never format.",
        "properties": {
          "login": {
            "description": "Username or email.",
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "login",
          "password"
        ],
        "type": "object"
      },
      "Problem": {
        "description": "The wire shape of every error response.",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode",
            "description": "Stable machine code — the frontend's i18n key."
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "field_errors": {
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "type": "array"
          },
          "request_id": {
            "description": "Correlation id; also present as the `x-request-id` response header.",
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "description": "Stable documentation URI for this error class.",
            "type": "string"
          }
        },
        "required": [
          "type",
          "status",
          "code",
          "title"
        ],
        "type": "object"
      },
      "Role": {
        "properties": {
          "description_key": {
            "type": "string"
          },
          "display_name_key": {
            "description": "i18n key (frontend catalogs own the display strings).",
            "type": "string"
          },
          "is_system": {
            "type": "boolean"
          },
          "permissions": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "priority": {
            "format": "int32",
            "type": "integer"
          },
          "slug": {
            "type": "string"
          }
        },
        "required": [
          "slug",
          "display_name_key",
          "description_key",
          "priority",
          "is_system",
          "permissions"
        ],
        "type": "object"
      },
      "SessionInfo": {
        "description": "The current session, as the frontend sees it (client-side permission\ngating mirrors the legacy `Session` contract).",
        "properties": {
          "permissions": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "roles": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "user_id": {
            "$ref": "#/components/schemas/UserId"
          }
        },
        "required": [
          "user_id",
          "roles",
          "permissions"
        ],
        "type": "object"
      },
      "SessionSummary": {
        "description": "One of the caller's live sessions. `handle` is a non-bearer identifier\n(raw session ids never leave the server).",
        "properties": {
          "created_at_unix": {
            "format": "int64",
            "type": "integer"
          },
          "current": {
            "type": "boolean"
          },
          "handle": {
            "type": "string"
          },
          "ip": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_seen_unix": {
            "format": "int64",
            "type": "integer"
          },
          "user_agent": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "handle",
          "current",
          "created_at_unix",
          "last_seen_unix"
        ],
        "type": "object"
      },
      "UpdateProfileRequest": {
        "additionalProperties": false,
        "description": "Partial update; omitted fields are unchanged.",
        "properties": {
          "bio": {
            "type": [
              "string",
              "null"
            ]
          },
          "display_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "locale": {
            "description": "One of the platform locales.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "UserId": {
        "format": "uuid",
        "type": "string"
      },
      "UserProfile": {
        "properties": {
          "avatar_key": {
            "type": [
              "string",
              "null"
            ]
          },
          "bio": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "id": {
            "$ref": "#/components/schemas/UserId"
          },
          "locale": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "email",
          "display_name",
          "bio",
          "locale"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "University LMS / MOOC platform API (v2, Rust rewrite).",
    "license": {
      "name": ""
    },
    "title": "Ashyq Bilim API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v2/auth/login": {
      "post": {
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionInfo"
                }
              }
            },
            "description": "Logged in; session cookie set"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Invalid credentials"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Account disabled"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Too many attempts"
          }
        },
        "summary": "Password login (headless Zitadel session check behind the BFF).",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v2/auth/logout": {
      "post": {
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Session terminated, cookie cleared"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No live session"
          }
        },
        "summary": "Logout: revoke the current session and clear the cookie. Idempotent.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v2/auth/session": {
      "get": {
        "operationId": "current_session",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionInfo"
                }
              }
            },
            "description": "Current session"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No live session"
          }
        },
        "summary": "The caller's current session (also the cheapest \"am I logged in?\" probe).",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v2/auth/sessions": {
      "get": {
        "operationId": "list_sessions",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SessionSummary"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Live sessions"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No live session"
          }
        },
        "summary": "All live sessions of the caller (handles are non-bearer identifiers).",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v2/auth/sessions/{handle}": {
      "delete": {
        "operationId": "revoke_session",
        "parameters": [
          {
            "description": "Session handle from the listing",
            "in": "path",
            "name": "handle",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Revoked"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No such session"
          }
        },
        "summary": "Revoke one of the caller's own sessions by handle.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v2/health": {
      "get": {
        "operationId": "live",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Process is alive"
          }
        },
        "summary": "Liveness: the process is up.",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v2/health/ready": {
      "get": {
        "operationId": "ready",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Ready to serve traffic"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A dependency is unreachable"
          }
        },
        "summary": "Readiness: dependencies are reachable (Postgres; Redis/RustFS/Zitadel probes\njoin as their clients land).",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v2/rbac/roles": {
      "get": {
        "operationId": "list_roles",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Role"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Roles"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Missing permission"
          }
        },
        "summary": "All roles with their grants (requires `role:read:platform`).",
        "tags": [
          "rbac"
        ]
      }
    },
    "/api/v2/users/me": {
      "get": {
        "operationId": "my_profile",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfile"
                }
              }
            },
            "description": "Own profile"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No live session"
          }
        },
        "summary": "The caller's own profile.",
        "tags": [
          "users"
        ]
      },
      "patch": {
        "operationId": "update_my_profile",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProfileRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfile"
                }
              }
            },
            "description": "Updated profile"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Missing permission"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Validation failed"
          }
        },
        "summary": "Update the caller's own profile (requires `user:update:own`).",
        "tags": [
          "users"
        ]
      }
    },
    "/api/v2/users/{user_id}/roles": {
      "post": {
        "operationId": "assign_role",
        "parameters": [
          {
            "description": "Target user",
            "in": "path",
            "name": "user_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/UserId"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssignRoleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Assigned"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Missing permission"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unknown user or role"
          }
        },
        "summary": "Assign a role to a user (requires `role:manage:platform`). Live sessions\nof the user pick the new grants up immediately.",
        "tags": [
          "rbac"
        ]
      }
    },
    "/api/v2/users/{user_id}/roles/{slug}": {
      "delete": {
        "operationId": "unassign_role",
        "parameters": [
          {
            "description": "Target user",
            "in": "path",
            "name": "user_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/UserId"
            }
          },
          {
            "description": "Role slug",
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Removed"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Missing permission"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unknown user or role"
          }
        },
        "summary": "Remove a role from a user (requires `role:manage:platform`).",
        "tags": [
          "rbac"
        ]
      }
    }
  },
  "tags": [
    {
      "description": "Liveness and readiness probes",
      "name": "health"
    },
    {
      "description": "Sessions and authentication (BFF cookie)",
      "name": "auth"
    },
    {
      "description": "User profiles and preferences",
      "name": "users"
    },
    {
      "description": "Roles and permission administration",
      "name": "rbac"
    }
  ]
}
