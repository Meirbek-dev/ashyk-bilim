            ],
            "type": "object"
          },
          {
            "allOf": [
              {
                "$ref": "#/components/schemas/CourseGradingStored"
              },
              {
                "properties": {
                  "event": {
                    "enum": [
                      "submission.submitted"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "event"
                ],
                "type": "object"
              }
            ]
          },
          {
            "allOf": [
              {
                "$ref": "#/components/schemas/CourseGradingStored"
              },
              {
                "properties": {
                  "event": {
                    "enum": [
                      "grade.saved"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "event"
                ],
                "type": "object"
              }
            ]
          },
          {
            "allOf": [
              {
                "$ref": "#/components/schemas/CourseGradingStored"
              },
              {
                "properties": {
                  "event": {
                    "enum": [
                      "grade.published"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "event"
                ],
                "type": "object"
              }
            ]
          },
          {
            "allOf": [
              {
                "$ref": "#/components/schemas/CourseGradingStored"
              },
              {
                "properties": {
                  "event": {
                    "enum": [
                      "submission.returned"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "event"
                ],
                "type": "object"
              }
            ]
          },
          {
            "description": "Grading access lost; the stream ends.",
            "properties": {
              "code": {
                "$ref": "#/components/schemas/ErrorCode"
              },
              "event": {
                "enum": [
                  "closed"
                ],
                "type": "string"
              }
            },
            "required": [
              "code",
              "event"
            ],
            "type": "object"
          }
        ]
      },
