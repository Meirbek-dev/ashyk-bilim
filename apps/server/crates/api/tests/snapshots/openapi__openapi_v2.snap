    "/api/v2/analytics/teacher/interventions/{intervention_id}": {
      "patch": {
        "operationId": "update_intervention",
        "parameters": [
          {
            "description": "Intervention id",
            "in": "path",
            "name": "intervention_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/InterventionId"
            }
          },
          {
            "description": "Intervention `version`; stale -> 412",
            "in": "header",
            "name": "If-Match",
            "required": false,
            "schema": {
              "format": "int32",
              "type": [
                "integer",
                "null"
              ]
            }
          },
          {
            "description": "`7d`, `28d` (default) or `90d`.",
            "in": "query",
            "name": "window",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Window"
            }
          },
          {
            "description": "`previous_period` (default) or `none`.",
            "in": "query",
            "name": "compare",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Compare"
            }
          },
          {
            "description": "`day` (default) or `week`.",
            "in": "query",
            "name": "bucket",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Bucket"
            }
          },
          {
            "description": "Narrow to one bucket: RFC 3339 timestamp or epoch seconds.",
            "in": "query",
            "name": "bucket_start",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Comma-separated course ids (must be inside the caller's scope).",
            "in": "query",
            "name": "course_ids",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Comma-separated usergroup ids.",
            "in": "query",
            "name": "cohort_ids",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Inspect another teacher (platform scope only).",
            "in": "query",
            "name": "teacher_user_id",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "IANA zone for calendar bucketing (default UTC).",
            "in": "query",
            "name": "timezone",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "1-based (default 1).",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "description": "1..=200 (default 25).",
            "in": "query",
            "name": "page_size",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "sort_by",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "`asc` or `desc` (default).",
            "in": "query",
            "name": "sort_order",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/SortOrder"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateInterventionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Intervention"
                }
              }
            },
            "description": "Updated"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not yours or not in scope"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The course is archived"
          },
          "412": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Stale `If-Match`"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Validation"
          }
        },
        "summary": "Update or close an intervention (status, outcome, notes) - the caller's\nown, in a course in scope (404 otherwise). `status: resolved` stamps\n`resolved_at` and records the learner's risk then.",
        "tags": [
          "analytics"
        ]
      }
    },
