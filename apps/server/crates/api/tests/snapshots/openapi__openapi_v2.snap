              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StudyCompanionAnswer"
                }
              }
            },
            "description": "The answer artifact"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "AI disabled or budget exhausted"
          }
        },
        "summary": "Answer inline; the body is the `study_companion` artifact.",
        "tags": [
          "ai"
        ]
      }
    },
