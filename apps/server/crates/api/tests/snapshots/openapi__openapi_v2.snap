              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoursePage"
                }
              }
            },
            "description": "Page of courses"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unknown user"
          }
        },
        "summary": "Courses a user created or actively co-authors, newest first (public\nprofile, readable anonymously). Private ones are included only for the\nuser themself and platform course managers.",
        "tags": [
          "users"
        ]
      }
    },
    "/api/v2/utils/link-preview": {
      "get": {
        "description": "Any signed-in session. `http(s)` only; the hostname must resolve to a\npublic address (loopback is accepted outside production only), 5 s\ndeadline, 1 MiB read cap, 24 h cache per URL. A page that cannot be\nread answers 502 `link-preview-failed`; a rejected URL 422 (`url`).",
        "operationId": "link_preview",
        "parameters": [
          {
            "description": "Page URL (http/https)",
            "in": "query",
            "name": "url",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LinkPreview"
                }
              }
            },
            "description": "Preview"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Rejected URL (scheme, credentials, private address)"
          },
          "502": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The page could not be fetched or is not HTML"
          }
        },
        "summary": "OpenGraph preview of a public web page, for the editor's link block.",
        "tags": [
          "utils"
        ]
      }
    },
    "/api/v2/work": {
      "get": {
        "description": "`role=learner` (default) lists the caller's own open activities; `role=teacher` lists submissions to grade\nor release across the courses the caller created or co-authors. `kind` and\n`course_id` filter; `sort` orders (default: priority, then due/created\ntime, then id). Paged by an opaque cursor (same filters and order).",
        "operationId": "work_queue",
        "parameters": [
          {
            "description": "`learner` (default) or `teacher`.",
            "in": "query",
            "name": "role",
            "required": false,
            "schema": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/WorkRole"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          {
            "description": "Items of this kind only.",
            "in": "query",
            "name": "kind",
            "required": false,
            "schema": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/WorkKind"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          {
            "description": "Items of this course only.",
            "in": "query",
            "name": "course_id",
            "required": false,
            "schema": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/CourseId"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          {
            "description": "Order; default `priority`.",
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/WorkSort"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          {
            "description": "1..=100 (default 50).",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": [
                "integer",
                "null"
              ]
            }
          },
          {
            "description": "`next_cursor` of the previous page (opaque; same filters and order).",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkQueue"
                }
              }
            },
            "description": "Work queue page"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No session"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Invalid cursor or limit"
          }
        },
        "summary": "Ranked work items for the caller.",
        "tags": [
          "work-queue"
        ]
      }
    }
  },
