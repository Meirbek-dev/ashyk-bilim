                {
                  "$ref": "#/components/schemas/UsergroupId"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Stats"
                }
              }
            },
            "description": "Stats"
          }
        },
        "summary": "Counts, average, pass rate and a ten-bucket score distribution.",
        "tags": [
          "grading"
        ]
      }
    },
    "/api/v2/auth/google": {
      "get": {
        "operationId": "google_start",
        "parameters": [
          {
            "description": "Relative return path",
            "in": "query",
            "name": "callback",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "303": {
            "description": "Redirect to Google"
          }
        },
        "summary": "Start Google sign-in: 303 to Google's consent screen.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v2/auth/google/callback": {
      "get": {
        "operationId": "google_callback",
        "parameters": [
          {
            "description": "Authorization code",
            "in": "query",
            "name": "code",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Opaque state",
            "in": "query",
            "name": "state",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Google-side error",
            "in": "query",
            "name": "error",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "303": {
            "description": "Redirect into the app (or to login with ?error=)"
          }
        },
        "summary": "Google redirects here; on success the session cookie is set and the\nbrowser continues to the original callback path.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v2/auth/login": {
      "post": {
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionInfo"
                }
              }
            },
            "description": "Logged in; session cookie set"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Invalid credentials"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Account disabled"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Too many attempts"
          }
        },
        "summary": "Password login (headless Zitadel session check behind the BFF).",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v2/auth/logout": {
      "post": {
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Session terminated, cookie cleared"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No live session"
          }
        },
        "summary": "Logout: revoke the current session and clear the cookie. Idempotent.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v2/auth/mfa/totp": {
      "delete": {
        "operationId": "totp_remove",
        "responses": {
          "204": {
            "description": "Removed (idempotent)"
          }
        },
        "summary": "Remove the TOTP authenticator.",
        "tags": [
          "auth"
        ]
      },
      "post": {
        "description": "A repeat start within 10 minutes returns the same pending secret\n(UX-254); a start racing another to the identity provider answers\n`idempotency-in-progress` and its retry gets the winner's secret.",
        "operationId": "totp_enroll",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TotpEnrollment"
                }
              }
            },
            "description": "Enrollment secrets"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Already enrolled, or a start is in progress"
          }
        },
        "summary": "Start TOTP enrollment.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v2/auth/mfa/totp/verify": {
      "post": {
        "operationId": "totp_verify",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TotpVerifyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "TOTP active"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Invalid code"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No enrolment pending, or already active"
          }
        },
        "summary": "Activate TOTP with the first code from the authenticator app.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v2/auth/password": {
      "post": {
        "operationId": "change_password",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Password changed"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "`invalid-credentials`: current password wrong"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "New password rejected by policy"
          }
        },
        "summary": "Change the caller's password (current password checked by Zitadel).\nEvery other session of the caller is revoked.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v2/auth/password-reset": {
      "post": {
        "description": "Always 202, whether or not the login names an account (no enumeration);\na known active account gets the code by email (the link opens the web\napp under the `Accept-Language` locale). Throttled per IP (429) and per\naccount (silently).",
        "operationId": "request_password_reset",
        "parameters": [
          {
            "description": "ru, kk or en - the locale of the reset link",
            "in": "header",
            "name": "Accept-Language",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordResetRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Accepted; a code is mailed if the account exists"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Validation failed"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Too many attempts"
          }
        },
        "summary": "Ask for a password reset code by email (public, S-08).",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v2/auth/password-reset/confirm": {
      "post": {
        "operationId": "confirm_password_reset",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordResetConfirmRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Password set; all sessions revoked"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A password change is already in progress"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "`reset-code-invalid` (unknown login, wrong or expired code), or the new password fails the policy (`field_errors[].field == \"new_password\"`)"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Too many attempts"
          }
        },
        "summary": "Set a new password with the emailed reset code (public, S-08). Every\nsession of the account is revoked; the client logs in next.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v2/auth/register": {
      "post": {
        "description": "The link opens the web app under the `Accept-Language` locale (`/ru`,\n`/kz`, `/en`). No session is opened - the client logs in next. Honours\n`Idempotency-Key` (a retry replays the 201 instead of 409\n`username-taken`).",
        "operationId": "register",
        "parameters": [
          {
            "description": "Retry-safe replay key",
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "description": "ru, kk or en - the locale of the verification link",
            "in": "header",
            "name": "Accept-Language",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfile"
                }
              }
            },
            "description": "Account created; verification code sent"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "`username-taken` / `email-taken`"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Validation failed"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Too many attempts"
          }
        },
        "summary": "Self-registration: creates the account (default `user` role) and emails\na verification code.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v2/auth/session": {
      "get": {
        "operationId": "current_session",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionInfo"
                }
              }
            },
            "description": "Current session"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No live session"
          }
        },
        "summary": "The caller's current session (also the cheapest \"am I logged in?\" probe).",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v2/auth/sessions": {
      "get": {
        "operationId": "list_sessions",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SessionSummary"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Live sessions"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No live session"
          }
        },
        "summary": "All live sessions of the caller (handles are non-bearer identifiers).",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v2/auth/sessions/{handle}": {
      "delete": {
        "operationId": "revoke_session",
        "parameters": [
          {
            "description": "Session handle from the listing",
            "in": "path",
            "name": "handle",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Revoked"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No such session"
          }
        },
        "summary": "Revoke one of the caller's own sessions by handle.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v2/auth/verify-email": {
      "post": {
        "operationId": "verify_email",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyEmailRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Email verified"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Invalid or expired code (`field_errors[].field == \"code\"`)"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Too many attempts"
          }
        },
        "summary": "Confirm the email address with the emailed code (public).",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v2/auth/verify-email/resend": {
      "post": {
        "operationId": "resend_verification",
        "parameters": [
          {
            "description": "ru, kk or en - the locale of the verification link",
            "in": "header",
            "name": "Accept-Language",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResendVerificationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Accepted; a code is mailed if the address awaits verification"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Validation failed"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Too many attempts"
          }
        },
        "summary": "Mail a fresh email verification code (public, S-08). Always 202 (no\nenumeration); throttled per IP (429) and per account (silently).",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v2/blocks/{block_id}": {
      "delete": {
        "operationId": "delete_block",
        "parameters": [
          {
            "description": "Block id",
            "in": "path",
