            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BulkGradeSummary"
                }
              }
            },
            "description": "Per-row outcome counts"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No grading access"
          }
        },
        "summary": "Return the selected submissions for revision in one call.",
        "tags": [
          "grading"
        ]
      }
    },
    "/api/v2/assessments/{assessment_id}/submissions": {
      "get": {
        "description": "Needs `assessment:grade` on the course. `status=needs_grading` is the\npending queue. Keyset-paged: pass `next_cursor` back as `cursor`.",
        "operationId": "assessment_review_queue",
        "parameters": [
          {
            "description": "Assessment id",
            "in": "path",
            "name": "assessment_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/AssessmentId"
            }
          },
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/ReviewStatus"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          {
            "in": "query",
            "name": "late_only",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "description": "Substring of the learner's username or display name.",
            "in": "query",
            "name": "search",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "description": "`next_cursor` of the previous page of this queue, sort and order\n(opaque; another queue's or sort's cursor is 422).",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "description": "Queue order (default `submitted_at`); ties newest first.",
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/ReviewSort"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          {
            "description": "Default `desc`.",
            "in": "query",
            "name": "order",
            "required": false,
            "schema": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/SortOrder"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          {
            "description": "1..=100 (default 25).",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": [
                "integer",
                "null"
              ]
            }
          },
          {
            "description": "Members of this usergroup only.",
            "in": "query",
            "name": "group_id",
            "required": false,
            "schema": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/UsergroupId"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewPage"
                }
              }
            },
            "description": "Review page"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No grading access"
          }
        },
        "summary": "Submitted work awaiting or holding a grade, newest first unless `sort` /\n`order` say otherwise (cursors are valid only within one sort/order).",
        "tags": [
          "grading"
        ]
      },
      "post": {
        "description": "201 when this call opened it, 200 when a draft already existed. Refused\n(403) with the blocking reasons when the attempt state disallows it.",
        "operationId": "start_submission",
        "parameters": [
          {
            "description": "Assessment id",
            "in": "path",
            "name": "assessment_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/AssessmentId"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/StartSubmissionRequest"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "description": "Optional; `{}` or no body is the same as `rules_accepted: false`"
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StudentSubmission"
                }
              }
            },
            "description": "Existing draft"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StudentSubmission"
                }
              }
            },
            "description": "Draft opened",
            "headers": {
              "ETag": {
                "description": "Quoted draft_version",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Attempt not allowed now"
          }
        },
        "summary": "Open a draft attempt (or return the one already open).",
        "tags": [
          "submissions"
        ]
      }
    },
