            "description": "Finalized `avatar` upload to claim as the new avatar.",
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          },
          "bio": {
            "type": [
              "string",
              "null"
            ]
          },
          "display_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "locale": {
            "description": "One of the platform locales.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "UpdateRoleRequest": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "display_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "priority": {
            "format": "int32",
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "UpdateUsergroupRequest": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "UserHit": {
        "description": "Public-profile projection (no email — FINDINGS #16).",
        "properties": {
          "avatar_key": {
            "type": [
              "string",
              "null"
            ]
          },
          "display_name": {
            "type": "string"
          },
          "id": {
            "$ref": "#/components/schemas/UserId"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "display_name"
        ],
        "type": "object"
      },
      "UserId": {
        "format": "uuid",
        "type": "string"
      },
      "UserProfile": {
        "properties": {
          "avatar_key": {
            "type": [
              "string",
              "null"
            ]
          },
          "bio": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "id": {
            "$ref": "#/components/schemas/UserId"
          },
          "locale": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "email",
          "display_name",
          "bio",
          "locale"
        ],
        "type": "object"
      },
      "UserSummary": {
        "properties": {
          "display_name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "id": {
            "$ref": "#/components/schemas/UserId"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "display_name",
          "email"
        ],
        "type": "object"
      },
      "Usergroup": {
        "properties": {
          "created_at_unix": {
            "format": "int64",
            "type": "integer"
          },
          "creator_id": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/UserId"
              }
            ]
          },
          "description": {
            "type": "string"
          },
          "id": {
            "$ref": "#/components/schemas/UsergroupId"
          },
          "member_count": {
            "format": "int64",
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "updated_at_unix": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "member_count",
          "created_at_unix",
          "updated_at_unix"
        ],
        "type": "object"
      },
      "UsergroupCoursesRequest": {
        "additionalProperties": false,
        "properties": {
          "course_ids": {
            "items": {
              "$ref": "#/components/schemas/CourseId"
            },
            "type": "array"
          }
        },
        "required": [
          "course_ids"
        ],
        "type": "object"
      },
      "UsergroupId": {
        "format": "uuid",
        "type": "string"
      },
      "UsergroupMember": {
        "properties": {
          "avatar_key": {
            "type": [
              "string",
              "null"
            ]
          },
          "display_name": {
            "type": "string"
          },
          "id": {
            "$ref": "#/components/schemas/UserId"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "display_name"
        ],
        "type": "object"
      },
      "UsergroupMembersRequest": {
        "additionalProperties": false,
        "properties": {
          "user_ids": {
            "items": {
              "$ref": "#/components/schemas/UserId"
            },
            "type": "array"
          }
        },
        "required": [
          "user_ids"
        ],
        "type": "object"
      },
      "UsergroupPage": {
        "description": "Keyset page (ARCHITECTURE §6): pass `next_cursor` back as `cursor`.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Usergroup"
            },
            "type": "array"
          },
          "next_cursor": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/UsergroupId"
              }
            ]
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "ViolationRequest": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "description": "e.g. `tab_switch`, `copy_paste`, `devtools`, `fullscreen_exit`.",
            "type": "string"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "ViolationState": {
        "properties": {
          "exceeded": {
            "description": "Submitting now zeroes the attempt.",
            "type": "boolean"
          },
          "threshold": {
            "format": "int32",
            "type": "integer"
          },
          "violation_count": {
            "format": "int32",
            "type": "integer"
          }
        },
        "required": [
          "violation_count",
          "threshold",
          "exceeded"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "University LMS / MOOC platform API (v2, Rust rewrite).",
    "license": {
      "name": ""
    },
    "title": "Ashyq Bilim API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v2/activities/{id}": {
      "delete": {
        "operationId": "delete_activity",
        "parameters": [
          {
            "description": "Activity id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ActivityId"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No write access"
          }
        },
        "summary": "Delete an activity; chapter siblings renumber to stay contiguous.",
        "tags": [
          "courses"
        ]
      },
      "get": {
        "operationId": "get_activity",
        "parameters": [
          {
            "description": "Activity id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ActivityId"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivityDetail"
                }
              }
            },
            "description": "Activity detail"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unknown or inaccessible"
          }
        },
        "summary": "Full activity including content/details/settings.",
        "tags": [
          "courses"
        ]
      },
      "patch": {
        "operationId": "update_activity",
        "parameters": [
          {
            "description": "Activity id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ActivityId"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateActivityRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivityDetail"
                }
              }
            },
            "description": "Updated"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No write access"
          }
        },
        "summary": "Partial update: name, publish state, content/details/settings, or the\ntype pair (both `activity_type` and `activity_sub_type` together).",
        "tags": [
          "courses"
        ]
      }
    },
    "/api/v2/activities/{id}/assessment": {
      "get": {
        "operationId": "get_activity_assessment",
        "parameters": [
          {
            "description": "Activity id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ActivityId"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssessmentDetail"
                }
              }
            },
            "description": "Assessment"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No assessment or inaccessible"
          }
        },
        "summary": "The assessment behind an activity (same access rules as by id).",
        "tags": [
          "assessments"
        ]
      }
    },
    "/api/v2/activities/{id}/blocks": {
      "get": {
        "operationId": "list_blocks",
        "parameters": [
          {
            "description": "Activity id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ActivityId"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Block"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Blocks"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unknown or inaccessible"
          }
        },
        "summary": "Blocks attached to an activity.",
        "tags": [
          "courses"
        ]
      },
      "post": {
        "operationId": "create_block",
        "parameters": [
          {
            "description": "Activity id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ActivityId"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBlockRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Block"
                }
              }
            },
            "description": "Created"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No write access / not your upload"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Upload not finalized"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Bad block type or wrong upload purpose"
          }
        },
        "summary": "Attach a file block to an activity by claiming a finalized upload whose\npurpose matches the block type (`image`→`block-image`, etc.).",
        "tags": [
          "courses"
        ]
      }
    },
    "/api/v2/activities/{id}/move": {
      "post": {
        "operationId": "move_activity",
        "parameters": [
          {
            "description": "Activity id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ActivityId"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MoveActivityRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Moved"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No write access"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Cross-course move"
          }
        },
        "summary": "Move an activity within its chapter, or to another chapter of the same\ncourse via `chapter_id`.",
        "tags": [
          "courses"
        ]
      }
    },
    "/api/v2/assessment-items/{id}": {
      "delete": {
        "operationId": "delete_item",
        "parameters": [
          {
            "description": "Item id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/AssessmentItemId"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Content locked"
          }
        },
        "summary": "Delete an item; siblings renumber.",
        "tags": [
          "assessments"
        ]
      },
      "patch": {
        "operationId": "update_item",
        "parameters": [
          {
            "description": "Item id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/AssessmentItemId"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateItemRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssessmentItem"
                }
              }
            },
            "description": "Updated"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Content locked"
          }
        },
        "summary": "Partial item update. Body/max-score changes are refused (409) once a\npublished assessment has graded submissions.",
        "tags": [
          "assessments"
        ]
      }
    },
    "/api/v2/assessment-items/{id}/runs": {
      "post": {
        "description": "Does not affect any grade — hidden tests only run at submit. Needs\nsubmit access to the assessment (authors may preview and see hidden\ndata). With an `Idempotency-Key`, a retry with the same source, input\nand language replays the finished run (200); a different payload under\nthe same key is 409. Limited to 20 runs per minute per user.",
        "operationId": "run_item",
        "parameters": [
          {
            "description": "Code item id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/AssessmentItemId"
            }
          },
          {
            "description": "Client retry token (optional)",
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CodeRun"
                }
              }
            },
            "description": "Replayed earlier run"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CodeRun"
                }
              }
            },
            "description": "Executed"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Idempotency-Key reused for a different run"
          },
          "413": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Source or input too large"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Blank source, wrong item kind, or language not allowed"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Too many runs"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Code runner unavailable (run recorded as degraded)"
          }
        },
        "summary": "Run code against an item's visible tests (or one custom input).",
        "tags": [
          "code"
        ]
      }
    },
    "/api/v2/assessments": {
      "post": {
        "description": "Requires `assessment:author` on the course (platform scope or course\ncreator with own scope). Code challenges start with one default code\nitem.",
        "operationId": "create_assessment",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAssessmentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssessmentDetail"
                }
              }
            },
            "description": "Created (draft)"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No authoring access"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Policy out of range"
          }
        },
        "summary": "Create an assessment with its backing activity (appended to the chapter).",
        "tags": [
          "assessments"
        ]
      }
    },
    "/api/v2/assessments/{id}": {
      "get": {
        "operationId": "get_assessment",
        "parameters": [
          {
            "description": "Assessment id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/AssessmentId"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssessmentDetail"
                }
              }
            },
            "description": "Assessment"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unknown or inaccessible"
          }
        },
        "summary": "Full assessment with items and policy. Authors always; learners only\nonce published (404 otherwise — no existence leak).",
        "tags": [
          "assessments"
        ]
      },
      "patch": {
        "operationId": "update_assessment",
        "parameters": [
          {
            "description": "Assessment id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/AssessmentId"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateAssessmentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssessmentDetail"
                }
              }
            },
            "description": "Updated"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Read-only in this state"
          }
        },
        "summary": "Title/description/weight/grading type. Archived assessments are\nread-only; a published one with submissions must be unpublished first.",
        "tags": [
          "assessments"
        ]
      }
    },
    "/api/v2/assessments/{id}/access": {
      "get": {
        "operationId": "get_access",
        "parameters": [
          {
            "description": "Assessment id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/AssessmentId"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessView"
                }
              }
            },
            "description": "Access policy"
          }
        },
        "summary": "Who may take the assessment (authors only).",
        "tags": [
          "assessments"
        ]
      },
      "put": {
        "operationId": "set_access",
        "parameters": [
          {
            "description": "Assessment id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/AssessmentId"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetAccessRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessView"
                }
              }
            },
            "description": "Updated"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "User/group outside the course"
          }
        },
        "summary": "Replace the access policy. Restricted lists are validated against the\ncourse (users need course access, groups must be linked); switching to\nall-course-learners wipes both lists.",
        "tags": [
          "assessments"
        ]
      }
    },
