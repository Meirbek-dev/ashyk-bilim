        "enum": [
          "learner",
          "teacher"
        ],
        "type": "string"
      },
      "WorkState": {
        "description": "Product-level work state shown to the learner.",
        "enum": [
          "not_started",
          "in_progress",
          "submitted",
          "needs_grading",
          "graded_hidden",
          "returned",
          "passed",
          "failed",
          "complete",
          "locked"
        ],
        "type": "string"
      },
      "WorkloadAgingBuckets": {
        "properties": {
          "d1_3": {
            "type": "integer"
          },
          "d3_7": {
            "type": "integer"
          },
          "d7_plus": {
            "type": "integer"
          },
          "h0_24": {
            "type": "integer"
          }
        },
        "required": [
          "h0_24",
          "d1_3",
          "d3_7",
          "d7_plus"
        ],
        "type": "object"
      },
      "XpAwarded": {
        "description": "XP granted to the recipient (S-13).",
        "properties": {
          "amount": {
            "format": "int32",
            "type": "integer"
          },
          "level": {
            "format": "int32",
            "type": "integer"
          },
          "reason": {
            "description": "Free-text reason (admin awards); null for automatic sources.",
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "$ref": "#/components/schemas/XpSource"
          },
          "total_xp": {
            "description": "The new total and level after this award.",
            "format": "int32",
            "type": "integer"
          },
          "transaction_id": {
            "$ref": "#/components/schemas/XpTransactionId"
          }
        },
        "required": [
          "transaction_id",
          "amount",
          "source",
          "total_xp",
          "level",
          "reason"
        ],
        "type": "object"
      },
      "XpHistoryPage": {
        "description": "One page of the caller's XP history, newest first.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Transaction"
            },
            "type": "array"
          },
          "next_cursor": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/XpTransactionId"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "items",
          "next_cursor"
        ],
        "type": "object"
      },
      "XpNotificationSettings": {
        "properties": {
          "xp_gain": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "xp_gain"
        ],
        "type": "object"
      },
      "XpSource": {
        "description": "Why XP was granted (legacy `XPSource`).",
        "enum": [
          "activity_completion",
          "course_completion",
          "login_bonus",
          "quiz_completion",
          "exam_completion",
          "streak_bonus",
          "admin_award",
          "code_challenge_completion",
          "code_challenge_perfect",
          "code_challenge_first_solve"
        ],
        "type": "string"
      },
      "XpTransactionId": {
        "format": "uuid",
        "type": "string"
      }
    }
  },
  "info": {
    "description": "University LMS / MOOC platform API (v2, Rust rewrite).",
    "license": {
      "name": ""
    },
    "title": "Ashyq Bilim API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v2/activities/{activity_id}": {
      "delete": {
        "operationId": "delete_activity",
        "parameters": [
          {
            "description": "Activity id",
            "in": "path",
            "name": "activity_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ActivityId"
            }
          },
          {
            "description": "Current version; stale → 412",
            "in": "header",
            "name": "If-Match",
            "required": false,
            "schema": {
              "format": "int32",
              "type": [
                "integer",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No write access"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unknown, inaccessible, or already deleted"
          },
          "412": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Stale version"
          }
        },
        "summary": "Delete an activity; chapter siblings renumber to stay contiguous.",
        "tags": [
          "courses"
        ]
      },
      "get": {
        "operationId": "get_activity",
        "parameters": [
          {
            "description": "Activity id",
            "in": "path",
            "name": "activity_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ActivityId"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivityDetail"
                }
              }
            },
            "description": "Activity detail",
            "headers": {
              "ETag": {
                "description": "Quoted version",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unknown or inaccessible"
          }
        },
        "summary": "Full activity including content/details/settings. Unpublished\nactivities exist for course editors only (404 otherwise).",
        "tags": [
          "courses"
        ]
      },
      "patch": {
        "description": "A `content` write (the editor autosave) requires `If-Match: \"<version>\"`;\nother fields honour it when sent. A stale version is 412\n`precondition-failed` with `details {expected, actual}` - never a silent\noverwrite of another tab's save.",
        "operationId": "update_activity",
        "parameters": [
          {
            "description": "Activity id",
            "in": "path",
            "name": "activity_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ActivityId"
            }
          },
          {
            "description": "Current version (required with `content`)",
            "in": "header",
            "name": "If-Match",
            "required": false,
            "schema": {
              "format": "int32",
              "type": [
                "integer",
                "null"
              ]
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateActivityRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivityDetail"
                }
              }
            },
            "description": "Updated",
            "headers": {
              "ETag": {
                "description": "Quoted new version",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No write access"
          },
          "412": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Stale version"
          }
        },
        "summary": "Partial update: name, publish state, content/details/settings, or the\ntype pair (both `activity_type` and `activity_sub_type` together).",
        "tags": [
          "courses"
        ]
      }
    },
    "/api/v2/activities/{activity_id}/assessment": {
      "get": {
        "operationId": "get_activity_assessment",
        "parameters": [
          {
            "description": "Activity id",
            "in": "path",
            "name": "activity_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ActivityId"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssessmentDetail"
                }
              }
            },
            "description": "Assessment"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No assessment or inaccessible"
          }
        },
        "summary": "The assessment behind an activity (same access rules as by id).",
        "tags": [
          "assessments"
        ]
      }
    },
    "/api/v2/activities/{activity_id}/blocks": {
      "get": {
        "operationId": "list_blocks",
        "parameters": [
          {
            "description": "Activity id",
            "in": "path",
            "name": "activity_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ActivityId"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Block"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Blocks"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unknown or inaccessible"
          }
        },
        "summary": "Blocks attached to an activity.",
        "tags": [
          "courses"
        ]
      },
      "post": {
        "operationId": "create_block",
        "parameters": [
          {
            "description": "Activity id",
            "in": "path",
            "name": "activity_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ActivityId"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBlockRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Block"
                }
              }
            },
            "description": "Created"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No write access / not your upload"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Upload not finalized"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Bad block type or wrong upload purpose"
          }
        },
        "summary": "Attach a file block to an activity by claiming a finalized upload whose\npurpose matches the block type (`image`→`block-image`, etc.).",
        "tags": [
          "courses"
        ]
      }
    },
    "/api/v2/activities/{activity_id}/file-submission": {
      "get": {
        "operationId": "get_activity_file_submission",
        "parameters": [
          {
            "description": "Activity id",
            "in": "path",
            "name": "activity_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ActivityId"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileSubmission"
                }
              }
            },
            "description": "File submission"
          }
        },
        "summary": "The file submission behind an activity.",
        "tags": [
          "file-submissions"
        ]
      }
    },
    "/api/v2/activities/{activity_id}/move": {
      "post": {
        "operationId": "move_activity",
        "parameters": [
          {
            "description": "Activity id",
            "in": "path",
            "name": "activity_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ActivityId"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MoveActivityRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Moved"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No write access"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Cross-course move"
          }
        },
        "summary": "Move an activity within its chapter, or to another chapter of the same\ncourse via `chapter_id`.",
        "tags": [
          "courses"
        ]
      }
    },
    "/api/v2/ai/admin/evals": {
      "get": {
        "operationId": "admin_evals",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvalDashboard"
                }
              }
            },
            "description": "Run aggregate + eval summary"
          }
        },
        "tags": [
          "ai"
        ]
      }
    },
    "/api/v2/ai/admin/runs": {
      "get": {
        "operationId": "admin_runs",
        "parameters": [
          {
            "description": "Look-back window, 1..=90 days (default 7).",
            "in": "query",
            "name": "days",
            "required": false,
            "schema": {
              "format": "int32",
              "type": [
                "integer",
                "null"
              ]
            }
          },
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/AiRunStatus"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          {
            "description": "Agent kind (legacy `feature`).",
            "in": "query",
            "name": "kind",
            "required": false,
            "schema": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/AiRunKind"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          {
            "description": "Case-insensitive substring of `model_name` (`openai`, `openrouter`).",
            "in": "query",
            "name": "provider",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "in": "query",
            "name": "course_id",
            "required": false,
            "schema": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/CourseId"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          {
            "description": "Keyset cursor: the last `id` of the previous page.",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/AiRunId"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          {
            "description": "1..=200 (default 50).",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminRunPage"
                }
              }
            },
            "description": "A page of runs"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not a platform reader"
          }
        },
        "summary": "Recent runs, newest first, keyset-paged.",
        "tags": [
          "ai"
        ]
      }
    },
    "/api/v2/ai/admin/runs/{run_id}": {
      "get": {
        "operationId": "admin_run_detail",
        "parameters": [
          {
            "description": "Run id",
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/AiRunId"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminRunDetail"
                }
              }
            },
            "description": "Run with events, artifacts and evidence"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unknown run"
          }
        },
        "tags": [
          "ai"
        ]
      }
    },
    "/api/v2/ai/admin/settings": {
      "get": {
        "operationId": "admin_settings",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminSettings"
                }
              }
            },
            "description": "Effective AI settings"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not a platform reader"
          }
        },
        "tags": [
          "ai"
        ]
      }
    },
    "/api/v2/ai/admin/settings/features/{key}": {
      "put": {
        "description": "Platform admins (`platform:update:platform`); audited as\n`ai-feature-switched`. `key` is a `features[].key` of the settings. The environment flag stays\nthe ceiling: a feature it disables stays off (`editable: false`).",
        "operationId": "set_feature_switch",
        "parameters": [
          {
            "description": "Feature flag key, e.g. `course_qa_enabled`",
            "in": "path",
            "name": "key",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FeatureSwitchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminSettings"
                }
              }
            },
            "description": "Effective AI settings after the change"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not a platform admin"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unknown feature key"
          }
        },
        "summary": "Turn one AI feature on or off at runtime, without a redeploy.",
        "tags": [
          "ai"
        ]
      }
    },
    "/api/v2/ai/capabilities/scope/{course_id}": {
      "get": {
        "operationId": "scope_capabilities",
        "parameters": [
          {
            "description": "Course id",
            "in": "path",
            "name": "course_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/CourseId"
            }
          },
          {
            "description": "Which client screen asks (default `course-page`).",
            "in": "query",
            "name": "surface",
            "required": false,
            "schema": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/Surface"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          {
            "in": "query",
            "name": "activity_id",
            "required": false,
            "schema": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/ActivityId"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScopeCapabilities"
                }
              }
            },
            "description": "Capabilities"
          }
        },
        "summary": "What the AI surface offers the caller in this course scope.",
        "tags": [
          "ai"
        ]
      }
    },
    "/api/v2/ai/course-analysis/{analysis_id}/findings/review": {
      "post": {
        "operationId": "review_course_finding",
        "parameters": [
          {
            "description": "Analysis id",
            "in": "path",
            "name": "analysis_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/AiCourseAnalysisId"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FindingReviewRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CourseAnalysis"
                }
              }
            },
            "description": "The updated analysis"
          }
        },
        "summary": "Record the teacher's verdict on one finding\n(`report.finding_reviews[finding_id]`).",
        "tags": [
          "ai"
        ]
      }
    },
    "/api/v2/ai/course-analysis/{analysis_id}/publish": {
      "post": {
        "operationId": "publish_course_analysis",
        "parameters": [
          {
            "description": "Analysis id",
            "in": "path",
            "name": "analysis_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/AiCourseAnalysisId"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CourseAnalysis"
                }
              }
            },
            "description": "The published analysis"
          }
        },
        "tags": [
          "ai"
        ]
      }
    },
    "/api/v2/ai/course-analysis/{course_id}/analyze": {
      "post": {
        "operationId": "analyze_course",
        "parameters": [
          {
            "description": "Course id",
            "in": "path",
            "name": "course_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/CourseId"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LanguageRequest"
              }
            }
          },
          "required": true
