    "/api/v2/health": {
      "get": {
        "operationId": "live",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Process is alive"
          }
        },
        "summary": "Liveness: the process is up.",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v2/health/ready": {
      "get": {
        "operationId": "ready",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Ready to serve traffic"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A dependency is unreachable"
          }
        },
        "summary": "Readiness: dependencies are reachable (Postgres; Redis/RustFS/Zitadel probes\njoin as their clients land).",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v2/rbac/roles": {
      "get": {
        "operationId": "list_roles",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Role"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Roles"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Missing permission"
          }
        },
        "summary": "All roles with their grants (requires `role:read:platform`).",
        "tags": [
          "rbac"
        ]
      }
    },
    "/api/v2/uploads": {
      "post": {
        "operationId": "create_upload",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUploadRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedUpload"
                }
              }
            },
            "description": "Presigned upload slot"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Missing permission"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Policy violation (size/mime/purpose)"
          }
        },
        "summary": "Start an upload: validates the purpose policy and returns a presigned PUT\n(requires `file:create:own`). Bytes go directly to storage, not this API.",
        "tags": [
          "uploads"
        ]
      }
    },
    "/api/v2/uploads/{id}/download": {
      "get": {
        "operationId": "download_upload",
        "parameters": [
          {
            "description": "Upload id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "303": {
            "description": "Redirect to the presigned URL"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unknown upload"
          }
        },
        "summary": "Redirect to a short-lived presigned download URL.",
        "tags": [
          "uploads"
        ]
      }
    },
    "/api/v2/uploads/{id}/finalize": {
      "post": {
        "operationId": "finalize_upload",
        "parameters": [
          {
            "description": "Upload id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FinalizedUpload"
                }
              }
            },
            "description": "Upload verified"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No object received / already finalized"
          }
        },
        "summary": "Finalize after the PUT: verifies the object exists and is within policy.",
        "tags": [
          "uploads"
        ]
      }
    },
    "/api/v2/users/me": {
      "get": {
        "operationId": "my_profile",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfile"
                }
              }
            },
            "description": "Own profile"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No live session"
          }
        },
        "summary": "The caller's own profile.",
        "tags": [
          "users"
        ]
      },
      "patch": {
        "operationId": "update_my_profile",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProfileRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfile"
                }
              }
            },
            "description": "Updated profile"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Missing permission"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Validation failed"
          }
        },
        "summary": "Update the caller's own profile (requires `user:update:own`).",
        "tags": [
          "users"
        ]
      }
    },
    "/api/v2/users/{user_id}/roles": {
      "post": {
        "operationId": "assign_role",
        "parameters": [
          {
            "description": "Target user",
            "in": "path",
            "name": "user_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/UserId"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssignRoleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Assigned"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Missing permission"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unknown user or role"
          }
        },
        "summary": "Assign a role to a user (requires `role:manage:platform`). Live sessions\nof the user pick the new grants up immediately.",
        "tags": [
          "rbac"
        ]
      }
    },
    "/api/v2/users/{user_id}/roles/{slug}": {
      "delete": {
        "operationId": "unassign_role",
        "parameters": [
          {
            "description": "Target user",
