                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unknown section or key, or a null value"
          }
        },
        "summary": "Merge preferences: a section absent from the patch is kept, `null`\nremoves it, an object replaces it. Unknown sections or keys are 422.",
        "tags": [
          "gamification"
        ]
      }
    },
    "/api/v2/gamification/rank": {
      "get": {
        "operationId": "rank",
