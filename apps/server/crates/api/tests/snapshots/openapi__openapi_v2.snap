          }
        },
        "summary": "Touch the login streak for today (same day keeps, next day extends, a\ngap resets). `learning` is 422: that streak is recorded by completing\nan activity.",
        "tags": [
          "gamification"
        ]
      }
    },
    "/api/v2/gamification/xp": {
      "post": {
        "operationId": "admin_award",
