                "$ref": "#/components/schemas/ViolationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ViolationState"
                }
              }
            },
            "description": "Recorded"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not a draft"
          }
        },
        "summary": "Report one anti-cheat event on the open draft.",
        "tags": [
          "submissions"
        ]
      }
    },
    "/api/v2/uploads": {
      "post": {
