---
source: crates/api/tests/openapi.rs
expression: json
---
{
  "components": {
    "schemas": {
      "ErrorCode": {
        "description": "Stable, closed set of machine-readable error codes.",
        "enum": [
          "internal",
          "not-found",
          "forbidden",
          "unauthenticated",
          "conflict",
          "validation-failed",
          "rate-limited",
          "payload-too-large",
          "service-unavailable",
          "invalid-credentials",
          "mfa-required",
          "session-expired"
        ],
        "type": "string"
      },
      "FieldError": {
        "description": "A single field-level validation failure. `code` is a stable machine key the\nfrontend translates (e.g. `required`, `too-long`); `message` is English.",
        "properties": {
          "code": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "field",
          "code",
          "message"
        ],
        "type": "object"
      },
      "Health": {
        "properties": {
          "status": {
            "description": "Always `\"ok\"` when the endpoint answers.",
            "type": "string"
          },
          "version": {
            "description": "Server crate version.",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ],
        "type": "object"
      },
      "Problem": {
        "description": "The wire shape of every error response.",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode",
            "description": "Stable machine code — the frontend's i18n key."
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "field_errors": {
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "type": "array"
          },
          "request_id": {
            "description": "Correlation id; also present as the `x-request-id` response header.",
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "description": "Stable documentation URI for this error class.",
            "type": "string"
          }
        },
        "required": [
          "type",
          "status",
          "code",
          "title"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "University LMS / MOOC platform API (v2, Rust rewrite).",
    "license": {
      "name": ""
    },
    "title": "Ashyq Bilim API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v2/health": {
      "get": {
        "operationId": "live",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Process is alive"
          }
        },
        "summary": "Liveness: the process is up.",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v2/health/ready": {
      "get": {
        "operationId": "ready",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Ready to serve traffic"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A dependency is unreachable"
          }
        },
        "summary": "Readiness: dependencies are reachable (Postgres; Redis/RustFS/Zitadel probes\njoin as their clients land).",
        "tags": [
          "health"
        ]
      }
    }
  },
  "tags": [
    {
      "description": "Liveness and readiness probes",
      "name": "health"
    }
  ]
}
