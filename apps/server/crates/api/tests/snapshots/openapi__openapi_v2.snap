            "description": "The actor's display name (`null`: the scheduler, or a deleted user).",
            "type": [
              "string",
              "null"
            ]
          },
          "created_at_unix": {
            "$ref": "#/components/schemas/UnixTime"
          },
          "event": {
            "$ref": "#/components/schemas/AuditEventKind"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "payload": {
            "$ref": "#/components/schemas/AuditPayload"
          }
        },
        "required": [
          "id",
          "event",
          "payload",
          "created_at_unix",
          "actor_id",
          "actor_name"
        ],
        "type": "object"
      },
      "AuditEventKind": {
        "description": "`assessment_audit_events.event`: what an audit row records (the writers\ntake this type, so the wire set is closed).",
        "enum": [
          "lifecycle-transition",
          "auto-publish-skipped",
          "duplicated-from",
          "access-changed",
          "override-created",
          "override-updated",
          "override-deleted",
          "deadline-extended",
          "deadline-extension-requested",
          "grade-saved",
          "grades-published",
          "submission-submitted"
        ],
        "type": "string"
      },
      "AuditPayload": {
        "description": "`assessment_audit_events.payload`.\n\nThe keys depend on `event`: `lifecycle-transition` (`from`, `to`, `scheduled_at`, `note`, `by`),\n`auto-publish-skipped` (`by`, `readiness`), `access-changed` (`mode`,\n`users`, `usergroups`), `override-created|updated|deleted` (`user_id`),\n`duplicated-from` (`source`), `deadline-extension-requested` /\n`deadline-extended` (`action_id`, `learners`, `new_due_at`),\n`submission-submitted` (`submission_id`, `attempt`, `status`,\n`auto_submit_reason`), `grade-saved` (`submission_id`, `learner_id`,\n`status`, `raw_score`, `final_score`, `audit_note`), `grades-published`\n(`published`, `already_published`).",
        "properties": {
          "action_id": {
            "format": "uuid",
            "type": "string"
          },
          "already_published": {
            "format": "int32",
            "type": "integer"
          },
          "attempt": {
            "format": "int32",
            "type": "integer"
          },
          "audit_note": {
            "type": [
              "string",
              "null"
            ]
          },
          "auto_submit_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "by": {
            "description": "`scheduler` for automatic transitions.",
            "type": "string"
          },
          "final_score": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "from": {
            "type": "string"
          },
          "learner_id": {
            "format": "uuid",
            "type": "string"
          },
          "learners": {
            "format": "int32",
            "type": "integer"
          },
          "mode": {
            "type": "string"
          },
          "new_due_at": {
            "description": "Unix seconds.",
            "type": "integer"
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "published": {
            "format": "int32",
            "type": "integer"
          },
          "raw_score": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "readiness": {
            "description": "Readiness codes that blocked an automatic publish.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "scheduled_at": {
            "description": "Unix seconds.",
            "type": [
              "integer",
              "null"
            ]
          },
          "source": {
            "description": "The assessment this one was duplicated from.",
            "format": "uuid",
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "submission_id": {
            "format": "uuid",
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "user_id": {
            "format": "uuid",
            "type": "string"
          },
          "usergroups": {
            "format": "int32",
            "type": "integer"
          },
          "users": {
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object",
        "x-stored-json": true
      },
      "AuditSource": {
        "enum": [
          "grading_entry",
          "bulk_action"
        ],
        "type": "string"
      },
      "AutoSubmitReason": {
        "enum": [
          "time_expired",
          "integrity_violation"
        ],
        "type": "string"
      },
      "AwardResponse": {
        "properties": {
          "is_new_transaction": {
            "type": "boolean"
          },
          "level_up_occurred": {
            "type": "boolean"
          },
          "previous_level": {
            "format": "int32",
            "type": "integer"
          },
          "profile": {
            "$ref": "#/components/schemas/Profile"
          },
          "transaction": {
            "$ref": "#/components/schemas/Transaction"
          }
        },
        "required": [
          "transaction",
          "profile",
          "level_up_occurred",
          "previous_level",
          "is_new_transaction"
        ],
        "type": "object"
      },
