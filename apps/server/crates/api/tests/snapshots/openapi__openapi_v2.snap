              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Role"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Roles"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Missing permission"
          }
        },
        "summary": "All roles with their grants (requires `role:read:platform`).",
        "tags": [
          "rbac"
        ]
      },
      "post": {
        "operationId": "create_role",
        "parameters": [
          {
            "description": "Retry-safe replay key",
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "description": "`return=representation`: answer 201 with the role instead of 204",
            "in": "header",
            "name": "Prefer",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRoleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Role"
                }
              }
            },
            "description": "Created (`Prefer: return=representation`)"
          },
          "204": {
            "description": "Created"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Missing permission"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "`role-slug-taken`"
          }
        },
        "summary": "Create a custom role (requires `role:manage:platform`).",
        "tags": [
          "rbac"
        ]
      }
    },
    "/api/v2/rbac/roles/{slug}": {
      "delete": {
        "operationId": "delete_role",
