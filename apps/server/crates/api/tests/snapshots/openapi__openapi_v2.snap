---
source: crates/api/tests/openapi.rs
expression: json
---
{
  "components": {
    "schemas": {
      "Activity": {
        "properties": {
          "activity_sub_type": {
            "type": "string"
          },
          "activity_type": {
            "type": "string"
          },
          "chapter_id": {
            "$ref": "#/components/schemas/ChapterId"
          },
          "course_id": {
            "$ref": "#/components/schemas/CourseId"
          },
          "id": {
            "$ref": "#/components/schemas/ActivityId"
          },
          "name": {
            "type": "string"
          },
          "position": {
            "description": "1-based, contiguous within the chapter.",
            "format": "int32",
            "type": "integer"
          },
          "published": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "chapter_id",
          "course_id",
          "name",
          "activity_type",
          "activity_sub_type",
          "published",
          "position"
        ],
        "type": "object"
      },
      "ActivityDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Activity"
          },
          {
            "properties": {
              "content": {
                "description": "Editor content (dynamic pages) or type-specific payload."
              },
              "details": {},
              "settings": {}
            },
            "required": [
              "content",
              "details",
              "settings"
            ],
            "type": "object"
          }
        ],
        "description": "Full activity view with the heavy jsonb columns."
      },
      "ActivityId": {
        "format": "uuid",
        "type": "string"
      },
      "AdminUser": {
        "description": "Admin listing row (includes email + status — platform:read gated).",
        "properties": {
          "created_at_unix": {
            "format": "int64",
            "type": "integer"
          },
          "display_name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "id": {
            "$ref": "#/components/schemas/UserId"
          },
          "roles": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "status": {
            "description": "`active` or `disabled`.",
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "email",
          "display_name",
          "status",
          "roles",
          "created_at_unix"
        ],
        "type": "object"
      },
      "AdminUserPage": {
        "description": "Keyset page (ARCHITECTURE §6): pass `next_cursor` back as `cursor`.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/AdminUser"
            },
            "type": "array"
          },
          "next_cursor": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/UserId"
              }
            ]
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "AssignRoleRequest": {
        "additionalProperties": false,
        "properties": {
          "role": {
            "description": "Role slug, e.g. `instructor`.",
            "type": "string"
          }
        },
        "required": [
          "role"
        ],
        "type": "object"
      },
      "Block": {
        "properties": {
          "activity_id": {
            "$ref": "#/components/schemas/ActivityId"
          },
          "block_type": {
            "description": "`image`, `pdf`, `video` (or `custom` for migrated legacy rows).",
            "type": "string"
          },
          "content": {
            "description": "`{upload_id, file_key, file_name, file_size, file_type}`."
          },
          "created_at_unix": {
            "format": "int64",
            "type": "integer"
          },
          "id": {
            "$ref": "#/components/schemas/BlockId"
          }
        },
        "required": [
          "id",
          "activity_id",
          "block_type",
          "content",
          "created_at_unix"
        ],
        "type": "object"
      },
      "BlockId": {
        "format": "uuid",
        "type": "string"
      },
      "Chapter": {
        "properties": {
          "course_id": {
            "$ref": "#/components/schemas/CourseId"
          },
          "description": {
            "type": "string"
          },
          "id": {
            "$ref": "#/components/schemas/ChapterId"
          },
          "name": {
            "type": "string"
          },
          "position": {
            "description": "1-based, contiguous within the course.",
            "format": "int32",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "course_id",
          "name",
          "description",
          "position"
        ],
        "type": "object"
      },
      "ChapterId": {
        "format": "uuid",
        "type": "string"
      },
      "Collection": {
        "properties": {
          "courses": {
            "description": "Member courses visible to the caller, in collection order.",
            "items": {
              "$ref": "#/components/schemas/Course"
            },
            "type": "array"
          },
          "created_at_unix": {
            "format": "int64",
            "type": "integer"
          },
          "creator_id": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/UserId"
              }
            ]
          },
          "description": {
            "type": "string"
          },
          "id": {
            "$ref": "#/components/schemas/CollectionId"
          },
          "name": {
            "type": "string"
          },
          "public": {
            "type": "boolean"
          },
          "updated_at_unix": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "public",
          "courses",
          "created_at_unix",
          "updated_at_unix"
        ],
        "type": "object"
      },
      "CollectionHit": {
        "description": "Collections in search results are light — no embedded courses.",
        "properties": {
          "description": {
            "type": "string"
          },
          "id": {
            "$ref": "#/components/schemas/CollectionId"
          },
          "name": {
            "type": "string"
          },
          "public": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "public"
        ],
        "type": "object"
      },
      "CollectionId": {
        "format": "uuid",
        "type": "string"
      },
      "CollectionPage": {
        "description": "Keyset page (ARCHITECTURE §6): pass `next_cursor` back as `cursor`.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Collection"
            },
            "type": "array"
          },
          "next_cursor": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/CollectionId"
              }
            ]
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "Course": {
        "properties": {
          "about": {
            "type": "string"
          },
          "created_at_unix": {
            "format": "int64",
            "type": "integer"
          },
          "creator_id": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/UserId"
              }
            ]
          },
          "description": {
            "type": "string"
          },
          "id": {
            "$ref": "#/components/schemas/CourseId"
          },
          "name": {
            "type": "string"
          },
          "open_to_contributors": {
            "type": "boolean"
          },
          "public": {
            "type": "boolean"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "updated_at_unix": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "about",
          "tags",
          "public",
          "open_to_contributors",
          "created_at_unix",
          "updated_at_unix"
        ],
        "type": "object"
      },
      "CourseId": {
        "format": "uuid",
        "type": "string"
      },
      "CourseLifecycleRequest": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "description": "`publish` or `unpublish`.",
            "type": "string"
          }
        },
        "required": [
          "action"
        ],
        "type": "object"
      },
      "CoursePage": {
        "description": "Keyset page (ARCHITECTURE §6): pass `next_cursor` back as `cursor`.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Course"
            },
            "type": "array"
          },
          "next_cursor": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/CourseId"
              }
            ]
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "CourseUpdate": {
        "description": "One announcement in the course changelog feed.",
        "properties": {
          "content": {
            "type": "string"
          },
          "course_id": {
            "$ref": "#/components/schemas/CourseId"
          },
          "created_at_unix": {
            "format": "int64",
            "type": "integer"
          },
          "id": {
            "$ref": "#/components/schemas/CourseUpdateId"
          },
          "title": {
            "type": "string"
          },
          "updated_at_unix": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "course_id",
          "title",
          "content",
          "created_at_unix",
          "updated_at_unix"
        ],
        "type": "object"
      },
      "CourseUpdateId": {
        "format": "uuid",
        "type": "string"
      },
      "CreateActivityRequest": {
        "additionalProperties": false,
        "properties": {
          "activity_sub_type": {
            "description": "Must pair with `activity_type` (e.g. `video_youtube`).",
            "type": "string"
          },
          "activity_type": {
            "description": "One of the closed activity-type set (e.g. `video`, `exam`).",
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "activity_type",
          "activity_sub_type"
        ],
        "type": "object"
      },
      "CreateBlockRequest": {
        "additionalProperties": false,
        "properties": {
          "block_type": {
            "description": "`image`, `pdf`, or `video`.",
            "type": "string"
          },
          "file_name": {
            "description": "Original client-side file name, for display.",
            "type": [
              "string",
              "null"
            ]
          },
          "upload_id": {
            "description": "A finalized upload (purpose must match the block type).",
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "block_type",
          "upload_id"
        ],
        "type": "object"
      },
      "CreateChapterRequest": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "CreateCollectionRequest": {
        "additionalProperties": false,
        "properties": {
          "courses": {
            "description": "Course membership; every course must be readable by the caller.",
            "items": {
              "$ref": "#/components/schemas/CourseId"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "public": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "CreateCourseRequest": {
        "additionalProperties": false,
        "properties": {
          "about": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "CreateCourseUpdateRequest": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "content"
        ],
        "type": "object"
      },
      "CreateRoleRequest": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "display_name": {
            "type": "string"
          },
          "priority": {
            "description": "Ordering weight (system roles: guest 0 … admin 100).",
            "format": "int32",
            "type": "integer"
          },
          "slug": {
            "description": "Kebab-case slug, e.g. `teaching-assistant`.",
            "type": "string"
          }
        },
        "required": [
          "slug",
          "display_name",
          "priority"
        ],
        "type": "object"
      },
      "CreateUploadRequest": {
        "additionalProperties": false,
        "properties": {
          "mime": {
            "type": "string"
          },
          "purpose": {
            "description": "One of: avatar, course-thumbnail, block-image, block-pdf, block-video,\nfile-submission.",
            "type": "string"
          },
          "size_bytes": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "purpose",
          "mime",
          "size_bytes"
        ],
        "type": "object"
      },
      "CreatedUpload": {
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "put_url": {
            "description": "PUT the file bytes here (presigned; valid for ~15 minutes).",
            "type": "string"
          }
        },
        "required": [
          "id",
          "key",
          "put_url"
        ],
        "type": "object"
      },
      "Curriculum": {
        "properties": {
          "chapters": {
            "items": {
              "$ref": "#/components/schemas/CurriculumChapter"
            },
            "type": "array"
          }
        },
        "required": [
          "chapters"
        ],
        "type": "object"
      },
      "CurriculumChapter": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Chapter"
          },
          {
            "properties": {
              "activities": {
                "items": {
                  "$ref": "#/components/schemas/Activity"
                },
                "type": "array"
              }
            },
            "required": [
              "activities"
            ],
            "type": "object"
          }
        ],
        "description": "A chapter with its activities, in curriculum order."
      },
      "EditCourseUpdateRequest": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "ErrorCode": {
        "description": "Stable, closed set of machine-readable error codes.",
        "enum": [
          "internal",
          "not-found",
          "forbidden",
          "unauthenticated",
          "conflict",
          "validation-failed",
          "rate-limited",
          "payload-too-large",
          "service-unavailable",
          "invalid-credentials",
          "mfa-required",
          "session-expired",
          "csrf-rejected",
          "account-disabled",
          "google-oauth-expired",
          "invalid-totp-code"
        ],
        "type": "string"
      },
      "FieldError": {
        "description": "A single field-level validation failure. `code` is a stable machine key the\nfrontend translates (e.g. `required`, `too-long`); `message` is English.",
        "properties": {
          "code": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "field",
          "code",
          "message"
        ],
        "type": "object"
      },
      "FinalizedUpload": {
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "size_bytes": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "key",
          "size_bytes"
        ],
        "type": "object"
      },
      "Health": {
        "properties": {
          "status": {
            "description": "Always `\"ok\"` when the endpoint answers.",
            "type": "string"
          },
          "version": {
            "description": "Server crate version.",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ],
        "type": "object"
      },
      "LoginRequest": {
        "additionalProperties": false,
        "description": "Password login. No `Debug` derive — the password must never format.",
        "properties": {
          "login": {
            "description": "Username or email.",
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "totp_code": {
            "description": "Second factor — resubmit after a 401 `mfa-required`.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "login",
          "password"
        ],
        "type": "object"
      },
      "MoveActivityRequest": {
        "additionalProperties": false,
        "description": "Target slot for an activity move; `chapter_id` reparents within the same\ncourse, omitted keeps the current chapter.",
        "properties": {
          "chapter_id": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ChapterId"
              }
            ]
          },
          "position": {
            "description": "1-based target position (in the destination chapter).",
            "format": "int32",
            "type": "integer"
          }
        },
        "required": [
          "position"
        ],
        "type": "object"
      },
      "MoveChapterRequest": {
        "additionalProperties": false,
        "description": "Target slot for a chapter move; out-of-range positions clamp.",
        "properties": {
          "position": {
            "description": "1-based target position.",
            "format": "int32",
            "type": "integer"
          }
        },
        "required": [
          "position"
        ],
        "type": "object"
      },
      "Platform": {
        "properties": {
          "about": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          },
          "logo_key": {
            "description": "Public-bucket storage keys (served via the CDN /content route).",
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "thumbnail_key": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name",
          "description",
          "about",
          "email"
        ],
        "type": "object"
      },
      "Problem": {
        "description": "The wire shape of every error response.",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode",
            "description": "Stable machine code — the frontend's i18n key."
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "field_errors": {
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "type": "array"
          },
          "request_id": {
            "description": "Correlation id; also present as the `x-request-id` response header.",
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "description": "Stable documentation URI for this error class.",
            "type": "string"
          }
        },
        "required": [
          "type",
          "status",
          "code",
          "title"
        ],
        "type": "object"
      },
      "Role": {
        "properties": {
          "description_key": {
            "type": "string"
          },
          "display_name_key": {
            "description": "i18n key (frontend catalogs own the display strings).",
            "type": "string"
          },
          "is_system": {
            "type": "boolean"
          },
          "permissions": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "priority": {
            "format": "int32",
            "type": "integer"
          },
          "slug": {
            "type": "string"
          }
        },
        "required": [
          "slug",
          "display_name_key",
          "description_key",
          "priority",
          "is_system",
          "permissions"
        ],
        "type": "object"
      },
      "SearchResults": {
        "properties": {
          "collections": {
            "items": {
              "$ref": "#/components/schemas/CollectionHit"
            },
            "type": "array"
          },
          "courses": {
            "items": {
              "$ref": "#/components/schemas/Course"
            },
            "type": "array"
          },
          "users": {
            "description": "Empty for anonymous callers.",
            "items": {
              "$ref": "#/components/schemas/UserHit"
            },
            "type": "array"
          }
        },
        "required": [
          "courses",
          "collections",
          "users"
        ],
        "type": "object"
      },
      "SessionInfo": {
        "description": "The current session, as the frontend sees it (client-side permission\ngating mirrors the legacy `Session` contract).",
        "properties": {
          "permissions": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "roles": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "user_id": {
            "$ref": "#/components/schemas/UserId"
          }
        },
        "required": [
          "user_id",
          "roles",
          "permissions"
        ],
        "type": "object"
      },
      "SessionSummary": {
        "description": "One of the caller's live sessions. `handle` is a non-bearer identifier\n(raw session ids never leave the server).",
        "properties": {
          "created_at_unix": {
            "format": "int64",
            "type": "integer"
          },
          "current": {
            "type": "boolean"
          },
          "handle": {
            "type": "string"
          },
          "ip": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_seen_unix": {
            "format": "int64",
            "type": "integer"
          },
          "user_agent": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "handle",
          "current",
          "created_at_unix",
          "last_seen_unix"
        ],
        "type": "object"
      },
      "SetRolePermissionsRequest": {
        "additionalProperties": false,
        "properties": {
          "permissions": {
            "description": "Full replacement grant set; every entry must parse against the\npermission registry (`resource:action[:scope]`).",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "permissions"
        ],
        "type": "object"
      },
      "SetUserStatusRequest": {
        "additionalProperties": false,
        "properties": {
          "disabled": {
            "description": "`true` disables the account and revokes every live session.",
            "type": "boolean"
          }
        },
        "required": [
          "disabled"
        ],
        "type": "object"
      },
      "TotpEnrollment": {
        "description": "TOTP enrollment secrets — shown to the user exactly once.",
        "properties": {
          "secret": {
            "description": "Base32 secret for manual entry.",
            "type": "string"
          },
          "uri": {
            "description": "`otpauth://` URI for QR rendering.",
            "type": "string"
          }
        },
        "required": [
          "uri",
          "secret"
        ],
        "type": "object"
      },
      "TotpVerifyRequest": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "type": "object"
      },
      "UpdateActivityRequest": {
        "additionalProperties": false,
        "properties": {
          "activity_sub_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "activity_type": {
            "description": "Change together with `activity_sub_type` (both or neither).",
            "type": [
              "string",
              "null"
            ]
          },
          "content": {},
          "details": {},
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "published": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "settings": {}
        },
        "type": "object"
      },
      "UpdateChapterRequest": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "UpdateCollectionRequest": {
        "additionalProperties": false,
        "properties": {
          "courses": {
            "description": "Replaces the whole membership when present (legacy semantics).",
            "items": {
              "$ref": "#/components/schemas/CourseId"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "public": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "UpdateCourseRequest": {
        "additionalProperties": false,
        "properties": {
          "about": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "open_to_contributors": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "UpdatePlatformRequest": {
        "additionalProperties": false,
        "properties": {
          "about": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          },
          "logo_upload_id": {
            "description": "Finalized `platform-logo` upload to claim as the new logo.",
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "thumbnail_upload_id": {
            "description": "Finalized `platform-thumbnail` upload to claim.",
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "UpdateProfileRequest": {
        "additionalProperties": false,
        "description": "Partial update; omitted fields are unchanged.",
        "properties": {
          "avatar_upload_id": {
            "description": "Finalized `avatar` upload to claim as the new avatar.",
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          },
          "bio": {
            "type": [
              "string",
              "null"
            ]
          },
          "display_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "locale": {
            "description": "One of the platform locales.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "UpdateRoleRequest": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "display_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "priority": {
            "format": "int32",
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "UserHit": {
        "description": "Public-profile projection (no email — FINDINGS #16).",
        "properties": {
          "avatar_key": {
            "type": [
              "string",
              "null"
            ]
          },
          "display_name": {
            "type": "string"
          },
          "id": {
            "$ref": "#/components/schemas/UserId"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "display_name"
        ],
        "type": "object"
      },
      "UserId": {
        "format": "uuid",
        "type": "string"
      },
      "UserProfile": {
        "properties": {
          "avatar_key": {
            "type": [
              "string",
              "null"
            ]
          },
          "bio": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "id": {
            "$ref": "#/components/schemas/UserId"
          },
          "locale": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "email",
          "display_name",
          "bio",
          "locale"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "University LMS / MOOC platform API (v2, Rust rewrite).",
    "license": {
      "name": ""
    },
    "title": "Ashyq Bilim API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v2/activities/{id}": {
      "delete": {
        "operationId": "delete_activity",
        "parameters": [
          {
            "description": "Activity id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ActivityId"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No write access"
          }
        },
        "summary": "Delete an activity; chapter siblings renumber to stay contiguous.",
        "tags": [
          "courses"
        ]
      },
      "get": {
        "operationId": "get_activity",
        "parameters": [
          {
            "description": "Activity id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ActivityId"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivityDetail"
                }
              }
            },
            "description": "Activity detail"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unknown or inaccessible"
          }
        },
        "summary": "Full activity including content/details/settings.",
        "tags": [
          "courses"
        ]
      },
      "patch": {
        "operationId": "update_activity",
        "parameters": [
          {
            "description": "Activity id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ActivityId"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateActivityRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivityDetail"
                }
              }
            },
            "description": "Updated"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No write access"
          }
        },
        "summary": "Partial update: name, publish state, content/details/settings, or the\ntype pair (both `activity_type` and `activity_sub_type` together).",
        "tags": [
          "courses"
        ]
      }
    },
    "/api/v2/activities/{id}/blocks": {
      "get": {
        "operationId": "list_blocks",
        "parameters": [
          {
            "description": "Activity id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ActivityId"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Block"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Blocks"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unknown or inaccessible"
          }
        },
        "summary": "Blocks attached to an activity.",
        "tags": [
          "courses"
        ]
      },
      "post": {
        "operationId": "create_block",
        "parameters": [
          {
            "description": "Activity id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ActivityId"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBlockRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Block"
                }
              }
            },
            "description": "Created"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No write access / not your upload"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Upload not finalized"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Bad block type or wrong upload purpose"
          }
        },
        "summary": "Attach a file block to an activity by claiming a finalized upload whose\npurpose matches the block type (`image`→`block-image`, etc.).",
        "tags": [
          "courses"
        ]
      }
    },
    "/api/v2/activities/{id}/move": {
      "post": {
        "operationId": "move_activity",
        "parameters": [
          {
            "description": "Activity id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ActivityId"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MoveActivityRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Moved"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No write access"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Cross-course move"
          }
        },
        "summary": "Move an activity within its chapter, or to another chapter of the same\ncourse via `chapter_id`.",
        "tags": [
          "courses"
        ]
      }
    },
    "/api/v2/auth/google": {
      "get": {
        "operationId": "google_start",
        "parameters": [
          {
            "description": "Relative return path",
            "in": "query",
            "name": "callback",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "303": {
            "description": "Redirect to Google"
          }
        },
        "summary": "Start Google sign-in: 303 to Google's consent screen.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v2/auth/google/callback": {
      "get": {
        "operationId": "google_callback",
        "parameters": [
          {
            "description": "Authorization code",
            "in": "query",
            "name": "code",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Opaque state",
            "in": "query",
            "name": "state",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Google-side error",
            "in": "query",
            "name": "error",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "303": {
            "description": "Redirect into the app (or to login with ?error=)"
          }
        },
        "summary": "Google redirects here; on success the session cookie is set and the\nbrowser continues to the original callback path.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v2/auth/login": {
      "post": {
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionInfo"
                }
              }
            },
            "description": "Logged in; session cookie set"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Invalid credentials"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Account disabled"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Too many attempts"
          }
        },
        "summary": "Password login (headless Zitadel session check behind the BFF).",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v2/auth/logout": {
      "post": {
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Session terminated, cookie cleared"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No live session"
          }
        },
        "summary": "Logout: revoke the current session and clear the cookie. Idempotent.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v2/auth/mfa/totp": {
      "delete": {
        "operationId": "totp_remove",
        "responses": {
          "204": {
            "description": "Removed (idempotent)"
          }
        },
        "summary": "Remove the TOTP authenticator.",
        "tags": [
          "auth"
        ]
      },
      "post": {
        "operationId": "totp_enroll",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TotpEnrollment"
                }
              }
            },
            "description": "Enrollment secrets"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Already enrolled"
          }
        },
        "summary": "Start TOTP enrollment (secrets are returned exactly once).",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v2/auth/mfa/totp/verify": {
      "post": {
        "operationId": "totp_verify",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TotpVerifyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "TOTP active"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Invalid code"
          }
        },
        "summary": "Activate TOTP with the first code from the authenticator app.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v2/auth/session": {
      "get": {
        "operationId": "current_session",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionInfo"
                }
              }
            },
            "description": "Current session"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No live session"
          }
        },
        "summary": "The caller's current session (also the cheapest \"am I logged in?\" probe).",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v2/auth/sessions": {
      "get": {
        "operationId": "list_sessions",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SessionSummary"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Live sessions"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No live session"
          }
        },
        "summary": "All live sessions of the caller (handles are non-bearer identifiers).",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v2/auth/sessions/{handle}": {
      "delete": {
        "operationId": "revoke_session",
        "parameters": [
          {
            "description": "Session handle from the listing",
            "in": "path",
            "name": "handle",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Revoked"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No such session"
          }
        },
        "summary": "Revoke one of the caller's own sessions by handle.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v2/blocks/{id}": {
      "delete": {
        "operationId": "delete_block",
        "parameters": [
          {
            "description": "Block id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/BlockId"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No write access"
          }
        },
        "summary": "Delete a block and release its stored file for reaping.",
        "tags": [
          "courses"
        ]
      },
      "get": {
        "operationId": "get_block",
        "parameters": [
          {
            "description": "Block id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/BlockId"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Block"
                }
              }
            },
            "description": "Block"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unknown or inaccessible"
          }
        },
        "summary": "One block (visibility follows the course).",
        "tags": [
          "courses"
        ]
      }
    },
    "/api/v2/chapters/{id}": {
      "delete": {
        "operationId": "delete_chapter",
        "parameters": [
          {
            "description": "Chapter id",
            "in": "path",
