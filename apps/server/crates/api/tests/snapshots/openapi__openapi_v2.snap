          "ACCESS_RESTRICTED"
        ],
        "type": "string"
      },
      "Discussion": {
        "properties": {
          "allowed_actions": {
            "description": "What the caller may do to this post now (supersedes the `can_*` flags).",
            "items": {
              "$ref": "#/components/schemas/DiscussionAction"
            },
            "type": "array"
          },
          "author": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/DiscussionAuthor"
              },
              {
                "type": "null"
              }
            ]
          },
          "can_delete": {
            "type": "boolean"
          },
          "can_moderate": {
            "type": "boolean"
          },
          "can_update": {
            "type": "boolean"
          },
          "content": {
            "type": "string"
          },
          "course_id": {
            "$ref": "#/components/schemas/CourseId"
          },
          "created_at_unix": {
            "$ref": "#/components/schemas/UnixTime"
          },
          "dislikes_count": {
            "format": "int32",
            "type": "integer"
          },
          "id": {
            "$ref": "#/components/schemas/DiscussionId"
          },
          "is_disliked": {
            "type": "boolean"
          },
          "is_liked": {
            "type": "boolean"
          },
          "is_owner": {
            "type": "boolean"
          },
          "likes_count": {
            "format": "int32",
            "type": "integer"
          },
          "parent_id": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/DiscussionId",
                "description": "`null` for a top-level post."
              },
              {
                "type": "null"
              }
            ]
          },
          "parent_replies_count": {
            "description": "On a reply-create response only: the parent's `replies_count` after\nthis reply (no list re-read needed); `null` everywhere else.",
            "format": "int32",
            "type": [
              "integer",
              "null"
            ]
          },
          "replies": {
            "description": "Embedded when the list was asked for `include_replies` (replies\ncarry an empty list - one level only).",
            "items": {
              "$ref": "#/components/schemas/Discussion"
            },
            "type": "array"
          },
          "replies_count": {
            "format": "int32",
            "type": "integer"
          },
          "status": {
            "$ref": "#/components/schemas/DiscussionStatus"
          },
          "updated_at_unix": {
            "$ref": "#/components/schemas/UnixTime"
          },
          "version": {
            "description": "Send back as `If-Match` on delete (stale -> 412). Likes do not move it.\nAlways present (schema-optional while client fixtures catch up).",
            "format": "int32",
            "type": "integer"
          }
        },
