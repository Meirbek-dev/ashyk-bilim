            "required": true,
            "schema": {
              "$ref": "#/components/schemas/AssessmentId"
            }
          },
          {
            "description": "Assessment `version`; stale → 412 (without it nothing changes)",
            "in": "header",
            "name": "If-Match",
            "required": false,
            "schema": {
              "format": "int32",
              "type": [
                "integer",
