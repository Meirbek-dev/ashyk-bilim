    "/api/v2/ai/runs/{run_id}/stream": {
      "post": {
        "description": "`RUN_STARTED`, one `CUSTOM {name: <event_type>, value: {state, message,\npayload}}` per run event, then `RUN_FINISHED` or `RUN_ERROR {code}`.\n`id:` is the Redis stream id to resume from with `Last-Event-ID`.",
        "operationId": "stream_run",
        "parameters": [
          {
            "description": "Run id",
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/AiRunId"
            }
          },
          {
            "description": "Resume after this event id",
            "in": "header",
            "name": "Last-Event-ID",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunStreamRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/RunStreamEvent"
                }
              }
            },
            "description": "Event stream: each message's `data` is one AG-UI event"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unknown or inaccessible run"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Too many open streams for this user"
          }
        },
        "summary": "Follow a run as AG-UI events (`event: run`).",
        "tags": [
          "ai"
        ]
      }
    },
    "/api/v2/ai/study/{course_id}/ask": {
