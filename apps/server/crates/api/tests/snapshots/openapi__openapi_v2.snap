                  "$ref": "#/components/schemas/DrillThroughResponse"
                }
              }
            },
            "description": "Rows"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
