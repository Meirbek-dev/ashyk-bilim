    "/api/v2/analytics/admin/overview": {
      "get": {
        "operationId": "admin_overview",
        "parameters": [
          {
            "description": "`7d`, `28d` (default) or `90d`.",
            "in": "query",
            "name": "window",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Window"
            }
          },
          {
            "description": "`previous_period` (default) or `none`.",
            "in": "query",
            "name": "compare",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Compare"
            }
          },
          {
            "description": "`day` (default) or `week`.",
            "in": "query",
            "name": "bucket",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Bucket"
            }
          },
          {
            "description": "Narrow to one bucket: RFC 3339 timestamp or epoch seconds.",
            "in": "query",
            "name": "bucket_start",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Comma-separated course ids (must be inside the caller's scope).",
            "in": "query",
            "name": "course_ids",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Comma-separated usergroup ids.",
            "in": "query",
            "name": "cohort_ids",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Inspect another teacher (platform scope only).",
            "in": "query",
            "name": "teacher_user_id",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "IANA zone for calendar bucketing (default UTC).",
            "in": "query",
            "name": "timezone",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "1-based (default 1).",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "description": "1..=200 (default 25).",
            "in": "query",
            "name": "page_size",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "sort_by",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "`asc` or `desc` (default).",
            "in": "query",
            "name": "sort_order",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/SortOrder"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminAnalyticsResponse"
                }
              }
            },
            "description": "Admin overview"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No platform analytics grant"
          }
        },
        "summary": "Platform-wide overview (`analytics:read:platform` / `:all`).",
        "tags": [
          "analytics"
        ]
      }
    },
