      "PublishSummary": {
        "properties": {
          "already_published_count": {
            "type": "integer"
          },
          "needs_grading_count": {
            "description": "Rows held back: `pending` attempts plus graded ones whose manual\nitem is still unscored (BUG-197 / BUG-202) - the same count as\n`stats.needs_grading`.",
            "type": "integer"
          },
          "published_count": {
            "type": "integer"
          },
          "skipped_count": {
            "description": "Rows a grade save or return changed while the release ran (BUG-226\nversion guard) - left as they are; run the release again for them -\nand the caller's own attempts, never theirs to release (BUG-288).",
            "type": "integer"
          }
        },
        "required": [
          "published_count",
          "already_published_count",
          "needs_grading_count",
          "skipped_count"
        ],
        "type": "object"
      },
      "QaChatEvent": {
        "description": "`POST /ai/qa/{course_id}/chat`: one AG-UI event.",
        "oneOf": [
          {
            "properties": {
              "runId": {
                "type": "string"
              },
              "threadId": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "RUN_STARTED"
                ],
                "type": "string"
              }
            },
            "required": [
              "threadId",
              "runId",
              "type"
            ],
            "type": "object"
          },
          {
            "properties": {
              "messageId": {
                "type": "string"
              },
              "role": {
                "$ref": "#/components/schemas/AgUiAssistantRole"
              },
              "type": {
                "enum": [
                  "TEXT_MESSAGE_START"
                ],
                "type": "string"
              }
            },
            "required": [
              "messageId",
              "role",
              "type"
            ],
            "type": "object"
          },
          {
            "properties": {
              "delta": {
                "type": "string"
              },
              "messageId": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "TEXT_MESSAGE_CONTENT"
                ],
                "type": "string"
              }
            },
            "required": [
              "messageId",
              "delta",
              "type"
            ],
            "type": "object"
          },
          {
            "properties": {
              "messageId": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "TEXT_MESSAGE_END"
                ],
                "type": "string"
              }
            },
            "required": [
              "messageId",
              "type"
            ],
            "type": "object"
          },
          {
            "description": "The answer's citations arrive as one `course_citations` tool call.",
            "properties": {
              "parentMessageId": {
                "type": "string"
              },
              "toolCallId": {
                "type": "string"
              },
              "toolCallName": {
                "$ref": "#/components/schemas/AgUiToolName"
              },
              "type": {
                "enum": [
                  "TOOL_CALL_START"
                ],
                "type": "string"
              }
            },
            "required": [
              "toolCallId",
              "toolCallName",
              "parentMessageId",
              "type"
            ],
            "type": "object"
          },
          {
            "description": "`content` is a JSON string: [`QaCitationsContent`].",
            "properties": {
              "content": {
                "type": "string"
              },
              "messageId": {
                "type": "string"
              },
              "toolCallId": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "TOOL_CALL_RESULT"
                ],
                "type": "string"
              }
            },
            "required": [
              "messageId",
              "toolCallId",
              "content",
              "type"
            ],
            "type": "object"
          },
          {
            "properties": {
              "toolCallId": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "TOOL_CALL_END"
                ],
                "type": "string"
              }
            },
            "required": [
              "toolCallId",
              "type"
            ],
            "type": "object"
          },
          {
            "properties": {
              "result": {
                "$ref": "#/components/schemas/QaRunResult"
              },
              "runId": {
                "type": "string"
              },
              "threadId": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "RUN_FINISHED"
                ],
                "type": "string"
              }
            },
            "required": [
              "threadId",
              "runId",
              "result",
              "type"
            ],
            "type": "object"
          },
          {
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "RUN_ERROR"
                ],
                "type": "string"
              }
            },
            "required": [
              "message",
              "code",
              "type"
            ],
            "type": "object"
          }
        ]
      },
      "QaChatRequest": {
        "additionalProperties": false,
        "description": "AG-UI `RunAgentInput` for `POST /ai/qa/{course}/chat`.",
        "properties": {
          "context": {
            "items": {
              "$ref": "#/components/schemas/AgUiContext"
            },
            "type": "array"
          },
          "forwardedProps": {
            "$ref": "#/components/schemas/QaForwardedProps"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/QaWireMessage"
            },
            "type": "array"
          },
          "parentRunId": {
            "maxLength": 200,
            "type": "string"
          },
          "protocolVersion": {
            "description": "AG-UI 1.0 (`\"1.0\"`); absent from pre-1.0 clients.",
            "maxLength": 32,
            "type": "string"
          },
          "resume": {
            "description": "AG-UI 1.0 interrupt answers; no agent here interrupts, so ignored.",
            "items": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "type": "array"
          },
          "runId": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/JsonValue"
          },
          "threadId": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "tools": {
            "description": "AG-UI protocol fields the client always sends; accepted and ignored.",
            "items": {
              "$ref": "#/components/schemas/AgUiTool"
            },
            "type": "array"
          }
        },
        "required": [
          "threadId",
          "runId"
        ],
        "type": "object"
      },
      "QaCitationsContent": {
        "description": "The parsed `content` of the `course_citations` tool result.",
        "properties": {
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "type": "array"
          }
        },
        "required": [
          "citations"
        ],
        "type": "object"
      },
      "QaForwardedProps": {
        "additionalProperties": false,
        "description": "What this API reads from AG-UI `forwardedProps`.",
        "properties": {
          "activity_id": {
            "$ref": "#/components/schemas/ActivityId",
            "description": "Narrow the context to one activity of the course."
          },
          "client_turn_id": {
            "description": "Client turn id: a retry with the same id replays the stored answer.",
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "thread_id": {
            "$ref": "#/components/schemas/AiThreadId",
            "description": "Continue an existing thread of the caller in this course."
          }
        },
        "type": "object"
      },
      "QaMessage": {
        "properties": {
          "citations": {
            "$ref": "#/components/schemas/AiEvidence"
          },
          "client_turn_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "type": [
              "string",
              "null"
            ]
          },
          "content": {
            "type": "string"
          },
          "course_id": {
            "$ref": "#/components/schemas/CourseId"
          },
          "created_at_unix": {
            "$ref": "#/components/schemas/UnixTime"
          },
          "id": {
            "$ref": "#/components/schemas/AiMessageId"
          },
          "metadata": {
            "$ref": "#/components/schemas/QaMessageMetadata"
          },
          "role": {
            "$ref": "#/components/schemas/QaMessageRole"
          },
          "thread_id": {
            "$ref": "#/components/schemas/AiThreadId"
          },
          "user_id": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/UserId"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "thread_id",
          "course_id",
          "role",
          "content",
          "citations",
          "metadata",
          "created_at_unix",
          "client_turn_id",
          "confidence",
          "user_id"
        ],
        "type": "object"
      },
      "QaMessageMetadata": {
        "description": "`ai_qa_messages.metadata`: `{}` on questions; answers carry the model\nand the question they reply to; `incomplete` marks a partial answer\nsaved when the stream was cut.",
        "properties": {
          "incomplete": {
            "type": "boolean"
          },
          "model_name": {
            "type": "string"
          },
          "out_of_scope": {
            "type": "boolean"
          },
          "reply_to_message_id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "type": "object"
      },
      "QaMessageRole": {
        "description": "Q&A message author.",
        "enum": [
          "user",
          "assistant"
        ],
        "type": "string"
      },
      "QaRunResult": {
        "description": "`RUN_FINISHED.result` of the Q&A chat. A replayed turn\n(`client_turn_id` seen before) carries `replayed: true` and no\nconfidence or suggestions.",
        "properties": {
          "confidence": {
            "$ref": "#/components/schemas/Level"
          },
          "follow_up_suggestions": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "message_id": {
            "$ref": "#/components/schemas/AiMessageId"
          },
          "replayed": {
            "type": "boolean"
          },
          "thread_id": {
            "$ref": "#/components/schemas/AiThreadId"
          }
        },
        "required": [
          "thread_id",
          "message_id"
        ],
        "type": "object"
      },
      "QaThreadSummary": {
        "properties": {
          "id": {
            "$ref": "#/components/schemas/AiThreadId"
          },
          "last_message_preview": {
            "type": "string"
          },
          "message_count": {
            "type": "integer"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "updated_at_unix": {
            "$ref": "#/components/schemas/UnixTime"
          }
        },
        "required": [
          "id",
          "last_message_preview",
          "message_count",
          "updated_at_unix",
          "title"
        ],
        "type": "object"
      },
      "QaWireMessage": {
        "additionalProperties": false,
        "description": "One message of the AG-UI conversation the client sends back.",
        "properties": {
          "content": {
            "maxLength": 20000,
