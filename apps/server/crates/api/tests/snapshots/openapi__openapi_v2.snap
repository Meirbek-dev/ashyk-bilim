---
source: crates/api/tests/openapi.rs
expression: json
---
{
  "components": {
    "schemas": {
      "AssignRoleRequest": {
        "additionalProperties": false,
        "properties": {
          "role": {
            "description": "Role slug, e.g. `instructor`.",
            "type": "string"
          }
        },
        "required": [
          "role"
        ],
        "type": "object"
      },
      "Course": {
        "properties": {
          "about": {
            "type": "string"
          },
          "created_at_unix": {
            "format": "int64",
            "type": "integer"
          },
          "creator_id": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/UserId"
              }
            ]
          },
          "description": {
            "type": "string"
          },
          "id": {
            "$ref": "#/components/schemas/CourseId"
          },
          "name": {
            "type": "string"
          },
          "open_to_contributors": {
            "type": "boolean"
          },
          "public": {
            "type": "boolean"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "updated_at_unix": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "about",
          "tags",
          "public",
          "open_to_contributors",
          "created_at_unix",
          "updated_at_unix"
        ],
        "type": "object"
      },
      "CourseId": {
        "format": "uuid",
        "type": "string"
      },
      "CourseLifecycleRequest": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "description": "`publish` or `unpublish`.",
            "type": "string"
          }
        },
        "required": [
          "action"
        ],
        "type": "object"
      },
      "CoursePage": {
        "description": "Keyset page (ARCHITECTURE §6): pass `next_cursor` back as `cursor`.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Course"
            },
            "type": "array"
          },
          "next_cursor": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/CourseId"
              }
            ]
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "CreateCourseRequest": {
        "additionalProperties": false,
        "properties": {
          "about": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "CreateUploadRequest": {
        "additionalProperties": false,
        "properties": {
          "mime": {
            "type": "string"
          },
          "purpose": {
            "description": "One of: avatar, course-thumbnail, block-image, block-pdf, block-video,\nfile-submission.",
            "type": "string"
          },
          "size_bytes": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "purpose",
          "mime",
          "size_bytes"
        ],
        "type": "object"
      },
      "CreatedUpload": {
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "put_url": {
            "description": "PUT the file bytes here (presigned; valid for ~15 minutes).",
            "type": "string"
          }
        },
        "required": [
          "id",
          "key",
          "put_url"
        ],
        "type": "object"
      },
      "ErrorCode": {
        "description": "Stable, closed set of machine-readable error codes.",
        "enum": [
          "internal",
          "not-found",
          "forbidden",
          "unauthenticated",
          "conflict",
          "validation-failed",
          "rate-limited",
          "payload-too-large",
          "service-unavailable",
          "invalid-credentials",
          "mfa-required",
          "session-expired",
          "csrf-rejected",
          "account-disabled",
          "google-oauth-expired",
          "invalid-totp-code"
        ],
        "type": "string"
      },
      "FieldError": {
        "description": "A single field-level validation failure. `code` is a stable machine key the\nfrontend translates (e.g. `required`, `too-long`); `message` is English.",
        "properties": {
          "code": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "field",
          "code",
          "message"
        ],
        "type": "object"
      },
      "FinalizedUpload": {
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "size_bytes": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "key",
          "size_bytes"
        ],
        "type": "object"
      },
      "Health": {
        "properties": {
          "status": {
            "description": "Always `\"ok\"` when the endpoint answers.",
            "type": "string"
          },
          "version": {
            "description": "Server crate version.",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ],
        "type": "object"
      },
      "LoginRequest": {
        "additionalProperties": false,
        "description": "Password login. No `Debug` derive — the password must never format.",
        "properties": {
          "login": {
            "description": "Username or email.",
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "totp_code": {
            "description": "Second factor — resubmit after a 401 `mfa-required`.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "login",
          "password"
        ],
        "type": "object"
      },
      "Problem": {
        "description": "The wire shape of every error response.",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode",
            "description": "Stable machine code — the frontend's i18n key."
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "field_errors": {
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "type": "array"
          },
          "request_id": {
            "description": "Correlation id; also present as the `x-request-id` response header.",
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "description": "Stable documentation URI for this error class.",
            "type": "string"
          }
        },
        "required": [
          "type",
          "status",
          "code",
          "title"
        ],
        "type": "object"
      },
      "Role": {
        "properties": {
          "description_key": {
            "type": "string"
          },
          "display_name_key": {
            "description": "i18n key (frontend catalogs own the display strings).",
            "type": "string"
          },
          "is_system": {
            "type": "boolean"
          },
          "permissions": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "priority": {
            "format": "int32",
            "type": "integer"
          },
          "slug": {
            "type": "string"
          }
        },
        "required": [
          "slug",
          "display_name_key",
          "description_key",
          "priority",
          "is_system",
          "permissions"
        ],
        "type": "object"
      },
      "SessionInfo": {
        "description": "The current session, as the frontend sees it (client-side permission\ngating mirrors the legacy `Session` contract).",
        "properties": {
          "permissions": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "roles": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "user_id": {
            "$ref": "#/components/schemas/UserId"
          }
        },
        "required": [
          "user_id",
          "roles",
          "permissions"
        ],
        "type": "object"
      },
      "SessionSummary": {
        "description": "One of the caller's live sessions. `handle` is a non-bearer identifier\n(raw session ids never leave the server).",
        "properties": {
          "created_at_unix": {
            "format": "int64",
            "type": "integer"
          },
          "current": {
            "type": "boolean"
          },
          "handle": {
            "type": "string"
          },
          "ip": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_seen_unix": {
            "format": "int64",
            "type": "integer"
          },
          "user_agent": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "handle",
          "current",
          "created_at_unix",
          "last_seen_unix"
        ],
        "type": "object"
      },
      "TotpEnrollment": {
        "description": "TOTP enrollment secrets — shown to the user exactly once.",
        "properties": {
          "secret": {
            "description": "Base32 secret for manual entry.",
            "type": "string"
          },
          "uri": {
            "description": "`otpauth://` URI for QR rendering.",
            "type": "string"
          }
        },
        "required": [
          "uri",
          "secret"
        ],
        "type": "object"
      },
      "TotpVerifyRequest": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "type": "object"
      },
      "UpdateCourseRequest": {
        "additionalProperties": false,
        "properties": {
          "about": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "open_to_contributors": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "UpdateProfileRequest": {
        "additionalProperties": false,
        "description": "Partial update; omitted fields are unchanged.",
        "properties": {
          "bio": {
            "type": [
              "string",
              "null"
            ]
          },
          "display_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "locale": {
            "description": "One of the platform locales.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "UserId": {
        "format": "uuid",
        "type": "string"
      },
      "UserProfile": {
        "properties": {
          "avatar_key": {
            "type": [
              "string",
              "null"
            ]
          },
          "bio": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "id": {
            "$ref": "#/components/schemas/UserId"
          },
          "locale": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "email",
          "display_name",
          "bio",
          "locale"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "University LMS / MOOC platform API (v2, Rust rewrite).",
    "license": {
      "name": ""
    },
    "title": "Ashyq Bilim API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v2/auth/google": {
      "get": {
        "operationId": "google_start",
        "parameters": [
          {
            "description": "Relative return path",
            "in": "query",
            "name": "callback",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "303": {
            "description": "Redirect to Google"
          }
        },
        "summary": "Start Google sign-in: 303 to Google's consent screen.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v2/auth/google/callback": {
      "get": {
        "operationId": "google_callback",
        "parameters": [
          {
            "description": "Authorization code",
            "in": "query",
            "name": "code",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Opaque state",
            "in": "query",
            "name": "state",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Google-side error",
            "in": "query",
            "name": "error",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "303": {
            "description": "Redirect into the app (or to login with ?error=)"
          }
        },
        "summary": "Google redirects here; on success the session cookie is set and the\nbrowser continues to the original callback path.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v2/auth/login": {
      "post": {
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionInfo"
                }
              }
            },
            "description": "Logged in; session cookie set"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Invalid credentials"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Account disabled"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Too many attempts"
          }
        },
        "summary": "Password login (headless Zitadel session check behind the BFF).",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v2/auth/logout": {
      "post": {
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Session terminated, cookie cleared"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No live session"
          }
        },
        "summary": "Logout: revoke the current session and clear the cookie. Idempotent.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v2/auth/mfa/totp": {
      "delete": {
        "operationId": "totp_remove",
        "responses": {
          "204": {
            "description": "Removed (idempotent)"
          }
        },
        "summary": "Remove the TOTP authenticator.",
        "tags": [
          "auth"
        ]
      },
      "post": {
        "operationId": "totp_enroll",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TotpEnrollment"
                }
              }
            },
            "description": "Enrollment secrets"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Already enrolled"
          }
        },
        "summary": "Start TOTP enrollment (secrets are returned exactly once).",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v2/auth/mfa/totp/verify": {
      "post": {
        "operationId": "totp_verify",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TotpVerifyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "TOTP active"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Invalid code"
          }
        },
        "summary": "Activate TOTP with the first code from the authenticator app.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v2/auth/session": {
      "get": {
        "operationId": "current_session",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionInfo"
                }
              }
            },
            "description": "Current session"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No live session"
          }
        },
        "summary": "The caller's current session (also the cheapest \"am I logged in?\" probe).",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v2/auth/sessions": {
      "get": {
        "operationId": "list_sessions",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SessionSummary"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Live sessions"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No live session"
          }
        },
        "summary": "All live sessions of the caller (handles are non-bearer identifiers).",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v2/auth/sessions/{handle}": {
      "delete": {
        "operationId": "revoke_session",
        "parameters": [
          {
            "description": "Session handle from the listing",
            "in": "path",
            "name": "handle",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Revoked"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No such session"
          }
        },
        "summary": "Revoke one of the caller's own sessions by handle.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v2/courses": {
      "get": {
        "operationId": "list_courses",
        "parameters": [
          {
            "description": "next_cursor from the previous page",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/CourseId"
            }
          },
          {
            "description": "Page size, 1..=100 (default 20)",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoursePage"
                }
              }
            },
            "description": "Page of courses"
          }
        },
        "summary": "Newest-first course listing: public courses plus the caller's own\n(readers with `course:read:all` see everything).",
        "tags": [
          "courses"
        ]
      },
      "post": {
        "operationId": "create_course",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCourseRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Course"
                }
              }
            },
            "description": "Created"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Missing permission"
          }
        },
        "summary": "Create a course (requires `course:create:platform`).",
        "tags": [
          "courses"
        ]
      }
    },
    "/api/v2/courses/{id}": {
      "delete": {
        "operationId": "delete_course",
        "parameters": [
          {
            "description": "Course id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/CourseId"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No delete access"
          }
        },
        "summary": "Delete a course and everything under it (cascades).",
        "tags": [
          "courses"
        ]
      },
      "get": {
        "operationId": "get_course",
        "parameters": [
          {
            "description": "Course id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/CourseId"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Course"
                }
              }
            },
            "description": "Course"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unknown or inaccessible"
          }
        },
        "summary": "One course (404 for private courses the caller cannot see).",
        "tags": [
          "courses"
        ]
      },
      "patch": {
        "operationId": "update_course",
        "parameters": [
          {
            "description": "Course id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/CourseId"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCourseRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Course"
                }
              }
            },
            "description": "Updated"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No write access"
          }
        },
        "summary": "Partial update (creator with `course:update:own` or platform updaters).",
        "tags": [
          "courses"
        ]
      }
    },
    "/api/v2/courses/{id}/lifecycle": {
      "post": {
        "operationId": "course_lifecycle",
        "parameters": [
          {
            "description": "Course id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/CourseId"
            }
          }
        ],
        "requestBody": {
          "content": {
