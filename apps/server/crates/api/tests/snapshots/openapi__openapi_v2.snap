                  },
                  "type": "array"
                }
              }
            },
            "description": "Entries"
          }
        },
        "summary": "The append-only grading ledger of a submission, newest first.",
        "tags": [
          "grading"
        ]
      }
    },
    "/api/v2/submissions/{id}/review": {
      "get": {
        "operationId": "review_submission",
        "parameters": [
          {
            "description": "Submission id",
