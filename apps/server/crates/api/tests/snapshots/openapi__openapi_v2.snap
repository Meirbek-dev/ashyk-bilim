              }
            },
            "description": "Existing open attempt"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Attempt"
                }
              }
            },
            "description": "Draft opened"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not published or attempt cap reached"
          }
        },
        "summary": "Open a draft attempt (201) or return the open one (200).",
        "tags": [
          "file-submissions"
        ]
      }
    },
    "/api/v2/file-submissions/{file_submission_id}/me": {
      "get": {
        "operationId": "my_attempts",
        "parameters": [
          {
            "description": "File submission id",
            "in": "path",
            "name": "file_submission_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/FileSubmissionId"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Attempt"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Attempts"
          }
        },
        "summary": "Every attempt the caller made, newest first.",
        "tags": [
          "file-submissions"
        ]
      }
    },
    "/api/v2/file-submissions/{file_submission_id}/publish": {
      "post": {
        "operationId": "publish_file_submission",
        "parameters": [
          {
            "description": "File submission id",
            "in": "path",
            "name": "file_submission_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/FileSubmissionId"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileSubmission"
                }
              }
            },
            "description": "Published"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Missing title or instructions"
          }
        },
        "summary": "Publish (title and instructions required); the activity goes live.",
        "tags": [
          "file-submissions"
        ]
      }
    },
    "/api/v2/file-submissions/{file_submission_id}/publish-grades": {
      "post": {
        "description": "One publish save per row at its current version; a row changed\nmeanwhile or the caller's own is skipped. Runs detached.",
        "operationId": "publish_file_grades",
        "parameters": [
          {
            "description": "File submission id",
            "in": "path",
            "name": "file_submission_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/FileSubmissionId"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BulkGradeSummary"
                }
              }
            },
            "description": "Per-row outcome counts"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No grading access"
          }
        },
        "summary": "Release every held (`graded`) grade (batch release mode).",
        "tags": [
          "file-submissions"
        ]
      }
    },
    "/api/v2/file-submissions/{file_submission_id}/return-grades": {
      "post": {
        "description": "One `return` save per row at its current version; a published, stale,\nown or foreign row counts as skipped. Runs detached.",
        "operationId": "return_file_grades",
        "parameters": [
          {
            "description": "File submission id",
            "in": "path",
            "name": "file_submission_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/FileSubmissionId"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReturnAttemptsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BulkGradeSummary"
                }
              }
            },
            "description": "Per-row outcome counts"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No grading access"
          }
        },
        "summary": "Return the selected attempts for revision in one call (graders).",
        "tags": [
          "file-submissions"
        ]
      }
    },
    "/api/v2/file-submissions/{file_submission_id}/submissions": {
      "get": {
        "operationId": "file_submission_review_queue",
        "parameters": [
          {
            "description": "File submission id",
            "in": "path",
            "name": "file_submission_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/FileSubmissionId"
            }
          },
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/FileAttemptStatus"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          {
            "description": "Substring of the learner's username, display name or email.",
            "in": "query",
            "name": "search",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "description": "`next_cursor` of the previous page (same filters and order).",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/FileAttemptId"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          {
            "description": "1..=100 (default 25).",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": [
                "integer",
                "null"
              ]
            }
          },
          {
            "in": "query",
            "name": "late_only",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "description": "Members of this usergroup only.",
            "in": "query",
            "name": "group_id",
            "required": false,
            "schema": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/UsergroupId"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          {
            "description": "Queue order; absent = newest attempt first. Ties newest first.",
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/ReviewSort"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          {
            "description": "Default `desc` (with `sort`).",
            "in": "query",
            "name": "order",
            "required": false,
            "schema": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/SortOrder"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileReviewPage"
                }
              }
            },
            "description": "Review page"
          }
        },
        "summary": "Submitted attempts for grading, newest first unless `sort` / `order`\nsay otherwise (keyset: `next_cursor` back as `cursor`, same filters).",
        "tags": [
          "file-submissions"
        ]
      }
    },
    "/api/v2/file-submissions/{file_submission_id}/submissions/export": {
      "get": {
        "operationId": "export_file_submission_csv",
        "parameters": [
          {
            "description": "File submission id",
            "in": "path",
            "name": "file_submission_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/FileSubmissionId"
            }
          },
          {
            "description": "ru / kk / en (default ru)",
            "in": "header",
            "name": "Accept-Language",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "description": "Overrides `Accept-Language` (for links)",
            "in": "query",
            "name": "lang",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/UiLanguage"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/csv": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "CSV"
          }
        },
        "summary": "Every attempt as CSV (graders). Header and status words follow\n`Accept-Language` (ru / kk / en, Russian by default); UTF-8 with BOM.",
        "tags": [
          "file-submissions"
        ]
      }
    },
    "/api/v2/file-submissions/{file_submission_id}/submissions/stats": {
      "get": {
        "operationId": "file_submission_review_stats",
        "parameters": [
          {
            "description": "File submission id",
            "in": "path",
            "name": "file_submission_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/FileSubmissionId"
            }
          },
          {
            "description": "Members of this usergroup only.",
            "in": "query",
            "name": "group_id",
            "required": false,
            "schema": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/UsergroupId"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileReviewStats"
                }
              }
            },
            "description": "Counts"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No grading access"
          }
        },
        "summary": "Queue counts (graders), optionally for one group's members.",
        "tags": [
          "file-submissions"
        ]
      }
    },
    "/api/v2/file-submissions/{file_submission_id}/submit": {
      "post": {
        "description": "At least one file is required; late work is refused when the activity\ndoes not allow it and penalised by the late policy otherwise. With an\n`Idempotency-Key`, a retry with the same body replays the original\nresponse for 24h instead of opening a new attempt; the same key with a\ndifferent body is 422.",
        "operationId": "submit",
        "parameters": [
          {
            "description": "File submission id",
            "in": "path",
            "name": "file_submission_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/FileSubmissionId"
            }
          },
          {
            "description": "Attempt version (optional)",
            "in": "header",
            "name": "If-Match",
            "required": false,
            "schema": {
              "type": [
                "integer",
                "null"
              ]
            }
          },
          {
            "description": "Client retry token (optional)",
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Attempt"
                }
              }
            },
            "description": "Submitted"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not published, cap reached, or late work closed"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No files, or Idempotency-Key reused with a different body"
          }
        },
        "summary": "Submit the open attempt (optionally replacing files first).",
        "tags": [
          "file-submissions"
        ]
      }
    },
    "/api/v2/file-submissions/{file_submission_id}/unpublish": {
      "post": {
        "operationId": "unpublish_file_submission",
        "parameters": [
          {
            "description": "File submission id",
            "in": "path",
            "name": "file_submission_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/FileSubmissionId"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileSubmission"
                }
              }
            },
            "description": "Back to draft"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not an author"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not published, or the course is archived"
          }
        },
        "summary": "Take a published task back to draft (authors): the activity leaves the\nlearners' view; hand-ins stay, new ones wait until it is published again.",
        "tags": [
          "file-submissions"
        ]
      }
    },
    "/api/v2/gamification": {
      "get": {
        "operationId": "dashboard",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Dashboard"
                }
              }
            },
            "description": "Dashboard"
          }
        },
        "summary": "Profile, recent XP, rank and the top-10 leaderboard in one call.",
        "tags": [
          "gamification"
        ]
      }
    },
    "/api/v2/gamification/config": {
      "get": {
        "operationId": "get_config",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GamificationConfig"
                }
              }
            },
            "description": "Policy overrides"
          }
        },
        "tags": [
          "gamification"
        ]
      },
      "put": {
        "operationId": "update_config",
        "parameters": [
          {
            "description": "Config `version`; stale -> 412",
            "in": "header",
            "name": "If-Match",
            "required": false,
            "schema": {
              "format": "int32",
              "type": [
                "integer",
                "null"
              ]
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateGamificationConfigRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GamificationConfig"
                }
              }
            },
            "description": "Policy overrides"
          },
          "412": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Stale `If-Match`"
          }
        },
        "summary": "Replace the policy overrides (`platform:manage`).",
        "tags": [
          "gamification"
        ]
      }
    },
    "/api/v2/gamification/leaderboard": {
      "get": {
        "operationId": "leaderboard",
        "parameters": [
          {
            "description": "1..=100 (default 10).",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": [
                "integer",
                "null"
              ]
            }
          },
          {
            "description": "Legacy paging; ignored when `cursor` is given.",
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "type": [
                "integer",
                "null"
              ]
            }
          },
          {
            "description": "Keyset paging: the previous page's `next_cursor` (an empty string\nstarts from the top).",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Leaderboard"
                }
              }
            },
            "description": "Leaderboard"
          }
        },
        "tags": [
          "gamification"
        ]
      }
    },
    "/api/v2/gamification/preferences": {
      "patch": {
        "operationId": "update_preferences",
