            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "revision_requested": {
            "description": "The latest attempt was returned for revision; the cap is lifted.",
            "type": "boolean"
          }
        },
        "required": [
          "lifecycle",
          "is_teacher_preview",
          "effective",
          "disabled_reasons",
          "can_start",
          "can_continue",
          "revision_requested",
          "attempts_used"
