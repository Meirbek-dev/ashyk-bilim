    "/api/v2/enrollments": {
      "get": {
        "description": "S-10 name of [`get_trail`] (that path is deprecated).",
        "operationId": "list_enrollments",
        "parameters": [
          {
            "description": "`next_cursor` of the previous page",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Runs per page, 1..=100 (default: all; 20 with `cursor`)",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Trail"
                }
              }
            },
            "description": "Trail"
          }
        },
        "summary": "The caller's trail: one run per course, one step per activity marked\ndone. Anonymous callers get an empty trail. With `limit` / `cursor` the\nruns come in keyset pages (`next_cursor`).",
        "tags": [
          "progress"
        ]
      }
    },
    "/api/v2/enrollments/{course_id}": {
      "delete": {
        "description": "Trail mutations run `detached()` (BUG-221): a client that hangs up\nmid-request must not leave the step without its projection.\n\nS-10 name of [`remove_course`] (that path is deprecated).",
        "operationId": "leave_course",
        "parameters": [
          {
            "description": "Course id",
            "in": "path",
            "name": "course_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/CourseId"
            }
          },
          {
            "description": "`return=representation`: also answer the course's `learner_state`",
            "in": "header",
            "name": "Prefer",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Trail"
                }
              }
            },
            "description": "Trail"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not signed in"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No trail access"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unknown course or no run in it"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The trail lock is busy"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Malformed id"
          }
        },
        "summary": "Drop the run for a course and every step in it.",
        "tags": [
          "progress"
        ]
      },
      "post": {
        "description": "S-10 name of [`add_course`] (that path is deprecated).",
        "operationId": "enroll",
        "parameters": [
          {
            "description": "Course id",
            "in": "path",
            "name": "course_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/CourseId"
            }
          },
          {
            "description": "Retry-safe replay key",
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "description": "`return=representation`: also answer the course's `learner_state`",
            "in": "header",
            "name": "Prefer",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Trail"
                }
              }
            },
            "description": "Trail"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not signed in"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No course access"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unknown or invisible course"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Course staff never enrol, or the trail lock is busy"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Malformed id"
          }
        },
        "summary": "Start (or keep) a run for a course the caller can access.",
        "tags": [
          "progress"
        ]
      }
    },
