    "/api/v2/submissions/{id}/draft": {
      "patch": {
        "description": "Requires `If-Match` with the draft_version you loaded; 409 carries\n`{expected, actual}` when someone (another tab) saved in between.\nThrottled to one save per 5 seconds per draft (429).",
        "operationId": "save_draft",
        "parameters": [
          {
            "description": "Submission id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/SubmissionId"
            }
          },
          {
            "description": "Current draft_version",
            "in": "header",
            "name": "If-Match",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveDraftRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StudentSubmission"
                }
              }
            },
            "description": "Saved",
            "headers": {
              "ETag": {
                "description": "New quoted draft_version",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Time limit expired"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Stale draft_version or not a draft"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unknown item / wrong answer kind"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Saving too often"
          }
        },
        "summary": "Merge answers into the open draft.",
        "tags": [
          "submissions"
        ]
      }
    },
    "/api/v2/submissions/{id}/feedback": {
      "get": {
        "operationId": "my_feedback",
        "parameters": [
          {
            "description": "Submission id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/SubmissionId"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ItemFeedbackView"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Feedback"
          }
        },
        "summary": "Released item feedback on one of the caller's own submissions.",
        "tags": [
          "submissions"
        ]
      }
    },
    "/api/v2/submissions/{id}/grade": {
      "patch": {
        "description": "Requires `If-Match: \"<version>\"`; a mismatch is 412 with\n`{expected, actual}`. Item scores merge into the breakdown, the raw\nscore is given or computed from them, and the late penalty recorded at\nsubmit applies on top. Each save appends to the grading history.",
        "operationId": "save_grade",
        "parameters": [
          {
            "description": "Submission id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/SubmissionId"
            }
          },
          {
            "description": "Current version",
            "in": "header",
            "name": "If-Match",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GradeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TeacherSubmission"
                }
              }
            },
            "description": "Saved"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Draft cannot be graded"
          },
          "412": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Stale version"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Transition not allowed / bad score"
          }
        },
        "summary": "Save, publish or return a grade.",
        "tags": [
          "grading"
        ]
      }
    },
    "/api/v2/submissions/{id}/grading-history": {
      "get": {
        "operationId": "grading_history",
        "parameters": [
          {
            "description": "Submission id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
