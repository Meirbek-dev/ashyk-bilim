        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Course"
                }
              }
            },
            "description": "Created"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Missing permission"
          }
        },
        "summary": "Create a course (requires `course:create:platform`). Honours\n`Idempotency-Key` (a retry replays the 201 instead of a second course).",
        "tags": [
          "courses"
        ]
      }
    },
    "/api/v2/courses/{course_id}": {
      "delete": {
        "operationId": "delete_course",
