    "/api/v2/assessments/{assessment_id}/reference-check": {
      "post": {
        "deprecated": true,
        "description": "One entry per language the item allows; `missing_solution` when no\nreference is stored for it.",
        "operationId": "reference_check",
        "parameters": [
          {
            "description": "Assessment id",
            "in": "path",
            "name": "assessment_id",
