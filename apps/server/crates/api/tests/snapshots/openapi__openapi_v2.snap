    "/api/v2/search": {
      "get": {
        "operationId": "search",
        "parameters": [
          {
            "description": "Search terms (websearch syntax)",
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Per-section cap, 1..=50 (default 10)",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResults"
                }
              }
            },
            "description": "Grouped results"
          }
        },
        "summary": "Platform search over courses, collections, and people. Anonymous callers\nsee public content only and no people section.",
        "tags": [
          "search"
        ]
      }
    },
    "/api/v2/uploads": {
      "post": {
        "operationId": "create_upload",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUploadRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedUpload"
                }
              }
            },
            "description": "Presigned upload slot"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
