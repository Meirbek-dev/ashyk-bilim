    "/api/v2/ai/qa/{course_id}/chat": {
      "post": {
        "description": "Access, budget and the thread/user message are settled before the stream\nstarts, so they fail as normal HTTP errors; the model call and the\nanswer's persistence happen inside the stream, where a failure is a\n`RUN_ERROR` event. A retried `client_turn_id` replays the stored answer.",
        "operationId": "qa_chat",
        "parameters": [
          {
            "description": "Course id",
            "in": "path",
            "name": "course_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/CourseId"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QaChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/QaChatEvent"
                }
              }
            },
            "description": "AG-UI event stream: each message's `data` is one event"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unknown or inaccessible course"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Turn id reused or still in progress"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "AI disabled or budget exhausted"
          }
        },
        "summary": "AG-UI chat transport for course Q&A (consumed by `useChat`).",
        "tags": [
          "ai"
        ]
      }
    },
    "/api/v2/ai/qa/{course_id}/threads": {
      "get": {
        "operationId": "qa_threads",
