            "description": "Assessment id",
            "in": "path",
            "name": "assessment_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/AssessmentId"
            }
          },
          {
            "description": "Assessment `version`; stale → 412 (without it nothing changes)",
            "in": "header",
            "name": "If-Match",
            "required": false,
            "schema": {
              "format": "int32",
              "type": [
                "integer",
                "null"
              ]
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReorderItemsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AssessmentItem"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Reordered (order is presentation: the version stays)"
          },
          "412": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Stale `If-Match`"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unknown item ids"
          }
        },
        "summary": "Reorder items; returns the full list in the new order.",
        "tags": [
          "assessments"
        ]
      }
    },
    "/api/v2/assessments/{assessment_id}/lifecycle": {
      "post": {
        "description": "Allowed: draft→scheduled/published/archived,\nscheduled→draft/published/archived, published→draft/archived,\narchived→draft. Scheduling and publishing require readiness (422 with\nthe issues as field errors); scheduling needs a future time.",
        "operationId": "lifecycle",
        "parameters": [
          {
            "description": "Assessment id",
            "in": "path",
            "name": "assessment_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/AssessmentId"
            }
          },
          {
            "description": "Assessment `version`; stale → 412 (without it nothing changes)",
            "in": "header",
            "name": "If-Match",
            "required": false,
            "schema": {
              "format": "int32",
              "type": [
                "integer",
                "null"
              ]
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LifecycleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssessmentDetail"
                }
              }
            },
            "description": "Transitioned"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Transition not allowed"
          },
          "412": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Stale `If-Match`"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not ready / bad schedule"
          }
        },
        "summary": "Lifecycle transition.",
        "tags": [
          "assessments"
        ]
      }
    },
