            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Role"
                }
              }
            },
            "description": "Role",
            "headers": {
              "ETag": {
                "description": "Quoted `version`",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Missing permission"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unknown role"
          }
        },
        "summary": "One role with its grants (requires `role:read:platform`).",
        "tags": [
          "rbac"
        ]
      },
      "patch": {
        "operationId": "update_role",
        "parameters": [
          {
            "description": "Role slug",
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Current `version`; stale → 412",
            "in": "header",
            "name": "If-Match",
            "required": false,
            "schema": {
              "format": "int32",
              "type": [
                "integer",
                "null"
              ]
            }
          },
          {
            "description": "`return=representation`: answer 200 with the updated resource instead of 204",
            "in": "header",
            "name": "Prefer",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateRoleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Role"
                }
              }
            },
            "description": "Updated (`Prefer: return=representation`)"
          },
          "204": {
            "description": "Updated"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unknown or system role"
          },
          "412": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Stale `If-Match`"
          }
        },
        "summary": "Update a custom role's metadata (system roles are seed-managed).",
        "tags": [
          "rbac"
        ]
      }
    },
    "/api/v2/rbac/roles/{slug}/permissions": {
      "put": {
        "operationId": "set_role_permissions",
        "parameters": [
          {
            "description": "Role slug",
