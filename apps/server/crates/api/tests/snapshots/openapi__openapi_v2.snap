        ],
        "x-replaced-by": "reference_check_item"
      }
    },
    "/api/v2/assessments/{assessment_id}/return-grades": {
      "post": {
        "description": "One `return` grade save per row at its current version (events,\nnotifications, history as for `PATCH .../grade`); a row that is\nrefused - released, changed meanwhile, the caller's own, of another\nassessment - counts as skipped.",
        "operationId": "return_grades",
        "parameters": [
          {
            "description": "Assessment id",
            "in": "path",
            "name": "assessment_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/AssessmentId"
            }
          }
        ],
        "requestBody": {
          "content": {
