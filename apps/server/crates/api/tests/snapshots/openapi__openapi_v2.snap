          "returned"
        ],
        "type": "string"
      },
      "SubmissionStreamEvent": {
        "description": "`GET /submissions/{submission_id}/events`: one message's `data`.",
        "oneOf": [
          {
            "description": "Sent once, after any replay.",
            "properties": {
              "event": {
                "enum": [
                  "connected"
                ],
                "type": "string"
              },
              "submission_id": {
                "$ref": "#/components/schemas/SubmissionId"
              }
            },
            "required": [
              "submission_id",
              "event"
            ],
            "type": "object"
          },
          {
            "properties": {
              "event": {
                "enum": [
                  "grade.published"
                ],
                "type": "string"
              },
              "event_id": {
                "type": "string"
              },
              "payload": {
                "$ref": "#/components/schemas/GradePublishedPayload"
              },
              "sent_at": {
                "description": "Unix seconds.",
                "type": "integer"
              },
              "submission_id": {
                "$ref": "#/components/schemas/SubmissionId"
              }
            },
            "required": [
              "event_id",
              "submission_id",
              "payload",
              "sent_at",
              "event"
            ],
            "type": "object"
          },
          {
            "properties": {
              "event": {
                "enum": [
                  "submission.returned"
                ],
                "type": "string"
              },
              "event_id": {
                "type": "string"
              },
              "payload": {
                "$ref": "#/components/schemas/SubmissionReturnedPayload"
              },
              "sent_at": {
                "description": "Unix seconds.",
                "type": "integer"
              },
              "submission_id": {
                "$ref": "#/components/schemas/SubmissionId"
              }
            },
            "required": [
              "event_id",
              "submission_id",
              "payload",
              "sent_at",
              "event"
            ],
            "type": "object"
          },
          {
            "properties": {
              "event": {
                "enum": [
                  "deadline.extended"
                ],
                "type": "string"
              },
              "event_id": {
                "type": "string"
              },
              "payload": {
                "$ref": "#/components/schemas/DeadlineExtendedPayload"
              },
              "sent_at": {
                "description": "Unix seconds.",
                "type": "integer"
              },
              "submission_id": {
                "$ref": "#/components/schemas/SubmissionId"
              }
            },
            "required": [
              "event_id",
              "submission_id",
              "payload",
              "sent_at",
              "event"
            ],
            "type": "object"
          },
          {
            "description": "Access lost; the stream ends.",
            "properties": {
              "code": {
                "$ref": "#/components/schemas/ErrorCode"
              },
              "event": {
                "enum": [
                  "closed"
                ],
                "type": "string"
              }
            },
            "required": [
              "code",
              "event"
            ],
            "type": "object"
          }
        ]
      },
      "SubmissionUpdated": {
        "description": "The recipient's own submission or file attempt changed state.\n`final_score` only once the grade is released (`published`).",
