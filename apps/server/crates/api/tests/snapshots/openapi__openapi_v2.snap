            "name": "file_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/FileAttemptFileId"
            }
          },
          {
            "description": "`inline` signs `Content-Disposition: inline` (preview in a frame)\nfor raster images, PDF, audio, video and plain text only; every\nother type is always `attachment` as `application/octet-stream`.\nDefault `attachment` (download under the original name).",
            "in": "query",
            "name": "disposition",
            "required": false,
            "schema": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/Disposition"
                },
                {
                  "type": "null"
                }
