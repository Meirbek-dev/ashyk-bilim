    "/api/v2/courses/{course_id}/lifecycle": {
      "post": {
        "description": "409 `conflict`: `archive` on an archived course, `restore` on an active\none. 409 `course-archived`: `publish` / `unpublish` on an archived one.",
        "operationId": "course_lifecycle",
        "parameters": [
          {
            "description": "Course id",
            "in": "path",
            "name": "course_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/CourseId"
            }
          },
          {
            "description": "Current `version`; stale â†’ 412",
            "in": "header",
            "name": "If-Match",
            "required": false,
            "schema": {
              "format": "int32",
              "type": [
                "integer",
                "null"
              ]
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CourseLifecycleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Course"
                }
              }
            },
            "description": "Lifecycle changed",
            "headers": {
              "ETag": {
                "description": "Quoted new version",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No write / roster access"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unknown or inaccessible"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Already in that state (`conflict`) or archived (`course-archived`)"
          },
          "412": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Stale `If-Match`"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Publish blocked by readiness (`course-not-ready`,                                       `details.blockers`)"
          }
        },
        "summary": "Lifecycle: `publish` / `unpublish` (course write access, readiness\ngated), `archive` / `restore` (creator, active maintainer or\n`course:manage:platform`; see docs/COURSE_ARCHIVING.md).",
        "tags": [
          "courses"
        ]
      }
    },
