      "get": {
        "operationId": "export_csv",
        "parameters": [
          {
            "description": "Assessment id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/AssessmentId"
            }
          }
        ],
        "responses": {
