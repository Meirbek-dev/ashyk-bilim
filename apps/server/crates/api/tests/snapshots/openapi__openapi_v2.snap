            "type": "string"
          }
        },
        "required": [
          "role"
        ],
        "type": "object"
      },
      "AttemptState": {
        "description": "What the learner may do right now (flat flags for the client).",
        "properties": {
          "attempts_remaining": {
            "description": "`null` = unlimited.",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "attempts_used": {
            "format": "int64",
            "type": "integer"
          },
          "can_continue": {
            "description": "An open draft exists and may still be worked on.",
