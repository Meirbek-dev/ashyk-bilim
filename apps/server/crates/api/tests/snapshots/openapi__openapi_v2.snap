            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Stale `If-Match`"
          }
        },
        "summary": "Partial update of title and configuration (authors; archived = read-only).",
        "tags": [
          "file-submissions"
        ]
      }
    },
    "/api/v2/file-submissions/{file_submission_id}/deadline-extensions": {
      "post": {
        "description": "Synchronous: the learners' own due date replaces the activity's (the\nclosed gate, lateness, their view of `due_at_unix`); work they already\nhanded in is re-judged. Each learner gets a `deadline.extended` event.\n`done_count` = learners extended. Retry-safe with `Idempotency-Key`.",
        "operationId": "extend_file_deadline",
