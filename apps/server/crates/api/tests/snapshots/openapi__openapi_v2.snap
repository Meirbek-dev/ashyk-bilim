            "name": "activity_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ActivityId"
            }
          },
          {
            "description": "`return=representation`: also answer the course's `learner_state`",
            "in": "header",
            "name": "Prefer",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Trail"
                }
              }
            },
            "description": "Trail"
          }
        },
        "summary": "Un-mark an activity.",
        "tags": [
          "progress"
        ]
      },
      "post": {
        "description": "S-10 name of [`add_activity`] (that path is deprecated).",
        "operationId": "complete_activity",
        "parameters": [
          {
            "description": "Activity id",
            "in": "path",
            "name": "activity_id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ActivityId"
            }
          },
          {
            "description": "`return=representation`: also answer the course's `learner_state`",
            "in": "header",
            "name": "Prefer",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Trail"
                }
              }
            },
            "description": "Trail"
          }
        },
        "summary": "Mark an activity done (lesson-type activities also complete in the\ncanonical progress; assessments are projected by their own pipeline).",
        "tags": [
          "progress"
        ]
      }
    },
    "/api/v2/rbac/roles": {
      "get": {
        "operationId": "list_roles",
        "responses": {
          "200": {
