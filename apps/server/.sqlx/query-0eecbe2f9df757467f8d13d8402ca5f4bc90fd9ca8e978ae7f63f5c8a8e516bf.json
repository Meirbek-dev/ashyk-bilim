  "query": "SELECT e.course_id AS \"course_id!: CourseId\", e.user_id AS \"user_id!: UserId\",\n                  (extract(epoch FROM e.enrolled_at))::bigint AS \"enrolled_at!\"\n           FROM course_members e\n           WHERE e.user_id = $1\n           ORDER BY e.enrolled_at, e.course_id",
