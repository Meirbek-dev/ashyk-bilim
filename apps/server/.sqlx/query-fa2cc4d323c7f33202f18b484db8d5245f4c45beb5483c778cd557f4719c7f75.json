{
  "db_name": "PostgreSQL",
  "query": "SELECT id AS \"id: SubmissionId\", assessment_id AS \"assessment_id: AssessmentId\",\n                  course_id AS \"course_id: CourseId\", user_id AS \"user_id: UserId\",\n                  status AS \"status: SubmissionStatus\", attempt_number, answers,\n                  submission_breakdown(id, auto_breakdown) AS \"grading!\",\n                  auto_score::float8 AS \"auto_score?\", final_score::float8 AS \"final_score?\",\n                  max_points::float8 AS \"max_points?\", auto_points::float8 AS \"auto_points?\",\n                  final_points::float8 AS \"final_points?\", is_late, late_penalty_pct::float8 AS \"late_penalty_pct!\",\n                  violation_count, submission_violation_log(id) AS \"violations!\",\n                  auto_submit_reason AS \"auto_submit_reason: AutoSubmitReason\",\n                  (extract(epoch FROM rules_accepted_at))::bigint AS \"rules_accepted_at?\",\n                  (extract(epoch FROM auto_submitted_at))::bigint AS \"auto_submitted_at?\",\n                  auto_submit_attempts,\n                  (extract(epoch FROM auto_submit_retry_at))::bigint AS \"auto_submit_retry_at?\",\n                  duration_seconds,\n                  (extract(epoch FROM started_at))::bigint AS \"started_at?\",\n                  (extract(epoch FROM submitted_at))::bigint AS \"submitted_at?\",\n                  (extract(epoch FROM graded_at))::bigint AS \"graded_at?\",\n                  version, draft_version, content_version,\n                  (base_version_id IS NULL\n                   OR (SELECT b.items_sha256 FROM assessment_versions b WHERE b.id = base_version_id)\n                      IS DISTINCT FROM (SELECT c.items_sha256 FROM assessments a\n                                        JOIN assessment_versions c ON c.id = a.current_version_id\n                                        WHERE a.id = submissions.assessment_id)) AS \"items_stale!\",\n                  (SELECT v.items FROM assessment_versions v WHERE v.id = assessment_version_id) AS items_snapshot,\n                  (SELECT v.policy FROM assessment_versions v WHERE v.id = assessment_version_id) AS policy_snapshot,\n                  preview,\n                  (extract(epoch FROM created_at))::bigint AS \"created_at!\",\n                  (extract(epoch FROM updated_at))::bigint AS \"updated_at!\"\n           FROM submissions WHERE id = $1\n             AND NOT EXISTS (SELECT 1 FROM file_submissions fs WHERE fs.id = submissions.assessment_id)",
