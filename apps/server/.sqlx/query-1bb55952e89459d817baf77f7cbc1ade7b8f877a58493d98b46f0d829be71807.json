  "query": "SELECT id AS \"id: UserId\", username, display_name, avatar_key\n           FROM users\n           WHERE status = 'active'\n             AND (username ILIKE $1 OR display_name ILIKE $1)\n           ORDER BY (username ILIKE $2 OR display_name ILIKE $2) DESC, username\n           LIMIT $3",
