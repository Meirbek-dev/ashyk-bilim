{
  "db_name": "PostgreSQL",
  "query": "SELECT id AS \"id: UserId\", username, display_name, avatar_key\n           FROM users\n           WHERE status = 'active'\n             AND (username ILIKE $1 ESCAPE '\\' OR display_name ILIKE $1 ESCAPE '\\')\n           ORDER BY (username ILIKE $2 ESCAPE '\\' OR display_name ILIKE $2 ESCAPE '\\') DESC, username\n           LIMIT $3",
