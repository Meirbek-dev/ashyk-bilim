{
  "db_name": "PostgreSQL",
  "query": "SELECT u.id AS \"id: UserId\", u.username, u.email, u.display_name, u.organization, u.status,\n                  COALESCE(array_agg(r.slug ORDER BY r.priority DESC)\n                           FILTER (WHERE r.slug IS NOT NULL), '{}') AS \"roles!\",\n                  (extract(epoch FROM u.created_at))::bigint AS \"created_at!\"\n           FROM users u\n           LEFT JOIN user_roles ur ON ur.user_id = u.id\n           LEFT JOIN roles r ON r.id = ur.role_id\n           WHERE u.id = $1\n           GROUP BY u.id",
