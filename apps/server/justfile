# Ashyq server recipes (Rust workspace). Repo-wide tasks live in the root
# justfile. `just ci` runs every server gate CI runs, in CI order; CI calls
# the same recipes one by one. See AGENTS.md.

set dotenv-load := true
set positional-arguments := true
[unix]
set shell := ["bash", "-cu"]
[windows]
set shell := ["sh", "-cu"]
[unix]
set script-interpreter := ["bash", "-eu"]
[windows]
set script-interpreter := ["sh", "-eu"]

# Bounds Windows linker memory; override on larger machines.
export CARGO_BUILD_JOBS := env("CARGO_BUILD_JOBS", "4")
export SQLX_OFFLINE := env("SQLX_OFFLINE", "true")
# A linked git worktree builds into `<target>-<worktree id>`: cargo names artifacts the same in every checkout, so a
# shared dir runs another tree's code (same rule as infra/dev/cargo-target.ts).
_git_dir := replace(shell('git rev-parse --absolute-git-dir 2>/dev/null || true'), '\', '/')
_wt_suffix := if _git_dir =~ '/worktrees/[^/]+$' { "-" + file_name(_git_dir) } else { "" }
_target := env("CARGO_TARGET_DIR", if os() == "windows" { env("LOCALAPPDATA") / "ashyq-bilim/cargo-target" } else { justfile_directory() / "target" })
export CARGO_TARGET_DIR := if _target =~ (_wt_suffix + '$') { _target } else { _target + _wt_suffix }
just_bin := quote(replace(just_executable(), '\\', '/'))

default: check

# Install the required cargo tooling (one-time per machine).
setup:
    cargo install cargo-binstall --version 1.26.1 --locked
    source ./tools.env && cargo binstall -y ${LINT_TOOLS//,/ } ${TEST_TOOLS//,/ } ${DEV_TOOLS//,/ }

# Refresh the workspace lockfile to the latest compatible registry releases.
update:
    cargo update

# Fast feedback: format check + lints. Run constantly.
check: fmt-check clippy

fmt:
    cargo fmt --all

fmt-check:
    cargo fmt --all --check

clippy:
    cargo clippy --locked --workspace --all-targets -- -D warnings

# Full test suite (integration tests in crates/*/tests need `just services`).
test *args:
    cargo nextest run --locked --workspace "$@"

# Unit tests only - no Postgres/Redis/Docker required (Windows sessions).
test-unit *args:
    cargo nextest run --locked --workspace --lib --bins "$@"

# Verify the committed .sqlx offline cache matches the schema + queries.
# Missing or stale cache is an error.
sqlx-check:
    SQLX_OFFLINE=false cargo sqlx prepare --check --workspace -- --locked

# Refresh .sqlx after changing any SQL. Commit the result.
prepare:
    SQLX_OFFLINE=false cargo sqlx prepare --workspace -- --locked

migrate:
    sqlx migrate run --source migrations

# Create a new migration: just migration add_users_table
migration NAME:
    sqlx migrate add --source migrations "$@"

# Export the OpenAPI contract artifact.
[script]
openapi:
    set -euo pipefail
    tmp=$(mktemp openapi.v2.XXXXXX.json)
    trap 'rm -f "$tmp"' EXIT
    cargo run --locked -p ashyq-server -- openapi > "$tmp"
    mv "$tmp" openapi.v2.json

# Fail if the committed openapi.v2.json differs from a fresh export.
[script]
openapi-check:
    set -euo pipefail
    tmp="$(mktemp)"
    trap 'rm -f "$tmp"' EXIT
    cargo run --locked -q -p ashyq-server -- openapi > "$tmp"
    diff -u openapi.v2.json "$tmp"

# Coverage with floor (ratchet up as phases land - never down).
# Scaffold floor 30 -> 80 after P3 (measured 88% lines, 2026-09-05).
# main.rs is the process entrypoint and is not held to the floor.
cov *args:
    cargo llvm-cov nextest --locked --workspace --fail-under-lines 80 --ignore-filename-regex 'crates[\\/]server[\\/]src[\\/]main\.rs' "$@"

deny:
    cargo deny check

machete:
    cargo machete

# Everything CI runs, in CI order. Green here == green CI.
ci: fmt-check clippy deny machete openapi-check sqlx-check cov

# Web e2e fixtures (accounts + a published course; idempotent). Needs the
# dev stack incl. Zitadel and E2E_PASSWORD; refuses AB__ENVIRONMENT=production.
seed-e2e:
    cargo run --locked -p ashyq-server -- admin seed-e2e

# Dev stack (db, redis, zitadel, rustfs) via the root justfile.
services:
    {{ just_bin }} --justfile ../../justfile dev-up

dev:
    bacon

# Run the API without the file watcher.
serve:
    cargo run --locked -p ashyq-server -- serve
