{
  "openapi": "3.1.0",
  "info": {
    "title": "Ashyq Bilim API",
    "description": "University LMS / MOOC platform API (v2, Rust rewrite).",
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/v2/auth/google": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Start Google sign-in: 303 to Google's consent screen.",
        "operationId": "google_start",
        "parameters": [
          {
            "name": "callback",
            "in": "query",
            "description": "Relative return path",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "303": {
            "description": "Redirect to Google"
          }
        }
      }
    },
    "/api/v2/auth/google/callback": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Google redirects here; on success the session cookie is set and the\nbrowser continues to the original callback path.",
        "operationId": "google_callback",
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "description": "Authorization code",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "in": "query",
            "description": "Opaque state",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "error",
            "in": "query",
            "description": "Google-side error",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "303": {
            "description": "Redirect into the app (or to login with ?error=)"
          }
        }
      }
    },
    "/api/v2/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Password login (headless Zitadel session check behind the BFF).",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Logged in; session cookie set",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionInfo"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Account disabled",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Too many attempts",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Logout: revoke the current session and clear the cookie. Idempotent.",
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Session terminated, cookie cleared"
          },
          "401": {
            "description": "No live session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/auth/mfa/totp": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Start TOTP enrollment (secrets are returned exactly once).",
        "operationId": "totp_enroll",
        "responses": {
          "200": {
            "description": "Enrollment secrets",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TotpEnrollment"
                }
              }
            }
          },
          "409": {
            "description": "Already enrolled",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "auth"
        ],
        "summary": "Remove the TOTP authenticator.",
        "operationId": "totp_remove",
        "responses": {
          "204": {
            "description": "Removed (idempotent)"
          }
        }
      }
    },
    "/api/v2/auth/mfa/totp/verify": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Activate TOTP with the first code from the authenticator app.",
        "operationId": "totp_verify",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TotpVerifyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "TOTP active"
          },
          "400": {
            "description": "Invalid code",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/auth/session": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "The caller's current session (also the cheapest \"am I logged in?\" probe).",
        "operationId": "current_session",
        "responses": {
          "200": {
            "description": "Current session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionInfo"
                }
              }
            }
          },
          "401": {
            "description": "No live session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/auth/sessions": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "All live sessions of the caller (handles are non-bearer identifiers).",
        "operationId": "list_sessions",
        "responses": {
          "200": {
            "description": "Live sessions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SessionSummary"
                  }
                }
              }
            }
          },
          "401": {
            "description": "No live session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/auth/sessions/{handle}": {
      "delete": {
        "tags": [
          "auth"
        ],
        "summary": "Revoke one of the caller's own sessions by handle.",
        "operationId": "revoke_session",
        "parameters": [
          {
            "name": "handle",
            "in": "path",
            "description": "Session handle from the listing",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Revoked"
          },
          "404": {
            "description": "No such session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness: the process is up.",
        "operationId": "live",
        "responses": {
          "200": {
            "description": "Process is alive",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Readiness: dependencies are reachable (Postgres; Redis/RustFS/Zitadel probes\njoin as their clients land).",
        "operationId": "ready",
        "responses": {
          "200": {
            "description": "Ready to serve traffic",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "500": {
            "description": "A dependency is unreachable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/rbac/roles": {
      "get": {
        "tags": [
          "rbac"
        ],
        "summary": "All roles with their grants (requires `role:read:platform`).",
        "operationId": "list_roles",
        "responses": {
          "200": {
            "description": "Roles",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Role"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Missing permission",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/users/me": {
      "get": {
        "tags": [
          "users"
        ],
        "summary": "The caller's own profile.",
        "operationId": "my_profile",
        "responses": {
          "200": {
            "description": "Own profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfile"
                }
              }
            }
          },
          "401": {
            "description": "No live session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "users"
        ],
        "summary": "Update the caller's own profile (requires `user:update:own`).",
        "operationId": "update_my_profile",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProfileRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Updated profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfile"
                }
              }
            }
          },
          "403": {
            "description": "Missing permission",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Validation failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/users/{user_id}/roles": {
      "post": {
        "tags": [
          "rbac"
        ],
        "summary": "Assign a role to a user (requires `role:manage:platform`). Live sessions\nof the user pick the new grants up immediately.",
        "operationId": "assign_role",
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "description": "Target user",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/UserId"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssignRoleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Assigned"
          },
          "403": {
            "description": "Missing permission",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Unknown user or role",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/users/{user_id}/roles/{slug}": {
      "delete": {
        "tags": [
          "rbac"
        ],
        "summary": "Remove a role from a user (requires `role:manage:platform`).",
        "operationId": "unassign_role",
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "description": "Target user",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/UserId"
            }
          },
          {
            "name": "slug",
            "in": "path",
            "description": "Role slug",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Removed"
          },
          "403": {
            "description": "Missing permission",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Unknown user or role",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AssignRoleRequest": {
        "type": "object",
        "required": [
          "role"
        ],
        "properties": {
          "role": {
            "type": "string",
            "description": "Role slug, e.g. `instructor`."
          }
        },
        "additionalProperties": false
      },
      "ErrorCode": {
        "type": "string",
        "description": "Stable, closed set of machine-readable error codes.",
        "enum": [
          "internal",
          "not-found",
          "forbidden",
          "unauthenticated",
          "conflict",
          "validation-failed",
          "rate-limited",
          "payload-too-large",
          "service-unavailable",
          "invalid-credentials",
          "mfa-required",
          "session-expired",
          "csrf-rejected",
          "account-disabled",
          "google-oauth-expired",
          "invalid-totp-code"
        ]
      },
      "FieldError": {
        "type": "object",
        "description": "A single field-level validation failure. `code` is a stable machine key the\nfrontend translates (e.g. `required`, `too-long`); `message` is English.",
        "required": [
          "field",
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "Always `\"ok\"` when the endpoint answers."
          },
          "version": {
            "type": "string",
            "description": "Server crate version."
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "description": "Password login. No `Debug` derive — the password must never format.",
        "required": [
          "login",
          "password"
        ],
        "properties": {
          "login": {
            "type": "string",
            "description": "Username or email."
          },
          "password": {
            "type": "string"
          },
          "totp_code": {
            "type": [
              "string",
              "null"
            ],
            "description": "Second factor — resubmit after a 401 `mfa-required`."
          }
        },
        "additionalProperties": false
      },
      "Problem": {
        "type": "object",
        "description": "The wire shape of every error response.",
        "required": [
          "type",
          "status",
          "code",
          "title"
        ],
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode",
            "description": "Stable machine code — the frontend's i18n key."
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "field_errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          },
          "request_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Correlation id; also present as the `x-request-id` response header."
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "description": "Stable documentation URI for this error class."
          }
        }
      },
      "Role": {
        "type": "object",
        "required": [
          "slug",
          "display_name_key",
          "description_key",
          "priority",
          "is_system",
          "permissions"
        ],
        "properties": {
          "description_key": {
            "type": "string"
          },
          "display_name_key": {
            "type": "string",
            "description": "i18n key (frontend catalogs own the display strings)."
          },
          "is_system": {
            "type": "boolean"
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "priority": {
            "type": "integer",
            "format": "int32"
          },
          "slug": {
            "type": "string"
          }
        }
      },
      "SessionInfo": {
        "type": "object",
        "description": "The current session, as the frontend sees it (client-side permission\ngating mirrors the legacy `Session` contract).",
        "required": [
          "user_id",
          "roles",
          "permissions"
        ],
        "properties": {
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "user_id": {
            "$ref": "#/components/schemas/UserId"
          }
        }
      },
      "SessionSummary": {
        "type": "object",
        "description": "One of the caller's live sessions. `handle` is a non-bearer identifier\n(raw session ids never leave the server).",
        "required": [
          "handle",
          "current",
          "created_at_unix",
          "last_seen_unix"
        ],
        "properties": {
          "created_at_unix": {
            "type": "integer",
            "format": "int64"
          },
          "current": {
            "type": "boolean"
          },
          "handle": {
            "type": "string"
          },
          "ip": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_seen_unix": {
            "type": "integer",
            "format": "int64"
          },
          "user_agent": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "TotpEnrollment": {
        "type": "object",
        "description": "TOTP enrollment secrets — shown to the user exactly once.",
        "required": [
          "uri",
          "secret"
        ],
        "properties": {
          "secret": {
            "type": "string",
            "description": "Base32 secret for manual entry."
          },
          "uri": {
            "type": "string",
            "description": "`otpauth://` URI for QR rendering."
          }
        }
      },
      "TotpVerifyRequest": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "UpdateProfileRequest": {
        "type": "object",
        "description": "Partial update; omitted fields are unchanged.",
        "properties": {
          "bio": {
            "type": [
              "string",
              "null"
            ]
          },
          "display_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "locale": {
            "type": [
              "string",
              "null"
            ],
            "description": "One of the platform locales."
          }
        },
        "additionalProperties": false
      },
      "UserId": {
        "type": "string",
        "format": "uuid"
      },
      "UserProfile": {
        "type": "object",
        "required": [
          "id",
          "username",
          "email",
          "display_name",
          "bio",
          "locale"
        ],
        "properties": {
          "avatar_key": {
            "type": [
              "string",
              "null"
            ]
          },
          "bio": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "id": {
            "$ref": "#/components/schemas/UserId"
          },
          "locale": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "health",
      "description": "Liveness and readiness probes"
    },
    {
      "name": "auth",
      "description": "Sessions and authentication (BFF cookie)"
    },
    {
      "name": "users",
      "description": "User profiles and preferences"
    },
    {
      "name": "rbac",
      "description": "Roles and permission administration"
    }
  ]
}
