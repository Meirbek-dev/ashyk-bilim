{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "tags": ["-lintignore"],
  "entry": ["src/app/**/*.{ts,tsx}", "src/i18n/navigation.ts", "scripts/**/*.mjs"],
  "project": ["src/**/*.{ts,tsx,mjs}"],
  "ignore": ["src/components/ui/**/*"],
  "ignoreDependencies": ["@shadcn/react", "sharp", "shadcn", "tw-animate-css", "tailwindcss", "prosemirror-view"],
  "ignoreIssues": {
    "src/lib/api/generated/**": ["files", "exports", "types"]
  },
  "rules": {
    "files": "warn",
    "exports": "off",
    "types": "off",
    "duplicates": "off"
  }
}
