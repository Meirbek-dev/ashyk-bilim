# Local web example only.
# For Docker deployments, copy extra/example-conf.env to extra/.env and keep the shared app env there.

# Backend URLs (Rust server, apps/server; AB__SERVER__PORT defaults to 8000)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v2/
NEXT_PUBLIC_SITE_URL=http://localhost:3000/
# Optional: origin serving public objects at /content/<key>; defaults to NEXT_PUBLIC_SITE_URL.
# NEXT_PUBLIC_MEDIA_URL=http://localhost:3000/

INTERNAL_API_URL=http://localhost:8000/api/v2/

# App URL used for cookie/domain derivation on the server.
APP_URL=http://localhost:3000

# Optional cookie override for non-standard deployments.
# COOKIE_DOMAIN=example.com

NEXT_TELEMETRY_DISABLED=1

# Required for multi-server deployments or consistent server action keys across builds
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
