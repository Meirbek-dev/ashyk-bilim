# Local web example (copy to apps/web/.env.local). The Rust server runs on the
# host (apps/server, port 8000) against the dev stack (`just dev-up`).
# Production config comes from compose.prod.yaml; contract: docs/INFRA.md.

# Backend URLs
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v2/
NEXT_PUBLIC_SITE_URL=http://localhost:3000/
# Optional: origin serving public objects at /content/<key>; defaults to NEXT_PUBLIC_SITE_URL.
# NEXT_PUBLIC_MEDIA_URL=http://localhost:3000/

INTERNAL_API_URL=http://localhost:8000/api/v2/

# Dev only: serve /content/<key> from the dev RustFS public bucket (nginx does it in prod).
CONTENT_REWRITE_TARGET=http://localhost:9002/ab-public

# App URL used for cookie/domain derivation on the server.
APP_URL=http://localhost:3000

# Optional cookie override for non-standard deployments.
# COOKIE_DOMAIN=example.com

NEXT_TELEMETRY_DISABLED=1

# Required for multi-server deployments or consistent server action keys across builds
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
