# Production env consumed by docker-compose.yml. Copy to .env and fill in.
# .env is git-ignored. Never commit real secret values.
# Local server development uses apps/server/.env.example instead.

# ── Domain ────────────────────────────────────────────────────────────────────
NGINX_SERVER_NAME=cs-mooc.tou.edu.kz

# ── Next.js ───────────────────────────────────────────────────────────────────
# Required for consistent server action keys across builds.
# Generate with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=openu
POSTGRES_DB=openu
POSTGRES_PASSWORD=                       # required - generate: openssl rand -hex 32
AB__DATABASE__URL=                       # required: postgres://user:password@db:5432/ashyq

# ── Identity (Zitadel) ────────────────────────────────────────────────────────
AB__ZITADEL__PAT=                        # required after Zitadel bootstrap
ZITADEL_MASTERKEY=                       # required: exactly 32 characters
ZITADEL_DB_PASSWORD=                     # required: unique random database password
ZITADEL_PAT_EXPIRATION=                  # required: future RFC3339 timestamp

# ── Object storage (RustFS) ───────────────────────────────────────────────────
RUSTFS_ACCESS_KEY=                       # required: unique storage access key
RUSTFS_SECRET_KEY=                       # required: unique random storage secret

# ── Release ───────────────────────────────────────────────────────────────────
# extra/deploy.sh defaults this to the checked-out commit.
# IMAGE_TAG=

# Optional integrations: uncomment complete groups only; empty AB__ keys are
# parsed as configured values. The Google callback must be registered at Google.
# AB__GOOGLE__CLIENT_ID=
# AB__GOOGLE__CLIENT_SECRET=
# AB__GOOGLE__REDIRECT_URI=https://cs-mooc.tou.edu.kz/api/v2/auth/google/callback
# AB__AI__OPENAI_API_KEY=
# AB__AI__OPENROUTER_API_KEY=
# AB__RESEND__API_KEY=
# AB__JUDGE0__DATABASE_URL=postgres://user:password@db:5432/openu
# AB__TELEMETRY__OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <token>
