{
  "name": "ashyk-bilim",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "bun run --cwd apps/web build",
    "start": "bun run --cwd apps/web start",
    "dev": "bun run --cwd apps/web dev",
    "lint": "bun run --cwd apps/web lint",
    "format": "bun run --cwd apps/web format",
    "test": "bun run --cwd apps/web test",
    "checktypes": "bun run --cwd apps/web checktypes",
    "generate:contracts": "bun run --cwd apps/web generate:contracts",
    "check:contracts": "bun run --cwd apps/web check:contracts",
    "audit:errors": "bun run --cwd apps/web audit:errors",
    "services": "docker compose -f docker-compose.dev.yml up -d",
    "taze": "taze -r -w -u -i",
    "deploy": "bash ./extra/deploy.sh"
  },
  "devDependencies": {
    "taze": "^21.3.0",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "prosemirror-model": "1.25.12",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2",
  "catalog": {
    "@vitest/browser-playwright": "5.0.1",
    "@vitest/coverage-v8": "5.0.1",
    "@vitest/ui": "5.0.1",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0",
    "vitest": "5.0.1"
  }
}
