# Build context is the repo root for apps/web/Dockerfile and apps/server/Dockerfile.
# They need apps/web/** (own package.json and bun.lock) and apps/server/** (incl. .sqlx).

# VCS, CI, editors, agents
.git
.github
.vscode
.idea
.agents
.claude
**/.DS_Store

# Docs
docs/
**/*.md

# Ops, infra and local data (never in an image)
infra/
certs/
backups/
temp-restore/
tmp/
**/tmp/
.deploy-history
.deploy.lock

# Secrets / env
**/.env
**/.env.*
**/server.env
**/*.pem

# Dependencies and build output (rebuilt inside the image)
**/node_modules
**/.next
**/target
**/*.tsbuildinfo

# Test artefacts and logs
**/coverage
**/reports
**/test-results
**/playwright-report
**/*.log
