# Build context (repo root) for apps/web/Dockerfile and apps/server/Dockerfile.

# Node / build outputs
node_modules
**/node_modules
.next
**/.next
out
dist
**/dist

# Logs and runtime data
logs
*.log
**/*.log

# Cache directories
.cache
.npm
.eslintcache
.nyc_output
**/*.tsbuildinfo
**/.eslintcache

# Coverage
coverage
*.lcov

# Temporary files
tmp/
temp/
*.tmp

# IDE / OS
.vscode
.idea
*.swp
*.swo
.DS_Store
Thumbs.db

# Git
.git
.gitignore
**/.gitignore
.gitattributes
.github

# Docker files (not needed inside images)
**/Dockerfile
**/.dockerignore
docker-compose*.yml

# Documentation
README.md
docs/
*.md

# Secrets / env (never bake into images)
.env
.env.*
**/.env
**/.env.*
certs/
**/target/

# Backups and test artefacts
backups/
temp-restore/
junit.xml
test-results/
.claude/
.turbo/

# AI / agent files
.agents
.antigravitycli
.kiro
