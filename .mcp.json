{
  "mcpServers": {
    "playwright": {
      "command": "bunx",
      "args": [
        "@playwright/mcp@0.0.86",
        "--browser",
        "chromium",
        "--headless",
        "--isolated",
        "--output-dir",
        "tmp/playwright-mcp"
      ]
    },
    "postgres": {
      "command": "bunx",
      "args": ["@toolbox-sdk/server@1.18.0", "--prebuilt", "postgres", "--stdio"],
      "env": {
        "POSTGRES_HOST": "127.0.0.1",
        "POSTGRES_PORT": "${DEV_PG_PORT:-5433}",
        "POSTGRES_DATABASE": "${DEV_DB:-ashyq_dev}",
        "POSTGRES_USER": "ashyq_ro",
        "POSTGRES_PASSWORD": "${ASHYQ_RO_DB_PASSWORD:-ashyq_ro}"
      }
    },
    "context7": {
      "command": "bunx",
      "args": ["@upstash/context7-mcp@4.7.3"],
      "env": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY:-}"
      }
    }
  }
}
