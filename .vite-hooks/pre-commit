#!/bin/sh
# Vite+ pre-commit: when a commit touches apps/web, format its staged files and run `vp run verify`
# there - the same gate for agents and humans. Enable once per clone, from the repo root (the hooks
# dir is relative to the cwd): `vp hooks enable`.
set -eu
git diff --cached --name-only -- apps/web | grep -q . || exit 0
cd "$(git rev-parse --show-toplevel)/apps/web"
vp staged
vp run verify
